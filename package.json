{
  "name": "digital-biome",
  "type": "module",
  "version": "0.12.0",
  "description": "digital-biome website",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": "24.x",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm sync && astro dev",
    "dev:only": "astro dev",
    "build": "pnpm sync && astro build && pagefind --site dist && pnpm prune:pagefind && tsx scripts/postbuild.ts",
    "build:only": "astro build && pagefind --site dist && pnpm prune:pagefind && tsx scripts/postbuild.ts",
    "check": "astro check",
    "check:edge": "tsc -p functions/tsconfig.json --noEmit",
    "test:edge": "tsx --test 'edge/**/*.test.ts'",
    "test:unit": "tsx --test 'src/**/*.test.ts'",
    "test:infrastructure": "tsx --test 'scripts/**/*.test.ts'",
    "verify:data-products:knowledge:lock": "tsx scripts/data-products/verify-knowledge-public-v1-lock.ts",
    "verify:data-products:infra:lock": "tsx scripts/data-products/verify-infra-public-v2-lock.ts",
    "sync:data-products:knowledge": "tsx scripts/data-products/sync-knowledge-public-v1.ts",
    "sync:data-products:infra": "bash scripts/data-products/prepare-infra-public-v2.sh",
    "sync:data-products:pds": "tsx scripts/data-products/prepare-pds-catalog-v1.ts",
    "sync:data-products": "tsx scripts/data-products/prepare-all.ts",
    "preflight:data-products": "tsx scripts/data-products/preflight.ts",
    "check:performance": "tsx scripts/check-performance-budgets.ts",
    "verify": "pnpm preflight:data-products && pnpm quality && pnpm check && pnpm check:edge && pnpm test:edge && pnpm test:unit && pnpm test:infrastructure",
    "verify:full": "pnpm verify && pnpm build:only && pnpm check:performance",
    "export:private": "tsx scripts/export-private-infrastructure.ts",
    "deploy:cloudflare": "pnpm build && wrangler pages deploy dist --project-name digital-biome --branch main",
    "preview": "astro preview",
    "sync": "pnpm sync:data-products",
    "sync:content": "tsx scripts/sync-obsidian.ts && tsx scripts/sync/build-subscriptions.ts",
    "build:indexes": "tsx scripts/sync/build-indexes.ts",
    "astro": "astro",
    "test:e2e": "playwright test",
    "prune:pagefind": "tsx scripts/prune-pagefind-artifacts.ts",
    "lint": "pnpm lint:biome && pnpm lint:oxlint && pnpm lint:astro",
    "format:check": "tsx scripts/check-format-ratchet.ts",
    "quality": "pnpm lint && pnpm format:check",
    "verify:data-products:pds:lock": "tsx --test scripts/data-products/pds-catalog-v1-lock.test.ts src/domain/system/pds-catalog-v1.test.ts",
    "lint:biome": "biome lint --diagnostic-level=warn --error-on-warnings .",
    "lint:oxlint": "oxlint --deny-warnings src scripts functions edge e2e astro.config.mjs notes.config.ts playwright.config.ts",
    "lint:astro": "tsx scripts/lint-astro-scripts.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.5",
    "@astrojs/sitemap": "^3.7.4",
    "@lucide/astro": "^1.66.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.4",
    "github-slugger": "^2.0.0",
    "jose": "^6.2.3",
    "mermaid": "^11.17.2",
    "tailwindcss": "^4.3.3",
    "undici": "^7.30.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/compiler-rs": "0.5.2",
    "@biomejs/biome": "2.5.13",
    "@cloudflare/workers-types": "^5.20260717.1",
    "@playwright/test": "^1.63.0",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.0.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "pagefind": "^1.4.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.111.0",
    "yaml": "^2.9.0"
  }
}
