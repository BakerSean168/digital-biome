{
  "name": "digital-biome",
  "type": "module",
  "version": "0.5.0",
  "description": "digital-biome website",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": "24.x",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm sync && astro dev",
    "dev:only": "astro dev",
    "dev:pull": "git submodule update --remote --merge && pnpm sync && astro dev",
    "build": "pnpm sync && astro build && pagefind --site dist && pnpm prune:pagefind && tsx scripts/postbuild.ts",
    "build:only": "astro build && pagefind --site dist && pnpm prune:pagefind && tsx scripts/postbuild.ts",
    "check": "astro check",
    "check:edge": "tsc -p functions/tsconfig.json --noEmit",
    "test:edge": "tsx --test 'edge/**/*.test.ts'",
    "test:unit": "tsx --test 'src/**/*.test.ts'",
    "test:infrastructure": "tsx --test 'scripts/**/*.test.ts'",
    "check:performance": "tsx scripts/check-performance-budgets.ts",
    "verify": "pnpm quality && pnpm check && pnpm check:edge && pnpm test:edge && pnpm test:unit && pnpm test:infrastructure",
    "verify:full": "pnpm verify && pnpm build:only && pnpm check:performance",
    "export:private": "tsx scripts/export-private-infrastructure.ts",
    "deploy:cloudflare": "pnpm build && wrangler pages deploy dist --project-name digital-biome --branch main",
    "preview": "astro preview",
    "sync": "pnpm build:upstream-indexes && pnpm sync:content",
    "sync:content": "tsx scripts/sync-obsidian.ts && tsx scripts/sync/build-subscriptions.ts",
    "build:upstream-indexes": "npm --prefix thought-forest run kb:index",
    "build:indexes": "tsx scripts/sync/build-indexes.ts",
    "refresh:github-contributions": "node scripts/bootstrap-github-cache.js",
    "pull-notes": "git submodule update --remote --merge",
    "astro": "astro",
    "test:e2e": "playwright test",
    "prune:pagefind": "tsx scripts/prune-pagefind-artifacts.ts",
    "lint": "biome lint --diagnostic-level=warn --error-on-warnings .",
    "format:check": "tsx scripts/check-format-ratchet.ts",
    "quality": "pnpm lint && pnpm format:check"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.0",
    "@lucide/astro": "^0.575.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.1",
    "astro": "^5.16.9",
    "jose": "^6.2.3",
    "tailwindcss": "^4.2.1",
    "undici": "^7.22.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@biomejs/biome": "2.5.13",
    "@cloudflare/workers-types": "^5.20260717.1",
    "@playwright/test": "^1.63.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.0.0",
    "pagefind": "^1.4.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "1.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.111.0",
    "yaml": "^2.9.0"
  }
}
