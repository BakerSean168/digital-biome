---
import {
  Activity,
  ExternalLink,
  Lock,
  Network,
  Server,
  Shield,
  Boxes,
  Database,
  Router,
} from '@lucide/astro';
import type { InfrastructureConnection, InfrastructureResource } from '../../utils/infrastructure';

interface Props {
  title: string;
  description: string;
  heroFacts: string[];
  resources: Array<InfrastructureResource & { href?: string }>;
  connections: InfrastructureConnection[];
  locale?: 'zh' | 'en';
}

const { title, description, heroFacts, resources, connections, locale = 'zh' } = Astro.props;
const currentPath = Astro.url.pathname;
const resourceMap = new Map(resources.map((resource) => [resource.id, resource]));
const fleetHosts = resources.filter(
  (resource) =>
    resource.kind === 'host' &&
    resource.status === 'active' &&
    resource.groups.includes('public-fleet'),
);
const homelabResources = resources.filter((resource) => resource.groups.includes('homelab'));
const homelabServices = homelabResources.filter((resource) => resource.kind === 'service');
const monitor = resourceMap.get('svc-nezha-panel');
const control = resourceMap.get('svc-homepage-dashboard');

const publicLink = (resource: InfrastructureResource | undefined, kinds: string[]) =>
  resource?.links?.find((link) => link.url && kinds.includes(link.kind));
const privateLink = (resource: InfrastructureResource | undefined, kinds: string[]) =>
  resource?.links?.find((link) => link.privateRef && kinds.includes(link.kind));
const monitorLink = publicLink(monitor, ['monitor', 'admin', 'app']);
const controlLink = privateLink(control, ['app', 'admin']);
const hostedServices = (hostId: string) =>
  resources.filter((resource) => resource.kind === 'service' && resource.hostResourceId === hostId);
const homeNodeIds = [
  'net-home-optical-modem',
  'net-home-switch',
  'net-home-ap',
  'host-n100-pve',
] as const;
const homeNodes = homeNodeIds
  .map((id) => resourceMap.get(id))
  .filter((resource): resource is NonNullable<typeof resource> => Boolean(resource));
const vmNodes = resources.filter((resource) => resource.parentResourceId === 'host-n100-pve');
const statusLabel = (status: InfrastructureResource['status']) =>
  ({
    active: 'ACTIVE',
    planned: 'PLANNED',
    retired: 'RETIRED',
    archived: 'ARCHIVED',
    decommissioning: 'DECOMMISSIONING',
  })[status];
---

<div class="flex flex-col gap-12 pb-16">
  <section class="border-b border-border pb-10">
    <div class="mb-4 flex flex-wrap items-center gap-2">
      <span class="inline-block border border-primary/20 bg-primary/10 px-2 py-0.5 text-[10px] font-mono tracking-widest text-primary uppercase">
        {locale === 'en' ? 'INFRASTRUCTURE' : '数字基础设施'}
      </span>
      <span class="border border-border bg-card px-2 py-0.5 text-[10px] font-mono tracking-widest text-muted-foreground uppercase">
        Personal Infrastructure → infra-public-v2
      </span>
    </div>

    <div class="flex flex-col gap-8">
      <div>
        <h1 class="text-3xl md:text-5xl font-mono tracking-tight text-foreground">{title}</h1>
        <p class="mt-4 max-w-3xl text-sm font-mono leading-relaxed text-muted-foreground">
          {description}
        </p>
      </div>
      <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
        {heroFacts.map((fact) => (
          <div class="border border-border bg-card/60 px-4 py-3 text-xs font-mono leading-5 text-muted-foreground">
            {fact}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="grid gap-6 md:grid-cols-2">
    <div class="relative flex flex-col justify-between overflow-hidden rounded-sm border border-border bg-card p-6">
      <div class="absolute right-0 top-0 border-b border-l border-primary/20 bg-primary/5 px-2 py-0.5 text-[8px] font-mono uppercase tracking-widest text-primary">
        Public Status
      </div>
      <div class="space-y-4">
        <div class="flex items-center gap-3">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg border border-primary/20 bg-primary/5 text-primary">
            <Activity size={18} />
          </div>
          <div>
            <h3 class="text-sm font-bold text-foreground">服务器实时监控</h3>
            <p class="text-[10px] font-mono tracking-wider text-muted-foreground">
              {monitorLink?.url ? new URL(monitorLink.url).hostname : 'PUBLIC_MONITOR'}
            </p>
          </div>
        </div>
        <p class="text-xs font-mono leading-relaxed text-muted-foreground">
          监控入口与节点关系来自 Personal Infrastructure；Digital Biome 只负责展示。
        </p>
      </div>
      <div class="mt-6 border-t border-border/50 pt-4">
        {monitorLink?.url ? (
          <a
            href={monitorLink.url}
            target="_blank"
            rel="noopener noreferrer"
            class="flex w-full items-center justify-center gap-2 rounded-lg border border-border bg-background py-2.5 text-xs font-mono tracking-widest text-foreground transition-colors hover:border-primary/50"
          >
            <span>[ 进入监控面板 ]</span>
            <ExternalLink size={12} />
          </a>
        ) : (
          <span class="block border border-border py-2.5 text-center text-xs font-mono text-muted-foreground">
            [ MONITOR_UNAVAILABLE ]
          </span>
        )}
      </div>
    </div>

    <div class="relative flex flex-col justify-between overflow-hidden rounded-sm border border-border bg-card p-6">
      <div class="absolute right-0 top-0 border-b border-l border-amber-500/20 bg-amber-500/5 px-2 py-0.5 text-[8px] font-mono uppercase tracking-widest text-amber-400">
        Access Controlled
      </div>
      <div class="space-y-4">
        <div class="flex items-center gap-3">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg border border-amber-500/20 bg-amber-500/5 text-amber-400">
            <Lock size={18} />
          </div>
          <div>
            <h3 class="text-sm font-bold text-foreground">私人基础设施控制中心</h3>
            <p class="text-[10px] font-mono tracking-wider text-muted-foreground">
              CF_ACCESS.PROTECTED
            </p>
          </div>
        </div>
        <p class="text-xs font-mono leading-relaxed text-muted-foreground">
          私有入口只携带稳定 privateRef；真实地址通过受保护 RuntimeBinding 解锁。
        </p>
      </div>
      <div class="mt-6 border-t border-border/50 pt-4">
        {controlLink?.privateRef ? (
          <a
            href={`/login?next=${encodeURIComponent(currentPath)}`}
            data-private-link={controlLink.privateRef}
            data-private-unlocked-label="[ 认证并进入控制台 ]"
            target="_blank"
            rel="noopener noreferrer"
            class="flex w-full items-center justify-center gap-2 rounded-sm border border-border bg-background py-2.5 text-xs font-mono tracking-widest text-foreground transition-colors hover:border-primary/50"
          >
            <span data-private-link-label>[ 认证并进入控制台 ]</span>
            <Shield size={12} />
          </a>
        ) : (
          <span class="block border border-border py-2.5 text-center text-xs font-mono text-muted-foreground">
            [ PRIVATE_REF_UNAVAILABLE ]
          </span>
        )}
      </div>
    </div>
  </section>

  <section class="flex flex-col gap-6">
    <div class="flex items-center justify-between border-b border-border/40 pb-3">
      <div>
        <h2 class="text-xl font-bold tracking-tight text-foreground">
          公网 VPS 资产 / Public VPS Fleet
        </h2>
        <p class="mt-1 text-xs font-mono text-muted-foreground">
          事实来自 infra-public-v2；页面不维护 VPS 清单。
        </p>
      </div>
      <span class="rounded-sm border border-primary/20 bg-primary/10 px-2 py-0.5 text-[10px] font-mono uppercase tracking-wider text-primary">
        {fleetHosts.length} ACTIVE
      </span>
    </div>

    <div class="grid grid-cols-1 gap-6 xl:grid-cols-2">
      {fleetHosts.map((host) => {
        const services = hostedServices(host.id);
        const ipRef = host.privateValues?.ip;
        const hostMonitor = publicLink(host, ['monitor']);
        return (
          <article class="flex flex-col gap-4 rounded-sm border border-[#8B9A46]/35 bg-[#1A1B19] p-6 text-left transition-colors hover:border-primary/50">
            <div class="flex items-start justify-between gap-4 border-b border-border/40 pb-4">
              <div class="flex items-center gap-3">
                <div class="flex h-10 w-10 items-center justify-center rounded-lg border border-[#8B9A46]/20 bg-[#8B9A46]/5 text-primary">
                  <Server size={20} />
                </div>
                <div>
                  <h3 class="text-lg font-bold leading-tight text-foreground">
                    {host.provider ?? host.title}
                  </h3>
                  <p class="mt-0.5 text-[10px] font-mono uppercase tracking-widest text-muted-foreground">
                    {host.role ?? 'Infrastructure Host'}
                  </p>
                </div>
              </div>
              <div class="text-right text-[11px] font-mono leading-normal text-muted-foreground">
                <p>
                  Region: <span class="text-foreground">{host.region ?? '—'}</span>
                </p>
                <p>
                  IP:{' '}
                  {ipRef ? (
                    <span class="text-foreground" data-private-value={ipRef}>
                      LOCKED
                    </span>
                  ) : (
                    <span class="text-foreground/60">HIDDEN</span>
                  )}
                </p>
              </div>
            </div>

            <div class="grid grid-cols-2 gap-3 border-b border-border/20 py-2 font-mono md:grid-cols-5">
              {[
                ['CPU', host.details?.cpu],
                ['Memory', host.details?.memory],
                ['Storage', host.details?.storage],
                ['OS', host.details?.os],
                ['Traffic / BW', host.details?.network],
              ].map(([label, value]) => (
                <div>
                  <span class="block text-[8px] uppercase tracking-wider text-muted-foreground">
                    {label}
                  </span>
                  <span class="text-xs font-medium text-foreground/90">{value ?? '—'}</span>
                </div>
              ))}
            </div>

            <div class="flex flex-wrap gap-2">
              <a
                href={`/infrastructure/${host.id}`}
                class="inline-flex items-center gap-1.5 rounded-sm border border-border px-3 py-1.5 text-[10px] font-mono text-foreground hover:border-primary/50"
              >
                <Boxes size={11} /> Detail
              </a>
              {hostMonitor?.url && (
                <a
                  href={hostMonitor.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 rounded-sm border border-border px-3 py-1.5 text-[10px] font-mono text-foreground hover:border-primary/50"
                >
                  <Activity size={11} /> Monitor
                </a>
              )}
            </div>

            {services.length > 0 && (
              <div class="mt-1 flex flex-col gap-3">
                <span class="text-[9px] font-mono uppercase tracking-widest text-muted-foreground">
                  Deployed Services / 运行服务
                </span>
                <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
                  {services.map((service) => {
                    const open = service.links?.find((link) => link.url || link.privateRef);
                    return (
                      <div class="flex flex-col justify-between rounded-sm border border-border/50 bg-[#161715]/70 p-4">
                        <div>
                          <h4 class="text-xs font-bold text-foreground">{service.title}</h4>
                          <p class="mt-1 text-[11px] leading-relaxed text-muted-foreground">
                            {service.description}
                          </p>
                        </div>
                        <div class="mt-3 border-t border-border/20 pt-3">
                          {open?.url ? (
                            <a
                              href={open.url}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="text-[10px] font-mono text-primary"
                            >
                              [ OPEN ] ↗
                            </a>
                          ) : open?.privateRef ? (
                            <a
                              href={`/login?next=${encodeURIComponent(currentPath)}`}
                              data-private-link={open.privateRef}
                              data-private-unlocked-label="[ OPEN ]"
                              class="text-[10px] font-mono text-muted-foreground hover:text-primary"
                            >
                              <span data-private-link-label>[ LOCKED ]</span>
                            </a>
                          ) : (
                            <span class="text-[10px] font-mono text-muted-foreground">
                              [ NO_ENTRYPOINT ]
                            </span>
                          )}
                        </div>
                      </div>
                    );
                  })}
                </div>
              </div>
            )}
          </article>
        );
      })}
    </div>
  </section>

  <section class="flex flex-col gap-6">
    <div class="flex items-center justify-between border-b border-border/40 pb-3">
      <div>
        <h2 class="text-xl font-bold tracking-tight text-foreground">家庭实验室 / Homelab</h2>
        <p class="mt-1 text-xs font-mono text-muted-foreground">
          节点、宿主关系与链路均来自 Personal Infrastructure。
        </p>
      </div>
      <span class="rounded-sm border border-primary/20 bg-primary/10 px-2 py-0.5 text-[10px] font-mono uppercase tracking-wider text-primary">
        {connections.length} RELATIONS
      </span>
    </div>

    <div class="rounded-sm border border-[#8B9A46]/30 bg-[#1A1B19] p-5 md:p-7">
      <div class="mb-5 flex items-center gap-2 text-xs font-mono text-muted-foreground">
        <Network size={14} class="text-primary" />
        <span>Physical path</span>
      </div>
      <div class="grid gap-3 md:grid-cols-4">
        {homeNodes.map((node, index) => (
          <div class="relative rounded-sm border border-border/60 bg-background/30 p-4">
            <div class="mb-2 flex items-center justify-between">
              <span class="text-[9px] font-mono uppercase tracking-widest text-primary">
                {node.kind}
              </span>
              <span class="text-[8px] font-mono text-muted-foreground">
                {statusLabel(node.status)}
              </span>
            </div>
            <h3 class="text-sm font-semibold text-foreground">{node.title}</h3>
            <p class="mt-2 text-[11px] leading-5 text-muted-foreground">{node.description}</p>
            {index < homeNodes.length - 1 && (
              <span class="absolute -right-3 top-1/2 hidden -translate-y-1/2 text-primary md:block">
                →
              </span>
            )}
          </div>
        ))}
      </div>
    </div>

    <div class="grid gap-6 lg:grid-cols-2">
      <div class="rounded-sm border border-border bg-card/60 p-5">
        <div class="mb-4 flex items-center gap-2">
          <Router size={15} class="text-primary" />
          <h3 class="text-sm font-semibold text-foreground">PVE Virtualization</h3>
        </div>
        <div class="grid gap-3 sm:grid-cols-2">
          {vmNodes.map((node) => (
            <a
              href={`/infrastructure/${node.id}`}
              class="rounded-sm border border-border/60 p-4 hover:border-primary/40"
            >
              <div class="text-[9px] font-mono uppercase tracking-widest text-muted-foreground">
                {node.role ?? node.kind}
              </div>
              <div class="mt-1 text-sm font-semibold text-foreground">{node.title}</div>
              <div class="mt-2 text-[11px] leading-5 text-muted-foreground">{node.description}</div>
            </a>
          ))}
        </div>
      </div>

      <div class="rounded-sm border border-border bg-card/60 p-5">
        <div class="mb-4 flex items-center gap-2">
          <Database size={15} class="text-primary" />
          <h3 class="text-sm font-semibold text-foreground">Homelab Services</h3>
        </div>
        <div class="grid gap-3 sm:grid-cols-2">
          {homelabServices.map((service) => (
            <a
              href={`/infrastructure/${service.id}`}
              class="rounded-sm border border-border/60 p-4 hover:border-primary/40"
            >
              <div class="flex items-center justify-between gap-2">
                <span class="text-sm font-semibold text-foreground">{service.title}</span>
                <span class="text-[8px] font-mono text-muted-foreground">
                  {statusLabel(service.status)}
                </span>
              </div>
              <p class="mt-2 text-[11px] leading-5 text-muted-foreground">{service.description}</p>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>
</div>
