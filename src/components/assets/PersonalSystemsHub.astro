---
import { ArrowRight, ExternalLink, KeyRound, LockKeyhole, Server } from '@lucide/astro';
import type { PdsCatalogDomain } from '../../domain/system/pds-catalog-v1';
import type {
  PortalServer,
  PortalService,
  PortalServiceCategory,
} from '../../utils/personal-systems';

interface Props {
  domains: PdsCatalogDomain[];
  servers: PortalServer[];
  services: PortalService[];
  pinned: PortalService[];
  facts: {
    domainCount: number;
    cloudHostCount: number;
    serviceCount: number;
  };
}

const { domains, servers, services, pinned, facts } = Astro.props;
const currentPath = Astro.url.pathname;
const categories: Array<{ id: PortalServiceCategory; label: string }> = [
  { id: 'apps', label: 'Apps & Products' },
  { id: 'ai', label: 'AI & Agents' },
  { id: 'ops', label: 'Operations' },
  { id: 'homelab', label: 'Home Lab' },
];
const relationLabel = {
  canonical: 'Primary',
  transitional: 'Transition',
  archived: 'Archive',
  external: 'External',
} as const;
---

<div class="pb-14">
  <section class="border-b border-border/70 pb-7 pt-2">
    <div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <div class="text-xs text-primary">Personal Systems</div>
        <h1 class="mt-2 text-3xl font-semibold tracking-[-0.025em] text-foreground md:text-4xl">
          个人系统
        </h1>
        <nav
          class="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-sm text-muted-foreground"
          aria-label="Personal Systems overview"
        >
          <a href="#servers" class="hover:text-primary">
            <strong class="font-medium text-foreground">{facts.cloudHostCount}</strong> Servers
          </a>
          <a href="#services" class="hover:text-primary">
            <strong class="font-medium text-foreground">{facts.serviceCount}</strong> Services
          </a>
          <a href="#registry" class="hover:text-primary">
            <strong class="font-medium text-foreground">{facts.domainCount}</strong> Public Systems
          </a>
        </nav>
      </div>

      <div class="flex items-center gap-3 text-sm">
        <KeyRound size={14} class="text-muted-foreground" />
        <div>
          <div data-systems-access-label class="font-medium text-foreground">
            Public view
          </div>
          <div data-systems-access-description class="mt-0.5 text-xs text-muted-foreground">
            Owner targets stay locked
          </div>
        </div>
        <a
          data-systems-access-action
          href={`/login?next=${encodeURIComponent(currentPath)}`}
          class="ml-2 text-primary hover:text-foreground"
        >
          Owner
        </a>
      </div>
    </div>
  </section>

  <section id="pinned" class="scroll-mt-24 border-b border-border/70 py-7">
    <div class="mb-3 flex items-center justify-between gap-4">
      <h2 class="text-base font-semibold text-foreground">Pinned</h2>
      <span class="text-xs text-muted-foreground">高频入口</span>
    </div>
    <div class="grid border-y border-border/40 sm:grid-cols-2 lg:grid-cols-3">
      {pinned.map((service, index) => (
        <div
          class:list={[
            'flex min-w-0 items-center justify-between gap-3 py-3.5',
            index % 2 === 1 && 'sm:border-l sm:border-border/30 sm:pl-4',
            index % 3 !== 0 && 'lg:border-l lg:border-border/30 lg:pl-4',
          ]}
        >
          <a
            href={`/infrastructure/${service.resource.id}`}
            class="truncate text-sm font-medium text-foreground hover:text-primary"
          >
            {service.resource.title}
          </a>
          {service.url ? (
            <a
              href={service.url}
              target="_blank"
              rel="noopener noreferrer"
              class="shrink-0 text-sm text-primary hover:text-foreground"
            >
              {service.actionLabel} ↗
            </a>
          ) : service.privateRef ? (
            <a
              href={`/login?next=${encodeURIComponent(currentPath)}`}
              data-private-link={service.privateRef}
              data-private-unlocked-label={service.actionLabel}
              class="inline-flex shrink-0 items-center gap-1 text-sm text-amber-300 hover:text-primary"
            >
              <LockKeyhole size={11} /> <span data-private-link-label>Unlock</span>
            </a>
          ) : (
            <a
              href={`/infrastructure/${service.resource.id}`}
              class="shrink-0 text-sm text-muted-foreground hover:text-primary"
            >
              Detail
            </a>
          )}
        </div>
      ))}
    </div>
  </section>

  <section id="servers" class="scroll-mt-24 border-b border-border/70 py-7">
    <div class="mb-3 flex items-center justify-between gap-4">
      <h2 class="text-base font-semibold text-foreground">Servers</h2>
      <a
        href="/infrastructure#topology"
        class="inline-flex items-center gap-1 text-xs text-muted-foreground hover:text-primary"
      >
        Topology <ArrowRight size={12} />
      </a>
    </div>
    <div class="divide-y divide-border/40 border-y border-border/40">
      {servers.map(({ resource, serviceCount }) => (
        <div class="grid gap-2 py-4 md:grid-cols-[minmax(0,1.25fr)_minmax(130px,0.65fr)_minmax(100px,0.5fr)_auto] md:items-center">
          <div class="min-w-0">
            <a
              href={`/infrastructure/${resource.id}`}
              class="text-sm font-medium text-foreground hover:text-primary"
            >
              {resource.title}
            </a>
            <div class="mt-0.5 text-xs text-muted-foreground">
              {resource.role ?? resource.provider ?? 'Cloud server'}
            </div>
          </div>
          <span class="text-sm text-muted-foreground">{resource.region ?? '—'}</span>
          <span class="text-sm text-muted-foreground">{serviceCount} services</span>
          <a
            href={`/infrastructure/${resource.id}`}
            class="inline-flex items-center gap-1 text-sm text-muted-foreground hover:text-primary"
          >
            <Server size={12} /> Detail
          </a>
        </div>
      ))}
    </div>
  </section>

  <section id="services" class="scroll-mt-24 border-b border-border/70 py-7">
    <div class="mb-4">
      <h2 class="text-base font-semibold text-foreground">Services</h2>
      <p class="mt-1 text-sm text-muted-foreground">
        是什么、运行在哪里、如何打开。调试端口与二级入口留在详情页。
      </p>
    </div>

    <div class="space-y-7">
      {categories.map((category) => {
        const items = services.filter((service) => service.category === category.id);
        if (items.length === 0) return null;
        return (
          <section>
            <div class="mb-1 flex items-center justify-between gap-4">
              <h3 class="text-xs font-medium uppercase tracking-[0.12em] text-muted-foreground">
                {category.label}
              </h3>
              <span class="text-xs text-tertiary-foreground">{items.length}</span>
            </div>
            <div class="divide-y divide-border/35 border-y border-border/35">
              {items.map((service) => (
                <div
                  id={`service-${service.resource.id}`}
                  class="grid scroll-mt-24 gap-2 py-3.5 md:grid-cols-[minmax(0,1.1fr)_minmax(190px,0.8fr)_80px_auto] md:items-center"
                >
                  <a
                    href={`/infrastructure/${service.resource.id}`}
                    class="min-w-0 truncate text-sm font-medium text-foreground hover:text-primary"
                  >
                    {service.resource.title}
                  </a>
                  <span class="truncate text-sm text-muted-foreground">
                    {service.host?.title ?? service.resource.role ?? '—'}
                  </span>
                  <span
                    class:list={[
                      'text-xs',
                      service.access === 'public'
                        ? 'text-emerald-300'
                        : service.access === 'owner'
                          ? 'text-amber-300'
                          : 'text-muted-foreground',
                    ]}
                  >
                    {service.access === 'public'
                      ? 'Public'
                      : service.access === 'owner'
                        ? 'Owner'
                        : 'Catalog'}
                  </span>
                  <div class="text-sm md:text-right">
                    {service.url ? (
                      <a
                        href={service.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-1 text-primary hover:text-foreground"
                      >
                        {service.actionLabel} <ExternalLink size={11} />
                      </a>
                    ) : service.privateRef ? (
                      <a
                        href={`/login?next=${encodeURIComponent(`${currentPath}#service-${service.resource.id}`)}`}
                        data-private-link={service.privateRef}
                        data-private-unlocked-label={service.actionLabel}
                        class="inline-flex items-center gap-1 text-amber-300 hover:text-primary"
                      >
                        <LockKeyhole size={11} />{' '}
                        <span data-private-link-label>{service.actionLabel}</span>
                      </a>
                    ) : (
                      <a
                        href={`/infrastructure/${service.resource.id}`}
                        class="text-muted-foreground hover:text-primary"
                      >
                        Detail
                      </a>
                    )}
                  </div>
                </div>
              ))}
            </div>
          </section>
        );
      })}
    </div>
  </section>

  <section id="registry" class="scroll-mt-24 py-7">
    <details class="group">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-2 [&::-webkit-details-marker]:hidden">
        <div>
          <h2 class="text-base font-semibold text-foreground group-open:text-primary">
            System Registry
          </h2>
          <p class="mt-1 text-sm text-muted-foreground">Repo、Owner 与系统边界按需展开。</p>
        </div>
        <span class="text-sm text-muted-foreground transition-transform group-open:rotate-90">
          →
        </span>
      </summary>

      <div data-system-domain-grid class="mt-4 divide-y divide-border/40 border-y border-border/40">
        {domains.map((domain) => (
          <details class="group/domain">
            <summary class="grid cursor-pointer list-none gap-2 py-4 sm:grid-cols-[minmax(0,1fr)_auto_auto] sm:items-center [&::-webkit-details-marker]:hidden">
              <span class="text-sm font-medium text-foreground group-open/domain:text-primary">
                {domain.name}
              </span>
              <span class="text-sm text-muted-foreground">{domain.repositories.length} repos</span>
              <span class="text-sm text-muted-foreground transition-transform group-open/domain:rotate-90">
                →
              </span>
            </summary>
            <div class="pb-4 pl-4 sm:pl-6">
              <div class="divide-y divide-border/30 border-t border-border/30">
                {domain.repositories.map((repository) => (
                  <div class="flex items-center justify-between gap-4 py-3 text-sm">
                    <div class="min-w-0">
                      <span class="font-mono text-foreground">{repository.id}</span>
                      <span class="ml-3 text-xs text-muted-foreground">
                        {relationLabel[repository.relation]}
                      </span>
                    </div>
                    {repository.webUrl ? (
                      <a
                        href={repository.webUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="shrink-0 text-primary hover:text-foreground"
                      >
                        GitHub ↗
                      </a>
                    ) : (
                      <span class="text-muted-foreground">—</span>
                    )}
                  </div>
                ))}
              </div>
            </div>
          </details>
        ))}
        <div data-owner-domain-gate class="flex items-center justify-between gap-4 py-4 text-sm">
          <span class="text-muted-foreground">Owner-only systems 登录后载入</span>
          <LockKeyhole size={13} class="text-muted-foreground" />
        </div>
      </div>
    </details>
  </section>
</div>

<script>
  type OwnerDomain = {
    id: string;
    name: string;
    repositories: Array<{ id: string; relation: string; webUrl?: string }>;
  };
  type OwnerSystemsPayload = {
    version: 1;
    access: 'owner';
    domains: OwnerDomain[];
    facts: Record<string, number>;
  };
  const relationLabels: Record<string, string> = {
    canonical: 'Primary',
    transitional: 'Transition',
    archived: 'Archive',
    external: 'External',
  };

  function element<K extends keyof HTMLElementTagNameMap>(
    tag: K,
    className?: string,
    text?: string,
  ) {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text !== undefined) node.textContent = text;
    return node;
  }

  function renderOwnerDomain(domain: OwnerDomain): HTMLElement {
    const details = element('details', 'group/domain');
    details.dataset.ownerSystemDomain = domain.id;
    const summary = element(
      'summary',
      'grid cursor-pointer list-none gap-2 py-4 sm:grid-cols-[minmax(0,1fr)_auto_auto] sm:items-center [&::-webkit-details-marker]:hidden',
    );
    const title = element(
      'span',
      'text-sm font-medium text-foreground group-open/domain:text-primary',
      domain.name,
    );
    title.append(element('span', 'ml-2 text-xs text-amber-300', 'Owner'));
    summary.append(
      title,
      element('span', 'text-sm text-muted-foreground', `${domain.repositories.length} repos`),
      element(
        'span',
        'text-sm text-muted-foreground transition-transform group-open/domain:rotate-90',
        '→',
      ),
    );
    details.append(summary);
    const body = element('div', 'pb-4 pl-4 sm:pl-6');
    const list = element('div', 'divide-y divide-border/30 border-t border-border/30');
    for (const repository of domain.repositories) {
      const row = element('div', 'flex items-center justify-between gap-4 py-3 text-sm');
      const identity = element('div', 'min-w-0');
      identity.append(
        element('span', 'font-mono text-foreground', repository.id),
        element(
          'span',
          'ml-3 text-xs text-muted-foreground',
          relationLabels[repository.relation] ?? repository.relation,
        ),
      );
      row.append(identity);
      if (repository.webUrl) {
        const link = element('a', 'shrink-0 text-primary hover:text-foreground', 'GitHub ↗');
        link.href = repository.webUrl;
        link.target = '_blank';
        link.rel = 'noopener noreferrer';
        row.append(link);
      }
      list.append(row);
    }
    body.append(list);
    details.append(body);
    return details;
  }

  function applyOwnerSystemsPayload(payload: OwnerSystemsPayload) {
    const grid = document.querySelector<HTMLElement>('[data-system-domain-grid]');
    if (!grid) return;
    grid.querySelectorAll('[data-owner-system-domain]').forEach((node) => node.remove());
    const gate = grid.querySelector<HTMLElement>('[data-owner-domain-gate]');
    for (const domain of payload.domains)
      grid.insertBefore(renderOwnerDomain(domain), gate ?? null);
    gate?.remove();
  }

  async function refreshSystemsAccessState() {
    const label = document.querySelector<HTMLElement>('[data-systems-access-label]');
    const description = document.querySelector<HTMLElement>('[data-systems-access-description]');
    const action = document.querySelector<HTMLAnchorElement>('[data-systems-access-action]');
    if (!label || !description || !action) return;
    try {
      const response = await fetch('/api/private/session', {
        credentials: 'same-origin',
        headers: { Accept: 'application/json' },
        redirect: 'manual',
      });
      if (!response.ok) return;
      const payload: unknown = await response.json();
      if (
        typeof payload !== 'object' ||
        payload === null ||
        !('authenticated' in payload) ||
        payload.authenticated !== true
      )
        return;
      label.textContent = 'Owner view';
      description.textContent = '私有入口已可直接打开';
      action.href = '/cdn-cgi/access/logout';
      action.textContent = 'Sign out';
      const ownerResponse = await fetch('/api/private/systems', {
        credentials: 'same-origin',
        headers: { Accept: 'application/json' },
      });
      if (!ownerResponse.ok) return;
      const ownerPayload = (await ownerResponse.json()) as OwnerSystemsPayload;
      if (
        ownerPayload.version !== 1 ||
        ownerPayload.access !== 'owner' ||
        !Array.isArray(ownerPayload.domains)
      )
        return;
      applyOwnerSystemsPayload(ownerPayload);
    } catch {
      // Public mode remains the fail-closed default.
    }
  }
  void refreshSystemsAccessState();
</script>
