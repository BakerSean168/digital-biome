---
import { ArrowRight, ExternalLink, KeyRound, LockKeyhole } from '@lucide/astro';
import type { PdsCatalogDomain } from '../../domain/system/pds-catalog-v1';
import type { SystemQuickAccess } from '../../utils/personal-systems';

interface Props {
  domains: PdsCatalogDomain[];
  quickAccess: SystemQuickAccess[];
  facts: {
    domainCount: number;
    cloudHostCount: number;
  };
}

const { domains, quickAccess, facts } = Astro.props;
const currentPath = Astro.url.pathname;
const relationLabel = {
  canonical: 'Primary',
  transitional: 'Transition',
  archived: 'Archive',
  external: 'External',
} as const;
---

<div class="pb-14">
  <section class="border-b border-border/70 pb-8 pt-2">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-3xl">
        <div class="text-xs text-primary">Personal Systems</div>
        <h1 class="mt-3 text-3xl font-semibold tracking-[-0.025em] text-foreground md:text-4xl">
          个人系统
        </h1>
        <p class="mt-3 max-w-2xl text-sm leading-7 text-muted-foreground">
          查看当前运行入口与系统边界。详细资产和运维信息按需展开。
        </p>
        <div class="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-sm text-muted-foreground">
          <a href="/infrastructure" class="hover:text-primary">
            <span class="font-medium text-foreground">{facts.cloudHostCount}</span> 台云服务器
          </a>
          <span>
            <span class="font-medium text-foreground">{facts.domainCount}</span> 个公开系统域
          </span>
        </div>
      </div>

      <div class="flex items-center gap-3 text-sm">
        <KeyRound size={14} class="text-muted-foreground" />
        <div>
          <div data-systems-access-label class="font-medium text-foreground">
            Public view
          </div>
          <div data-systems-access-description class="mt-0.5 text-xs text-muted-foreground">
            Owner 内容保持锁定
          </div>
        </div>
        <a
          data-systems-access-action
          href={`/login?next=${encodeURIComponent(currentPath)}`}
          class="ml-2 text-primary hover:text-foreground"
        >
          Owner
        </a>
      </div>
    </div>
  </section>

  <section id="quick-access" class="border-b border-border/70 py-8 scroll-mt-24">
    <div class="mb-4 flex items-end justify-between gap-4">
      <div>
        <h2 class="text-lg font-semibold text-foreground">常用入口</h2>
        <p class="mt-1 text-sm text-muted-foreground">只保留高频服务，不展示完整资产目录。</p>
      </div>
      <a
        href="/infrastructure"
        class="inline-flex items-center gap-1 text-sm text-muted-foreground hover:text-primary"
      >
        基础设施 <ArrowRight size={13} />
      </a>
    </div>

    <div class="divide-y divide-border/40 border-y border-border/40">
      {quickAccess.map(({ resource, access, url, privateRef }) => (
        <div class="grid gap-2 py-4 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-center sm:gap-5">
          <a
            href={`/infrastructure/${resource.id}`}
            class="min-w-0 truncate text-sm font-medium text-foreground hover:text-primary"
          >
            {resource.title}
          </a>
          <div class="text-sm sm:text-right">
            {url && (
              <a
                href={url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 text-primary hover:text-foreground"
              >
                Open <ExternalLink size={11} />
              </a>
            )}
            {privateRef && (
              <a
                href={`/login?next=${encodeURIComponent(currentPath)}`}
                data-private-link={privateRef}
                data-private-unlocked-label="Open"
                class="inline-flex items-center gap-1 text-amber-300 hover:text-primary"
              >
                <LockKeyhole size={11} /> <span data-private-link-label>Unlock</span>
              </a>
            )}
            {!url && !privateRef && <span class="text-muted-foreground">{access}</span>}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section id="system-registry" class="py-8 scroll-mt-24">
    <div class="mb-4">
      <h2 class="text-lg font-semibold text-foreground">系统边界</h2>
      <p class="mt-1 text-sm text-muted-foreground">默认只看领域；仓库关系需要时再展开。</p>
    </div>

    <div data-system-domain-grid class="divide-y divide-border/40 border-y border-border/40">
      {domains.map((domain) => (
        <details class="group">
          <summary class="grid cursor-pointer list-none gap-2 py-4 sm:grid-cols-[minmax(0,1fr)_auto_auto] sm:items-center [&::-webkit-details-marker]:hidden">
            <span class="text-sm font-medium text-foreground group-open:text-primary">
              {domain.name}
            </span>
            <span class="text-sm text-muted-foreground">{domain.repositories.length} repos</span>
            <span class="text-sm text-muted-foreground transition-transform group-open:rotate-90">
              →
            </span>
          </summary>
          <div class="pb-4 pl-4 sm:pl-6">
            <div class="divide-y divide-border/30 border-t border-border/30">
              {domain.repositories.map((repository) => (
                <div class="flex items-center justify-between gap-4 py-3 text-sm">
                  <div class="min-w-0">
                    <span class="font-mono text-foreground">{repository.id}</span>
                    <span class="ml-3 text-xs text-muted-foreground">
                      {relationLabel[repository.relation]}
                    </span>
                  </div>
                  {repository.webUrl ? (
                    <a
                      href={repository.webUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="shrink-0 text-primary hover:text-foreground"
                    >
                      GitHub ↗
                    </a>
                  ) : (
                    <span class="text-muted-foreground">—</span>
                  )}
                </div>
              ))}
            </div>
          </div>
        </details>
      ))}

      <div data-owner-domain-gate class="flex items-center justify-between gap-4 py-4 text-sm">
        <span class="text-muted-foreground">Owner-only systems 登录后载入</span>
        <LockKeyhole size={13} class="text-muted-foreground" />
      </div>
    </div>
  </section>

  <nav class="flex flex-wrap gap-x-7 gap-y-3 border-t border-border/70 pt-6 text-sm">
    <a href="/infrastructure" class="text-foreground hover:text-primary">
      Infrastructure
    </a>
    <a href="/dev" class="text-foreground hover:text-primary">
      Projects
    </a>
    <a href="/notes" class="text-foreground hover:text-primary">
      Knowledge
    </a>
  </nav>
</div>

<script>
  type OwnerDomain = {
    id: string;
    name: string;
    repositories: Array<{
      id: string;
      relation: string;
      webUrl?: string;
    }>;
  };

  type OwnerSystemsPayload = {
    version: 1;
    access: 'owner';
    domains: OwnerDomain[];
    facts: Record<string, number>;
  };

  const relationLabels: Record<string, string> = {
    canonical: 'Primary',
    transitional: 'Transition',
    archived: 'Archive',
    external: 'External',
  };

  function element<K extends keyof HTMLElementTagNameMap>(
    tag: K,
    className?: string,
    text?: string,
  ) {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text !== undefined) node.textContent = text;
    return node;
  }

  function renderOwnerDomain(domain: OwnerDomain): HTMLElement {
    const details = element('details', 'group');
    details.dataset.ownerSystemDomain = domain.id;

    const summary = element(
      'summary',
      'grid cursor-pointer list-none gap-2 py-4 sm:grid-cols-[minmax(0,1fr)_auto_auto] sm:items-center [&::-webkit-details-marker]:hidden',
    );
    const title = element('span', 'text-sm font-medium text-foreground group-open:text-primary');
    title.append(document.createTextNode(domain.name));
    const owner = element('span', 'ml-2 text-xs text-amber-300', 'Owner');
    title.append(owner);
    summary.append(
      title,
      element('span', 'text-sm text-muted-foreground', `${domain.repositories.length} repos`),
      element(
        'span',
        'text-sm text-muted-foreground transition-transform group-open:rotate-90',
        '→',
      ),
    );
    details.append(summary);

    const body = element('div', 'pb-4 pl-4 sm:pl-6');
    const list = element('div', 'divide-y divide-border/30 border-t border-border/30');
    for (const repository of domain.repositories) {
      const row = element('div', 'flex items-center justify-between gap-4 py-3 text-sm');
      const identity = element('div', 'min-w-0');
      identity.append(
        element('span', 'font-mono text-foreground', repository.id),
        element(
          'span',
          'ml-3 text-xs text-muted-foreground',
          relationLabels[repository.relation] ?? repository.relation,
        ),
      );
      row.append(identity);
      if (repository.webUrl) {
        const link = element('a', 'shrink-0 text-primary hover:text-foreground', 'GitHub ↗');
        link.href = repository.webUrl;
        link.target = '_blank';
        link.rel = 'noopener noreferrer';
        row.append(link);
      }
      list.append(row);
    }
    body.append(list);
    details.append(body);
    return details;
  }

  function applyOwnerSystemsPayload(payload: OwnerSystemsPayload) {
    const grid = document.querySelector<HTMLElement>('[data-system-domain-grid]');
    if (!grid) return;
    grid.querySelectorAll('[data-owner-system-domain]').forEach((node) => node.remove());
    const gate = grid.querySelector<HTMLElement>('[data-owner-domain-gate]');
    for (const domain of payload.domains)
      grid.insertBefore(renderOwnerDomain(domain), gate ?? null);
    gate?.remove();
  }

  async function refreshSystemsAccessState() {
    const label = document.querySelector<HTMLElement>('[data-systems-access-label]');
    const description = document.querySelector<HTMLElement>('[data-systems-access-description]');
    const action = document.querySelector<HTMLAnchorElement>('[data-systems-access-action]');
    if (!label || !description || !action) return;
    try {
      const response = await fetch('/api/private/session', {
        credentials: 'same-origin',
        headers: { Accept: 'application/json' },
        redirect: 'manual',
      });
      if (!response.ok) return;
      const payload: unknown = await response.json();
      if (
        typeof payload !== 'object' ||
        payload === null ||
        !('authenticated' in payload) ||
        payload.authenticated !== true
      )
        return;

      label.textContent = 'Owner view';
      description.textContent = '私有入口已可按需解锁';
      action.href = '/cdn-cgi/access/logout';
      action.textContent = 'Sign out';

      const ownerResponse = await fetch('/api/private/systems', {
        credentials: 'same-origin',
        headers: { Accept: 'application/json' },
      });
      if (!ownerResponse.ok) return;
      const ownerPayload = (await ownerResponse.json()) as OwnerSystemsPayload;
      if (
        ownerPayload.version !== 1 ||
        ownerPayload.access !== 'owner' ||
        !Array.isArray(ownerPayload.domains)
      )
        return;
      applyOwnerSystemsPayload(ownerPayload);
    } catch {
      // Public mode remains the fail-closed default.
    }
  }

  void refreshSystemsAccessState();
</script>
