---
import { render } from 'astro:content';
import TerminalLayout from '../../layouts/TerminalLayout.astro';
import { getAuthoredPage, type AuthorPageName } from '../../repositories/site-page-repository';

interface Props {
  name: AuthorPageName;
  fallbackTitle: string;
}

const { name, fallbackTitle } = Astro.props;
const page = await getAuthoredPage(name);
const Content = page ? (await render(page.entry)).Content : null;
---

<TerminalLayout title={page?.title ?? fallbackTitle}>
  <article data-authored-page={name} class="mx-auto w-full max-w-3xl">
    <h1 class="mb-6 text-2xl font-semibold">{page?.title ?? fallbackTitle}</h1>
    {page && Content ? (
      <div class="prose prose-neutral dark:prose-invert max-w-none">
        <Content />
      </div>
    ) : (
      <p data-authored-page-empty class="text-sm text-muted-foreground">
        该页面尚未发布公开内容。
      </p>
    )}
  </article>
</TerminalLayout>
