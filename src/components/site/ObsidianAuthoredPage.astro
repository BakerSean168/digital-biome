---
import TerminalLayout from '../../layouts/TerminalLayout.astro';
import AuthoredPageContent from './AuthoredPageContent.astro';
import { getAuthoredPage, type AuthorPageName } from '../../repositories/site-page-repository';

interface Props {
  name: AuthorPageName;
  fallbackTitle: string;
}

const { name, fallbackTitle } = Astro.props;
const page = await getAuthoredPage(name);
---

<TerminalLayout title={page?.title ?? fallbackTitle}>
  <AuthoredPageContent name={name} fallbackTitle={fallbackTitle} page={page} />
</TerminalLayout>
