---
// Hover preview card for Obsidian [[wikilinks]]; content comes from build-time data-* attributes.
---

<div
  id="wikilink-preview-card"
  class="fixed hidden z-[999] w-72 md:w-80 bg-card/95 backdrop-blur-md border border-border p-4 rounded-xl shadow-xl transition-all duration-200 pointer-events-none select-none text-left opacity-0"
>
  <h5
    id="wikilink-preview-title"
    class="text-xs font-bold text-foreground mb-1.5 font-mono tracking-wide border-b border-border pb-1"
  ></h5>
  <p
    id="wikilink-preview-desc"
    class="text-[11px] text-muted-foreground leading-relaxed line-clamp-4 m-0 font-mono"
  ></p>
</div>

<script>
  import { initWikilinkPreview } from '../../browser/wikilink-preview';

  initWikilinkPreview();
</script>
