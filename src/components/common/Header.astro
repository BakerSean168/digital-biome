---
import SiteSearch from './SiteSearch.astro';
import { Search, Lock, LogOut } from '@lucide/astro';

const currentPath = Astro.url.pathname;
const loginNext = currentPath && currentPath !== '/login' ? currentPath : '/';
---

<div class="fixed top-6 left-1/2 -translate-x-1/2 z-50 group">
  <nav
    class="flex h-10 items-center gap-3 rounded-sm border border-border bg-background/95 px-4 text-sm font-mono"
    aria-label="快捷操作"
  >
    <button
      class="search-trigger flex items-center gap-2 text-muted-foreground transition-colors hover:text-foreground cursor-pointer"
      aria-label="打开搜索"
      aria-haspopup="dialog"
    >
      <Search size={14} class="text-primary" />
      <span class="text-xs">[ SEARCH ]</span>
    </button>

    <div class="h-4 w-px bg-border/80"></div>

    <a
      data-auth-login
      href={`/login?next=${encodeURIComponent(loginNext)}`}
      class="flex items-center gap-1.5 text-xs text-muted-foreground transition-colors hover:text-foreground"
      title="使用 GitHub 身份登录"
    >
      <Lock size={12} />
      <span>[ ACCESS ]</span>
    </a>

    <a
      data-auth-logout
      href="/cdn-cgi/access/logout"
      class="hidden items-center gap-1.5 text-xs text-primary transition-colors hover:text-foreground"
      title="退出 Cloudflare Access"
    >
      <LogOut size={12} />
      <span>[ LOGOUT ]</span>
    </a>

    <span data-auth-announcer class="sr-only" aria-live="polite"></span>
  </nav>
</div>

<SiteSearch />

<script>
  async function refreshAccessSession() {
    const loginControl = document.querySelector<HTMLElement>('[data-auth-login]');
    const logoutControl = document.querySelector<HTMLElement>('[data-auth-logout]');
    const announcer = document.querySelector<HTMLElement>('[data-auth-announcer]');
    if (!loginControl || !logoutControl) return;

    try {
      const response = await fetch('/api/private/session', {
        credentials: 'same-origin',
        headers: { Accept: 'application/json' },
        redirect: 'manual',
      });
      if (!response.ok) return;

      const payload: unknown = await response.json();
      if (
        typeof payload !== 'object' ||
        payload === null ||
        !('authenticated' in payload) ||
        payload.authenticated !== true
      ) {
        return;
      }

      loginControl.classList.add('hidden');
      logoutControl.classList.remove('hidden');
      logoutControl.classList.add('flex');
      if (announcer) announcer.textContent = 'Cloudflare Access 已认证';
    } catch {
      // Guests keep the default login control.
    }
  }

  void refreshAccessSession();
</script>
