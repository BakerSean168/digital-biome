---
import { PRIMARY_NAVIGATION, activeNavigation, pageMode } from '../../config/navigation-policy';
import { BUILD_INFO } from '../../utils/build-info';
import SiteSearch from './SiteSearch.astro';
import { Search, Lock, LogOut, Network } from '@lucide/astro';
const currentPath = Astro.url.pathname;
const loginNext = currentPath !== '/login' ? currentPath : '/';
const links = PRIMARY_NAVIGATION;
const current = activeNavigation(currentPath);
const mode = pageMode(currentPath);
---

<header class="gui-header" data-ui-only="gui">
  <a href="/" class="font-semibold">
    Digital Biome
  </a>
  <div class="flex items-center gap-8 text-sm text-muted-foreground">
    <button
      class="search-trigger min-h-11 hover:text-primary"
      data-header-control="search"
      aria-label="打开搜索"
      aria-haspopup="dialog"
    >
      Search
    </button>
    <span data-header-control="access">
      <a
        data-auth-login
        href={`/login?next=${encodeURIComponent(loginNext)}`}
        class="inline-flex min-h-11 items-center hover:text-primary"
      >
        Access
      </a>
      <a
        data-auth-logout
        href="/cdn-cgi/access/logout"
        class="hidden min-h-11 items-center hover:text-primary"
      >
        Logout
      </a>
    </span>
  </div>
</header>
<footer
  class="relative z-40 shrink-0 border-t border-border bg-background pb-[env(safe-area-inset-bottom)] font-mono text-xs"
  data-terminal-dock
>
  <div
    data-dock-status
    class="flex h-7 items-center justify-between gap-3 overflow-hidden border-b border-border text-muted-foreground"
  >
    <span data-dock-mode class="shrink-0 bg-primary px-3 py-1 text-background">
      -- {mode} --
    </span>
    <span data-dock-hints class="hidden xl:block">
      j k 移动　 ↵ 打开　 / 搜索　 i 文本　 f 筛选　 1–4 标签　 g 跳转　 r 关联　 u 返回
    </span>
    <span
      class="hidden min-w-0 truncate text-[10px] sm:inline"
      data-build-info
      title="package 版本 · Git 基线；worktree 表示包含未提交修改，不是已发布版本"
    >
      v{BUILD_INFO.version} · {BUILD_INFO.revision}
      {BUILD_INFO.state !== 'clean' ? `+${BUILD_INFO.state}` : ''}
    </span>
    <div
      data-mode-switch
      role="group"
      aria-label="界面模式"
      class="ml-auto flex shrink-0 gap-1 pr-3"
    >
      <button
        type="button"
        data-ui-mode-choice="tui"
        aria-pressed="true"
        aria-label="切换到终端界面"
        class="px-2"
      >
        TUI
      </button>
      <button
        type="button"
        data-ui-mode-choice="gui"
        aria-pressed="false"
        aria-label="切换到图形界面"
        class="px-2"
      >
        GUI
      </button>
    </div>
  </div>
  <div data-dock-commands class="flex flex-wrap items-stretch md:flex-nowrap">
    <a
      href="/"
      data-ui-only="tui"
      class="terminal-segment z-20 flex items-center gap-2 bg-card px-3 font-semibold"
    >
      <Network size={13} /> DigitalBiome
    </a>
    <span
      data-ui-only="tui"
      data-header-control="access"
      class="terminal-segment z-10 flex items-center bg-pane px-4"
    >
      <a
        data-auth-login
        href={`/login?next=${encodeURIComponent(loginNext)}`}
        class="flex items-center gap-2 text-primary"
      >
        <Lock size={12} /> Access
      </a>
      <a
        data-auth-logout
        href="/cdn-cgi/access/logout"
        class="hidden items-center gap-2 text-primary"
      >
        <LogOut size={12} /> Logout
      </a>
      <span data-auth-announcer class="sr-only" aria-live="polite"></span>
    </span>
    <span data-dock-path class="min-w-0 flex-1 truncate px-4 leading-8 text-muted-foreground">
      <span data-terminal-path>~{currentPath === '/' ? '' : currentPath}</span>{' '}
      <span data-ui-only="tui" class="text-primary">
        $ ▌
      </span>
    </span>
    <nav
      aria-label="主导航"
      class="order-last flex w-full border-t border-border md:order-none md:w-auto md:border-0"
    >
      {links.map(({ title, href }) => (
        <a
          href={href}
          aria-current={current === href ? 'page' : undefined}
          class:list={[
            'flex min-h-11 flex-1 items-center justify-center px-3 md:min-h-8',
            current === href
              ? 'bg-primary text-background'
              : 'text-muted-foreground hover:text-foreground',
          ]}
        >
          {title.toLowerCase()}
        </a>
      ))}
    </nav>
    <button
      data-header-control="search"
      data-ui-only="tui"
      class="search-trigger px-3 hover:text-primary"
      aria-label="打开搜索"
      aria-haspopup="dialog"
    >
      <Search size={14} />
    </button>
    <button
      data-ui-only="tui"
      class="px-3 hover:text-primary"
      data-terminal-help
      aria-label="键盘帮助"
    >
      ?
    </button>
  </div>
</footer>
<dialog
  id="terminal-help"
  class="m-auto max-w-[92vw] border border-border bg-background p-6 text-sm text-foreground backdrop:bg-black/70"
>
  <form method="dialog" class="flex justify-between gap-12">
    <h2 class="text-primary">键盘导航</h2>
    <button aria-label="关闭帮助">[关闭]</button>
  </form>
  <dl class="mt-5 grid grid-cols-[auto_1fr] gap-x-8 gap-y-2">
    <dt>j / k / ↑ / ↓</dt>
    <dd>选择对象</dd>
    <dt>Enter / o</dt>
    <dd>打开选择</dd>
    <dt>/ 或 Ctrl+K</dt>
    <dd>全站搜索</dd>
    <dt>i / f / 1–4</dt>
    <dd>筛选当前列表</dd>
    <dt>g → h / l / p / t / a</dt>
    <dd>首页 / 笔记 / 项目 / 工具 / About</dd>
    <dt>r → 1–9</dt>
    <dd>打开所选对象的关联</dd>
    <dt>u</dt>
    <dd>返回上一页</dd>
    <dt>Esc</dt>
    <dd>关闭浮层 / 清空筛选</dd>
  </dl>
</dialog>
<SiteSearch />
<script>
  import '../../browser/terminal-navigation';
</script>
<script>
  async function refreshAccessSession() {
    const loginControls = document.querySelectorAll<HTMLElement>('[data-auth-login]');
    const logoutControls = document.querySelectorAll<HTMLElement>('[data-auth-logout]');
    const announcer = document.querySelector<HTMLElement>('[data-auth-announcer]');
    if (!loginControls.length || !logoutControls.length) return;

    try {
      const response = await fetch('/api/private/session', {
        credentials: 'same-origin',
        headers: { Accept: 'application/json' },
        redirect: 'manual',
      });
      if (!response.ok) return;

      const payload: unknown = await response.json();
      if (
        typeof payload !== 'object' ||
        payload === null ||
        !('authenticated' in payload) ||
        payload.authenticated !== true
      ) {
        return;
      }

      loginControls.forEach((control) => control.classList.add('hidden'));
      logoutControls.forEach((control) => {
        control.classList.remove('hidden');
        control.classList.add('flex');
      });
      if (announcer) announcer.textContent = 'Cloudflare Access 已认证';
    } catch {
      // Guests keep the default login control.
    }
  }

  void refreshAccessSession();
</script>
