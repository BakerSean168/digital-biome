---
import SiteSearch from './SiteSearch.astro';
import { Search, Lock, LockOpen } from '@lucide/astro';

const isAuthed = Astro.locals.auth?.isAuthed ?? false;
const currentPath = Astro.url.pathname;
const loginNext = currentPath && currentPath !== "/login" ? currentPath : "/";
---

<!-- Floating Magnetic Command Pill -->
<div class="fixed top-6 left-1/2 -translate-x-1/2 z-50 flex items-center gap-2 group">
  <div 
    id="magnetic-pill"
    class="flex items-center gap-3 px-4 py-2 rounded-full border border-border bg-background/50 backdrop-blur-md text-sm font-mono transition-all shadow-lg"
  >
    <!-- Search Button inside pill -->
    <button 
      class="search-trigger flex items-center gap-2 text-muted-foreground hover:text-foreground transition-colors cursor-pointer"
      aria-label="Initialize Search"
      aria-haspopup="dialog"
    >
      <Search size={14} class="text-primary" />
      <span class="text-xs">[ ⌘K ] 搜索</span>
    </button>

    <div class="w-px h-4 bg-border/80"></div>

    <!-- Dynamic Auth controls inside pill -->
    {isAuthed ? (
      <form method="POST" action="/api/auth/logout" class="flex items-center">
        <button type="submit" class="flex items-center gap-1.5 text-primary hover:text-[#728038] text-xs transition-colors cursor-pointer" title="退出特权模式">
          <LockOpen size={12} />
          <span>[ OUT / 退出 ]</span>
        </button>
      </form>
    ) : (
      <a href={`/login?next=${encodeURIComponent(loginNext)}`} class="flex items-center gap-1.5 text-muted-foreground hover:text-foreground text-xs transition-colors" title="进入特权模式">
        <Lock size={12} />
        <span>[ IN / 登录 ]</span>
      </a>
    )}
  </div>
</div>

<!-- Global Site Search Modal -->
<SiteSearch />

<script>
  // Magnetic Effect
  const pill = document.getElementById('magnetic-pill');
  if (pill) {
    document.addEventListener('mousemove', (e) => {
      const rect = pill.getBoundingClientRect();
      const x = rect.left + rect.width / 2;
      const y = rect.top + rect.height / 2;
      const distance = Math.sqrt(Math.pow(e.clientX - x, 2) + Math.pow(e.clientY - y, 2));
      
      if (distance < 120) { 
        const pullX = (e.clientX - x) * 0.15;
        const pullY = (e.clientY - y) * 0.15;
        pill.style.transform = `translate(${pullX}px, ${pullY}px)`;
      } else {
        pill.style.transform = `translate(0px, 0px)`;
      }
    });
  }
</script>
