---
// Search shares product navigation with the dock; data and auth adapters stay unchanged.
---

<dialog
  id="search-modal"
  class="m-auto hidden w-[min(720px,calc(100vw-32px))] max-h-[85dvh] overflow-hidden border border-border bg-background p-0 text-foreground backdrop:bg-black/70"
  aria-label="Search"
  aria-hidden="true"
>
  <div id="search-container" class="flex max-h-[85dvh] flex-col">
    <div class="flex shrink-0 items-center gap-3 border-b border-border px-4 py-3">
      <span class="text-primary" aria-hidden="true">
        /
      </span>
      <input
        id="cmd-input"
        type="search"
        role="combobox"
        aria-label="搜索内容或导航"
        aria-controls="cmd-results"
        aria-expanded="true"
        aria-autocomplete="list"
        class="min-w-0 flex-1 bg-transparent text-sm outline-none placeholder:text-muted-foreground"
        placeholder="搜索知识、项目、服务，或跳转页面…"
        autocomplete="off"
        spellcheck="false"
      />
      <span id="cmd-loading" class="hidden text-xs text-muted-foreground" role="status">
        搜索中
      </span>
      <button
        id="cmd-close"
        type="button"
        class="shrink-0 text-xs text-muted-foreground hover:text-primary"
        aria-label="关闭搜索"
      >
        Esc
      </button>
    </div>
    <div
      id="cmd-search-status"
      class="hidden px-4 py-2 text-xs text-amber-500"
      role="status"
      aria-live="polite"
    ></div>
    <div
      id="cmd-results"
      role="listbox"
      aria-label="搜索结果"
      class="min-h-0 overflow-y-auto overscroll-contain p-2"
    ></div>
    <div class="flex shrink-0 gap-5 border-t border-border px-4 py-2 text-[11px] text-muted-foreground">
      <span>↑ ↓ 选择</span>
      <span>↵ 打开</span>
      <span>Esc 关闭</span>
    </div>
  </div>
</dialog>
<script>
  import { createSearchIntentScheduler, type SearchIntent } from '../../browser/search-intent';
  import {
    SEARCH_NAVIGATION_INDEX,
    type SearchNavigationCommand,
  } from '../../config/navigation-policy';
  import { loadPagefind, searchPagefind, type PagefindSearchStatus } from '../../browser/pagefind';
  import type { PagefindResultData } from '../../browser/pagefind';
  import { stripMarkupToText } from '../../browser/strip-markup';
  import { withUiMode } from '../../domain/ui-mode';

  type CommandResult = SearchNavigationCommand;

  type ServiceResult = {
    type: 'service';
    label: 'SVC';
    title: string;
    desc: string;
    href: string;
    aliases: string[];
    privateRef?: string;
    pinned: boolean;
  };

  type SearchResult = {
    type: 'search';
    label: string;
    title: string;
    desc: string;
    href: string;
  };

  type PaletteResult = CommandResult | ServiceResult | SearchResult;

  const ROUTES: readonly CommandResult[] = SEARCH_NAVIGATION_INDEX;
  let SERVICES: ServiceResult[] = [];
  let serviceIndexPromise: Promise<void> | null = null;

  const searchModal = document.querySelector<HTMLDialogElement>('#search-modal');
  const searchTriggers = document.querySelectorAll('.search-trigger');
  const cmdInput = document.getElementById('cmd-input') as HTMLInputElement | null;
  const resultsContainer = document.getElementById('cmd-results');
  const loadingIndicator = document.getElementById('cmd-loading');
  const statusElement = document.getElementById('cmd-search-status');
  let selectedIndex = 0;
  let currentResults: PaletteResult[] = [];
  let searchStatus: PagefindSearchStatus = 'success';
  let searchPending = false;
  const searchIntents = createSearchIntentScheduler(200, undefined, () => {
    searchPending = true;
    selectedIndex = 0;
    currentResults = [];
    loadingIndicator?.classList.add('hidden');
    resultsContainer?.replaceChildren();
    searchStatus = 'success';
    renderSearchStatus();
  });

  function isServiceResult(value: unknown): value is ServiceResult {
    if (typeof value !== 'object' || value === null || Array.isArray(value)) return false;
    const item = value as Partial<ServiceResult>;
    return (
      item.type === 'service' &&
      item.label === 'SVC' &&
      typeof item.title === 'string' &&
      typeof item.desc === 'string' &&
      typeof item.href === 'string' &&
      Array.isArray(item.aliases) &&
      item.aliases.every((alias) => typeof alias === 'string') &&
      (item.privateRef === undefined || typeof item.privateRef === 'string') &&
      typeof item.pinned === 'boolean'
    );
  }

  async function loadServiceIndex(): Promise<void> {
    if (SERVICES.length > 0) return;
    if (!serviceIndexPromise) {
      serviceIndexPromise = (async () => {
        try {
          const response = await fetch('/data/system-launcher-index.json', {
            headers: { Accept: 'application/json' },
          });
          if (!response.ok) return;
          const payload: unknown = await response.json();
          if (typeof payload !== 'object' || payload === null || !('services' in payload)) return;
          const services = (payload as { services?: unknown }).services;
          if (!Array.isArray(services) || !services.every(isServiceResult)) return;
          SERVICES = services;
        } catch {
          // Navigation commands and Pagefind remain available without the service index.
        }
      })();
    }
    await serviceIndexPromise;
  }

  type PrivateInfrastructurePayload = {
    version: 1;
    links: Record<string, string>;
  };

  let privateServiceTargetsResolved = false;

  function getAllowedPrivateHref(value: string): string | null {
    try {
      const url = new URL(value);
      return ['http:', 'https:', 'ssh:'].includes(url.protocol) && url.hostname ? url.href : null;
    } catch {
      return null;
    }
  }

  function isStringRecord(value: unknown): value is Record<string, string> {
    return (
      typeof value === 'object' &&
      value !== null &&
      !Array.isArray(value) &&
      Object.values(value).every((item) => typeof item === 'string')
    );
  }

  async function hydratePrivateServiceTargets(): Promise<void> {
    await loadServiceIndex();
    if (privateServiceTargetsResolved || !SERVICES.some((service) => service.privateRef)) return;
    try {
      const response = await fetch('/api/private/infrastructure', {
        credentials: 'same-origin',
        headers: { Accept: 'application/json' },
        redirect: 'manual',
      });
      if (!response.ok) return;
      const payload: unknown = await response.json();
      if (
        typeof payload !== 'object' ||
        payload === null ||
        !('version' in payload) ||
        payload.version !== 1 ||
        !('links' in payload) ||
        !isStringRecord(payload.links)
      ) {
        return;
      }
      const privatePayload = payload as PrivateInfrastructurePayload;
      for (const service of SERVICES) {
        if (!service.privateRef) continue;
        const href = getAllowedPrivateHref(privatePayload.links[service.privateRef] || '');
        if (href) service.href = href;
      }
      privateServiceTargetsResolved = true;
    } catch {
      // Logged-out visitors retain safe /systems anchors.
    }
  }

  function toSearchResult(item: PagefindResultData): SearchResult {
    const fallbackTitle =
      item.url.split('/').filter(Boolean).pop()?.replace(/-/g, ' ') || 'Untitled';
    return {
      type: 'search',
      label: 'DOC',
      title: item.meta.title || fallbackTitle,
      desc: stripMarkupToText(item.excerpt),
      href: item.url,
    };
  }

  function renderSearchStatus(): void {
    if (!statusElement) return;
    const messages: Partial<Record<PagefindSearchStatus, string>> = {
      unavailable: '全文索引暂时不可用，仍可使用导航命令。',
      'query-failed': '全文搜索暂时失败，请稍后重试。',
      'hydration-failed': '搜索结果暂时无法加载，请稍后重试。',
      partial: '部分搜索结果暂时无法加载。',
    };
    const message = messages[searchStatus] || '';
    statusElement.textContent = message;
    statusElement.classList.toggle('hidden', !message);
  }

  function renderResults(): void {
    if (!resultsContainer) return;
    resultsContainer.replaceChildren();

    if (currentResults.length === 0) {
      const empty = document.createElement('div');
      empty.className = 'px-4 py-8 text-center font-mono text-xs text-muted-foreground';
      empty.textContent =
        searchStatus === 'zero-match' || searchStatus === 'success'
          ? '没有匹配的内容。'
          : '搜索暂时不可用。';
      resultsContainer.appendChild(empty);
      renderSearchStatus();
      return;
    }

    const fragment = document.createDocumentFragment();
    currentResults.forEach((item, index) => {
      const el = document.createElement('button');
      el.type = 'button';
      el.tabIndex = -1;
      el.id = `search-result-${index}`;
      el.setAttribute('role', 'option');
      el.setAttribute('aria-selected', String(index === selectedIndex));
      el.className =
        'flex w-full items-center gap-3 border-b border-border px-2 py-2 text-left aria-selected:bg-primary/10';
      el.dataset.index = index.toString();
      const kind = document.createElement('span');
      kind.className = 'w-8 shrink-0 text-[10px] text-muted-foreground';
      kind.textContent = item.type === 'cmd' ? '→' : item.type === 'service' ? 'svc' : 'doc';
      const content = document.createElement('span');
      content.className = 'min-w-0 flex-1';
      const title = document.createElement('span');
      title.className = 'block truncate text-sm text-foreground';
      title.textContent = item.title;
      content.append(title);
      if (item.desc) {
        const description = document.createElement('span');
        description.className = 'block truncate text-xs text-muted-foreground';
        description.textContent = item.desc;
        content.append(description);
      }
      const target = document.createElement('span');
      target.className = 'hidden max-w-40 truncate text-xs text-muted-foreground sm:block';
      target.textContent =
        item.type === 'cmd'
          ? item.href
          : item.type === 'service' && item.privateRef
            ? 'Access'
            : '↗';
      el.append(kind, content, target);
      el.addEventListener('mouseenter', () => {
        selectedIndex = index;
        updateSelection();
      });
      el.addEventListener('click', () => {
        executeItem(index);
      });

      fragment.appendChild(el);
    });

    resultsContainer.appendChild(fragment);
    updateSelection();
    renderSearchStatus();

    const selectedEl = resultsContainer.children[selectedIndex];
    if (selectedEl) selectedEl.scrollIntoView({ block: 'nearest' });
  }

  function updateSelection(): void {
    if (!resultsContainer) return;
    Array.from(resultsContainer.children).forEach((child, index) => {
      child.setAttribute('aria-selected', String(index === selectedIndex));
    });
    const selected = resultsContainer.children[selectedIndex];
    if (selected?.id) cmdInput?.setAttribute('aria-activedescendant', selected.id);
    else cmdInput?.removeAttribute('aria-activedescendant');
  }

  function executeItem(index: number): void {
    if (searchPending) return;
    const item = currentResults[index];
    if (!item) return;
    if (item.type === 'service' && /^https?:/.test(item.href)) {
      window.open(item.href, '_blank', 'noopener,noreferrer');
    } else {
      window.location.assign(withUiMode(item.href, new URL(location.href)));
    }
  }

  async function handleSearch(intent: SearchIntent): Promise<void> {
    const { query, token } = intent;
    loadingIndicator?.classList.remove('hidden');

    const lowerQuery = query.toLowerCase().trim();
    const results: PaletteResult[] = [];
    searchStatus = 'success';

    if (lowerQuery) {
      const commandMatches = ROUTES.filter((route) => {
        return (
          route.title.toLowerCase().includes(lowerQuery) ||
          route.alias?.some((alias) => alias.includes(lowerQuery))
        );
      });
      const serviceMatches = SERVICES.filter(
        (service) =>
          service.title.toLowerCase().includes(lowerQuery) ||
          service.aliases.some((alias) => alias.includes(lowerQuery)),
      );
      results.push(...commandMatches, ...serviceMatches);
    } else {
      results.push(...ROUTES, ...SERVICES.filter((service) => service.pinned).slice(0, 6));
    }

    if (lowerQuery && !lowerQuery.startsWith('/')) {
      const outcome = await searchPagefind(loadPagefind, lowerQuery, 8);
      if (!token.isCurrent()) return;
      searchStatus = outcome.status;
      results.push(...outcome.results.map(toSearchResult));
    }

    if (!token.isCurrent()) return;
    currentResults = results;
    selectedIndex = 0;
    searchPending = false;
    loadingIndicator?.classList.add('hidden');
    renderResults();
  }

  function openModal(): void {
    if (!searchModal) return;
    searchModal.classList.remove('hidden');
    searchModal.setAttribute('aria-hidden', 'false');
    if (!searchModal.open) searchModal.showModal();
    if (cmdInput) {
      cmdInput.value = '';
      cmdInput.focus();
      void handleSearch(searchIntents.start(''));
      void loadServiceIndex().then(() => {
        if (!searchModal?.open) return;
        void hydratePrivateServiceTargets();
        void handleSearch(searchIntents.start(cmdInput.value));
      });
    }
  }

  function closeModal(): void {
    searchIntents.invalidate();
    searchPending = false;
    currentResults = [];
    selectedIndex = 0;
    loadingIndicator?.classList.add('hidden');
    resultsContainer?.replaceChildren();
    searchStatus = 'success';
    renderSearchStatus();
    if (!searchModal) return;
    searchModal.classList.add('hidden');
    searchModal.setAttribute('aria-hidden', 'true');
    if (searchModal.open) searchModal.close();
    cmdInput?.removeAttribute('aria-activedescendant');
  }

  searchTriggers.forEach((trigger) => {
    trigger.addEventListener('click', openModal);
  });

  document.getElementById('cmd-close')?.addEventListener('click', closeModal);
  searchModal?.addEventListener('cancel', (event) => {
    event.preventDefault();
    closeModal();
  });

  searchModal?.addEventListener('click', (event) => {
    if (event.target === searchModal) {
      closeModal();
    }
  });

  cmdInput?.addEventListener('input', (event) => {
    const target = event.target as HTMLInputElement;
    searchIntents.schedule(target.value, (intent) => void handleSearch(intent));
  });

  document.addEventListener('keydown', (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key === 'k') {
      event.preventDefault();
      if (searchModal?.classList.contains('hidden')) {
        openModal();
      } else {
        closeModal();
      }
    }

    if (!searchModal?.open) return;

    if (event.key === 'Escape') {
      event.preventDefault();
      closeModal();
    } else if (event.key === 'ArrowDown') {
      event.preventDefault();
      if (selectedIndex < currentResults.length - 1) {
        selectedIndex++;
        updateSelection();
        const selectedEl = resultsContainer?.children[selectedIndex];
        if (selectedEl) selectedEl.scrollIntoView({ block: 'nearest' });
      }
    } else if (event.key === 'ArrowUp') {
      event.preventDefault();
      if (selectedIndex > 0) {
        selectedIndex--;
        updateSelection();
        const selectedEl = resultsContainer?.children[selectedIndex];
        if (selectedEl) selectedEl.scrollIntoView({ block: 'nearest' });
      }
    } else if (event.key === 'Enter') {
      event.preventDefault();
      executeItem(selectedIndex);
    }
  });
</script>
