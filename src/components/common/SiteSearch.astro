---
// SiteSearch.astro
// Custom Command Palette: Merges command routing (/tools, /dev) and full-text search (Pagefind).
---

<div
  id="search-modal"
  class="fixed inset-0 z-[100] hidden bg-background/80 backdrop-blur-sm transition-opacity"
  aria-hidden="true"
>
  <div class="fixed inset-0 z-[101] flex items-start justify-center pt-20 sm:pt-24">
    <div
      id="search-container"
      class="w-full max-w-2xl overflow-hidden rounded-sm border border-border/80 bg-card/95 backdrop-blur-xl shadow-2xl transition-all sm:mx-6 flex flex-col"
      role="dialog"
      aria-modal="true"
      aria-label="Command Palette"
    >
      <div class="relative flex items-center border-b border-border/50 px-4 py-4">
        <span class="text-primary/70 font-mono mr-3">&gt;</span>
        <input
          id="cmd-input"
          type="text"
          class="w-full bg-transparent font-mono text-sm text-foreground outline-none placeholder:text-muted-foreground/50"
          placeholder="Enter command or search query... (e.g. /tools, PVE)"
          autocomplete="off"
          spellcheck="false"
        />
        <div id="cmd-loading" class="hidden absolute right-4">
          <span class="inline-block w-2 h-4 bg-primary/70 animate-[pulse_1s_step-end_infinite]"></span>
        </div>
      </div>

      <div
        id="cmd-search-status"
        class="hidden px-4 py-2 text-xs font-mono text-amber-500"
        role="status"
        aria-live="polite"
      ></div>
      <div id="cmd-results" class="max-h-[60vh] overflow-y-auto p-2 scrollbar-hide"></div>

      <div class="border-t border-border/50 px-4 py-2 bg-muted/10 text-[10px] text-muted-foreground font-mono flex justify-between">
        <span class="flex gap-4">
          <span>
            <kbd class="border border-border/50 rounded px-1 text-[9px] mr-1">ESC</kbd>CLOSE
          </span>
          <span>
            <kbd class="border border-border/50 rounded px-1 text-[9px] mr-1">↑↓</kbd>NAVIGATE
          </span>
          <span>
            <kbd class="border border-border/50 rounded px-1 text-[9px] mr-1">↵</kbd>EXECUTE
          </span>
        </span>
        <span class="opacity-50 hidden sm:inline-block">SYS.COMMAND_CENTER</span>
      </div>
    </div>
  </div>
</div>

<style>
  .scrollbar-hide {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  import { createSearchIntentScheduler, type SearchIntent } from '../../browser/search-intent';
  import {
    SEARCH_NAVIGATION_INDEX,
    type SearchNavigationCommand,
  } from '../../config/navigation-policy';
  import { loadPagefind, searchPagefind, type PagefindSearchStatus } from '../../browser/pagefind';
  import type { PagefindResultData } from '../../browser/pagefind';
  import { stripMarkupToText } from '../../browser/strip-markup';

  type CommandResult = SearchNavigationCommand;

  type ServiceResult = {
    type: 'service';
    label: 'SVC';
    title: string;
    desc: string;
    href: string;
    aliases: string[];
    privateRef?: string;
    pinned: boolean;
  };

  type SearchResult = {
    type: 'search';
    label: string;
    title: string;
    desc: string;
    href: string;
  };

  type PaletteResult = CommandResult | ServiceResult | SearchResult;

  const ROUTES: readonly CommandResult[] = SEARCH_NAVIGATION_INDEX;
  let SERVICES: ServiceResult[] = [];
  let serviceIndexPromise: Promise<void> | null = null;

  const searchModal = document.getElementById('search-modal');
  const searchTriggers = document.querySelectorAll('.search-trigger');
  const cmdInput = document.getElementById('cmd-input') as HTMLInputElement | null;
  const resultsContainer = document.getElementById('cmd-results');
  const loadingIndicator = document.getElementById('cmd-loading');
  const statusElement = document.getElementById('cmd-search-status');
  let selectedIndex = 0;
  let currentResults: PaletteResult[] = [];
  let searchStatus: PagefindSearchStatus = 'success';
  let searchPending = false;
  const searchIntents = createSearchIntentScheduler(200, undefined, () => {
    searchPending = true;
    selectedIndex = 0;
    currentResults = [];
    loadingIndicator?.classList.add('hidden');
    resultsContainer?.replaceChildren();
    searchStatus = 'success';
    renderSearchStatus();
  });

  function isServiceResult(value: unknown): value is ServiceResult {
    if (typeof value !== 'object' || value === null || Array.isArray(value)) return false;
    const item = value as Partial<ServiceResult>;
    return (
      item.type === 'service' &&
      item.label === 'SVC' &&
      typeof item.title === 'string' &&
      typeof item.desc === 'string' &&
      typeof item.href === 'string' &&
      Array.isArray(item.aliases) &&
      item.aliases.every((alias) => typeof alias === 'string') &&
      (item.privateRef === undefined || typeof item.privateRef === 'string') &&
      typeof item.pinned === 'boolean'
    );
  }

  async function loadServiceIndex(): Promise<void> {
    if (SERVICES.length > 0) return;
    if (!serviceIndexPromise) {
      serviceIndexPromise = (async () => {
        try {
          const response = await fetch('/data/system-launcher-index.json', {
            headers: { Accept: 'application/json' },
          });
          if (!response.ok) return;
          const payload: unknown = await response.json();
          if (typeof payload !== 'object' || payload === null || !('services' in payload)) return;
          const services = (payload as { services?: unknown }).services;
          if (!Array.isArray(services) || !services.every(isServiceResult)) return;
          SERVICES = services;
        } catch {
          // Navigation commands and Pagefind remain available without the service index.
        }
      })();
    }
    await serviceIndexPromise;
  }

  type PrivateInfrastructurePayload = {
    version: 1;
    links: Record<string, string>;
  };

  let privateServiceTargetsResolved = false;

  function getAllowedPrivateHref(value: string): string | null {
    try {
      const url = new URL(value);
      return ['http:', 'https:', 'ssh:'].includes(url.protocol) && url.hostname ? url.href : null;
    } catch {
      return null;
    }
  }

  function isStringRecord(value: unknown): value is Record<string, string> {
    return (
      typeof value === 'object' &&
      value !== null &&
      !Array.isArray(value) &&
      Object.values(value).every((item) => typeof item === 'string')
    );
  }

  async function hydratePrivateServiceTargets(): Promise<void> {
    await loadServiceIndex();
    if (privateServiceTargetsResolved || !SERVICES.some((service) => service.privateRef)) return;
    try {
      const response = await fetch('/api/private/infrastructure', {
        credentials: 'same-origin',
        headers: { Accept: 'application/json' },
        redirect: 'manual',
      });
      if (!response.ok) return;
      const payload: unknown = await response.json();
      if (
        typeof payload !== 'object' ||
        payload === null ||
        !('version' in payload) ||
        payload.version !== 1 ||
        !('links' in payload) ||
        !isStringRecord(payload.links)
      ) {
        return;
      }
      const privatePayload = payload as PrivateInfrastructurePayload;
      for (const service of SERVICES) {
        if (!service.privateRef) continue;
        const href = getAllowedPrivateHref(privatePayload.links[service.privateRef] || '');
        if (href) service.href = href;
      }
      privateServiceTargetsResolved = true;
    } catch {
      // Logged-out visitors retain safe /systems anchors.
    }
  }

  function toSearchResult(item: PagefindResultData): SearchResult {
    const fallbackTitle =
      item.url.split('/').filter(Boolean).pop()?.replace(/-/g, ' ') || 'Untitled';
    return {
      type: 'search',
      label: 'DOC',
      title: item.meta.title || fallbackTitle,
      desc: stripMarkupToText(item.excerpt),
      href: item.url,
    };
  }

  function renderSearchStatus(): void {
    if (!statusElement) return;
    const messages: Partial<Record<PagefindSearchStatus, string>> = {
      unavailable: '全文索引暂时不可用，仍可使用导航命令。',
      'query-failed': '全文搜索暂时失败，请稍后重试。',
      'hydration-failed': '搜索结果暂时无法加载，请稍后重试。',
      partial: '部分搜索结果暂时无法加载。',
    };
    const message = messages[searchStatus] || '';
    statusElement.textContent = message;
    statusElement.classList.toggle('hidden', !message);
  }

  function renderResults(): void {
    if (!resultsContainer) return;
    resultsContainer.replaceChildren();

    if (currentResults.length === 0) {
      const empty = document.createElement('div');
      empty.className = 'px-4 py-8 text-center font-mono text-xs text-muted-foreground';
      empty.textContent =
        searchStatus === 'zero-match' || searchStatus === 'success'
          ? 'SYS.WARN: NO_MATCH_FOUND'
          : 'SYS.WARN: SEARCH_UNAVAILABLE';
      resultsContainer.appendChild(empty);
      renderSearchStatus();
      return;
    }

    const fragment = document.createDocumentFragment();
    currentResults.forEach((item, index) => {
      const el = document.createElement('div');
      const isSelected = index === selectedIndex;
      el.className = `group flex items-center justify-between p-3 cursor-pointer border-l-2 transition-colors ${
        isSelected ? 'border-primary bg-primary/10' : 'border-transparent hover:bg-card-hover/50'
      }`;
      el.dataset.index = index.toString();

      const leftCol = document.createElement('div');
      leftCol.className = 'flex items-center gap-3 min-w-0';

      const badge = document.createElement('span');
      badge.className = `shrink-0 text-[9px] font-mono tracking-widest border border-border/50 px-1.5 py-0.5 rounded-sm ${item.type === 'cmd' ? 'text-primary border-primary/30 bg-primary/5' : item.type === 'service' ? 'text-amber-300 border-amber-300/30' : 'text-muted-foreground'}`;
      badge.textContent = `[ ${item.label} ]`;
      leftCol.appendChild(badge);

      const titleCol = document.createElement('div');
      titleCol.className = 'min-w-0 flex flex-col';

      const title = document.createElement('span');
      title.className = `font-mono text-sm truncate transition-colors ${isSelected ? 'text-primary' : 'text-foreground'}`;
      title.textContent = item.title;
      titleCol.appendChild(title);

      if (item.desc) {
        const description = document.createElement('span');
        description.className = 'font-mono text-[10px] text-muted-foreground truncate mt-0.5';
        description.textContent = item.desc;
        titleCol.appendChild(description);
      }

      leftCol.appendChild(titleCol);
      el.appendChild(leftCol);

      const rightCol = document.createElement('div');
      rightCol.className = `shrink-0 font-mono text-[10px] text-primary transition-opacity ${isSelected ? 'opacity-100' : 'opacity-0 group-hover:opacity-100'}`;
      rightCol.textContent = '↵ EXECUTE';
      el.appendChild(rightCol);

      el.addEventListener('mouseenter', () => {
        selectedIndex = index;
        updateSelection();
      });
      el.addEventListener('click', () => {
        executeItem(index);
      });

      fragment.appendChild(el);
    });

    resultsContainer.appendChild(fragment);
    renderSearchStatus();

    const selectedEl = resultsContainer.children[selectedIndex];
    if (selectedEl) selectedEl.scrollIntoView({ block: 'nearest' });
  }

  function updateSelection(): void {
    if (!resultsContainer) return;
    Array.from(resultsContainer.children).forEach((child, index) => {
      if (!(child instanceof HTMLElement)) return;
      const el = child;
      if (index === selectedIndex) {
        el.classList.add('border-primary', 'bg-primary/10');
        el.classList.remove('border-transparent', 'hover:bg-card-hover/50');
        const rightCol = el.lastElementChild;
        if (rightCol) rightCol.classList.add('opacity-100');
        if (rightCol) rightCol.classList.remove('opacity-0', 'group-hover:opacity-100');

        const titleSpan = el.querySelector('.text-foreground, .text-primary');
        if (titleSpan) {
          titleSpan.classList.add('text-primary');
          titleSpan.classList.remove('text-foreground');
        }
      } else {
        el.classList.remove('border-primary', 'bg-primary/10');
        el.classList.add('border-transparent', 'hover:bg-card-hover/50');
        const rightCol = el.lastElementChild;
        if (rightCol) rightCol.classList.remove('opacity-100');
        if (rightCol) rightCol.classList.add('opacity-0', 'group-hover:opacity-100');

        const titleSpan = el.querySelector('.text-foreground, .text-primary');
        if (titleSpan) {
          titleSpan.classList.remove('text-primary');
          titleSpan.classList.add('text-foreground');
        }
      }
    });
  }

  function executeItem(index: number): void {
    if (searchPending) return;
    const item = currentResults[index];
    if (item) window.location.href = item.href;
  }

  async function handleSearch(intent: SearchIntent): Promise<void> {
    const { query, token } = intent;
    loadingIndicator?.classList.remove('hidden');

    const lowerQuery = query.toLowerCase().trim();
    const results: PaletteResult[] = [];
    searchStatus = 'success';

    if (lowerQuery) {
      const commandMatches = ROUTES.filter((route) => {
        return (
          route.title.toLowerCase().includes(lowerQuery) ||
          route.alias?.some((alias) => alias.includes(lowerQuery))
        );
      });
      const serviceMatches = SERVICES.filter(
        (service) =>
          service.title.toLowerCase().includes(lowerQuery) ||
          service.aliases.some((alias) => alias.includes(lowerQuery)),
      );
      results.push(...commandMatches, ...serviceMatches);
    } else {
      results.push(...ROUTES, ...SERVICES.filter((service) => service.pinned).slice(0, 6));
    }

    if (lowerQuery && !lowerQuery.startsWith('/')) {
      const outcome = await searchPagefind(loadPagefind, lowerQuery, 8);
      if (!token.isCurrent()) return;
      searchStatus = outcome.status;
      results.push(...outcome.results.map(toSearchResult));
    }

    if (!token.isCurrent()) return;
    currentResults = results;
    selectedIndex = 0;
    searchPending = false;
    loadingIndicator?.classList.add('hidden');
    renderResults();
  }

  function openModal(): void {
    if (!searchModal) return;
    searchModal.classList.remove('hidden');
    searchModal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    if (cmdInput) {
      cmdInput.value = '';
      cmdInput.focus();
      void handleSearch(searchIntents.start(''));
      void loadServiceIndex().then(() => {
        if (searchModal?.classList.contains('hidden')) return;
        void hydratePrivateServiceTargets();
        void handleSearch(searchIntents.start(cmdInput.value));
      });
    }
  }

  function closeModal(): void {
    searchIntents.invalidate();
    searchPending = false;
    currentResults = [];
    selectedIndex = 0;
    loadingIndicator?.classList.add('hidden');
    resultsContainer?.replaceChildren();
    searchStatus = 'success';
    renderSearchStatus();
    if (!searchModal) return;
    searchModal.classList.add('hidden');
    searchModal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  searchTriggers.forEach((trigger) => {
    trigger.addEventListener('click', openModal);
  });

  searchModal?.addEventListener('click', (event) => {
    if (event.target === searchModal || event.target === searchModal.firstElementChild) {
      closeModal();
    }
  });

  cmdInput?.addEventListener('input', (event) => {
    const target = event.target as HTMLInputElement;
    searchIntents.schedule(target.value, (intent) => void handleSearch(intent));
  });

  document.addEventListener('keydown', (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key === 'k') {
      event.preventDefault();
      if (searchModal?.classList.contains('hidden')) {
        openModal();
      } else {
        closeModal();
      }
    }

    if (searchModal?.classList.contains('hidden')) return;

    if (event.key === 'Escape') {
      event.preventDefault();
      closeModal();
    } else if (event.key === 'ArrowDown') {
      event.preventDefault();
      if (selectedIndex < currentResults.length - 1) {
        selectedIndex++;
        updateSelection();
        const selectedEl = resultsContainer?.children[selectedIndex];
        if (selectedEl) selectedEl.scrollIntoView({ block: 'nearest' });
      }
    } else if (event.key === 'ArrowUp') {
      event.preventDefault();
      if (selectedIndex > 0) {
        selectedIndex--;
        updateSelection();
        const selectedEl = resultsContainer?.children[selectedIndex];
        if (selectedEl) selectedEl.scrollIntoView({ block: 'nearest' });
      }
    } else if (event.key === 'Enter') {
      event.preventDefault();
      executeItem(selectedIndex);
    }
  });
</script>
