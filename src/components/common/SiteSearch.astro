---
// Search shares product navigation with the dock; data and auth adapters stay unchanged.
---

<dialog
  id="search-modal"
  class="m-auto hidden w-[min(720px,calc(100vw-32px))] max-h-[85dvh] overflow-hidden border border-border bg-background p-0 text-foreground backdrop:bg-black/70"
  aria-label="Search"
  aria-hidden="true"
>
  <div id="search-container" class="flex max-h-[85dvh] flex-col">
    <div class="flex shrink-0 items-center gap-3 border-b border-border px-4 py-3">
      <span class="text-primary" aria-hidden="true">
        /
      </span>
      <input
        id="cmd-input"
        type="search"
        role="combobox"
        aria-label="搜索内容或导航"
        aria-controls="cmd-results"
        aria-expanded="true"
        aria-autocomplete="list"
        class="min-w-0 flex-1 bg-transparent text-sm outline-none placeholder:text-muted-foreground"
        placeholder="搜索知识、项目、服务，或跳转页面…"
        autocomplete="off"
        spellcheck="false"
      />
      <span id="cmd-loading" class="hidden text-xs text-muted-foreground" role="status">
        搜索中
      </span>
      <button
        id="cmd-close"
        type="button"
        class="shrink-0 text-xs text-muted-foreground hover:text-primary"
        aria-label="关闭搜索"
      >
        Esc
      </button>
    </div>
    <div
      id="cmd-search-status"
      class="hidden px-4 py-2 text-xs text-amber-500"
      role="status"
      aria-live="polite"
    ></div>
    <div
      id="cmd-results"
      role="listbox"
      aria-label="搜索结果"
      class="min-h-0 overflow-y-auto overscroll-contain p-2"
    ></div>
    <div class="flex shrink-0 gap-5 border-t border-border px-4 py-2 text-[11px] text-muted-foreground">
      <span>↑ ↓ 选择</span>
      <span>↵ 打开</span>
      <span>Esc 关闭</span>
    </div>
  </div>
</dialog>
<script>
  import { initSiteSearch } from '../../browser/site-search-controller';
  initSiteSearch();
</script>
