---
import { HOME_SLASH_LINKS, HOME_WORDS } from '../../config/home-profile';
import type { TerminalObject } from '../../view-models/terminal-object';

interface Props {
  notes: TerminalObject[];
  blogs: TerminalObject[];
}
const { notes, blogs } = Astro.props;
---

<section data-ui-only="gui" class="gui-home mx-auto w-full max-w-5xl">
  <div class="gui-home-intro">
    <header data-home-identity class="flex items-center gap-4 md:gap-5">
      <img
        src="/favicon.svg"
        width="64"
        height="64"
        alt=""
        class="h-12 w-12 shrink-0 brightness-0 invert md:h-16 md:w-16"
      />
      <div class="min-w-0">
        <h1 class="text-[28px] leading-tight font-semibold md:text-[42px]">BakerSean</h1>
        <p
          data-home-bio
          class="mt-3 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-muted-foreground md:text-base"
        >
          {HOME_WORDS.map((word, index) => (
            <>
              {index > 0 && <span aria-hidden="true">·</span>}
              <a
                href={word.href}
                class="underline decoration-border underline-offset-4 hover:text-primary"
              >
                {word.word}
              </a>
            </>
          ))}
        </p>
      </div>
    </header>

    <nav
      data-home-slash-links
      aria-label="Slash Pages"
      class="grid grid-cols-2 gap-x-8 border-t border-border pt-4 sm:grid-cols-3"
    >
      {HOME_SLASH_LINKS.map((link) => (
        <a
          href={link.href}
          class="group flex min-h-11 min-w-0 items-center justify-between gap-3 border-b border-border py-2 text-sm"
        >
          <span class="font-mono group-hover:text-primary">{link.label}</span>
          {link.shortcut && (
            <kbd class="shrink-0 font-mono text-xs text-muted-foreground">{link.shortcut}</kbd>
          )}
        </a>
      ))}
    </nav>
  </div>

  <div class="gui-home-writing">
    <section data-home-recent="blogs" aria-labelledby="home-gui-blogs">
      <div class="mb-4 flex items-baseline justify-between gap-4">
        <h2 id="home-gui-blogs" class="text-lg font-medium">
          Recent Blogs
        </h2>
        <a href="/blog" class="shrink-0 font-mono text-xs text-primary hover:underline">
          /blog →
        </a>
      </div>
      <ol class="border-t border-border">
        {blogs.slice(0, 3).map((post) => (
          <li class="border-b border-border">
            <a
              href={post.href}
              class="flex min-h-12 min-w-0 items-center justify-between gap-4 py-2 hover:text-primary"
            >
              <span class="min-w-0 text-sm leading-6 md:text-base">{post.title}</span>
              {post.meta && (
                <span class="shrink-0 font-mono text-xs text-muted-foreground">{post.meta}</span>
              )}
            </a>
          </li>
        ))}
      </ol>
    </section>
    <section data-home-recent="notes" aria-labelledby="home-gui-notes">
      <div class="mb-4 flex items-baseline justify-between gap-4">
        <h2 id="home-gui-notes" class="text-lg font-medium">
          Recent Notes
        </h2>
        <a href="/notes" class="shrink-0 font-mono text-xs text-primary hover:underline">
          /notes →
        </a>
      </div>
      <ol class="border-t border-border">
        {notes.slice(0, 3).map((note) => (
          <li class="border-b border-border">
            <a
              href={note.href}
              class="flex min-h-12 min-w-0 items-center justify-between gap-4 py-2 hover:text-primary"
            >
              <span class="min-w-0 text-sm leading-6 md:text-base">{note.title}</span>
              {note.meta && (
                <span class="shrink-0 font-mono text-xs text-muted-foreground">{note.meta}</span>
              )}
            </a>
          </li>
        ))}
      </ol>
    </section>
  </div>
</section>
