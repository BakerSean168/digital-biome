---
import { Film, Gamepad2, Server } from '@lucide/astro';
import type { NowEntry } from '../../config/now-profile';

interface Props {
  entry: NowEntry;
  mode: 'gui' | 'tui';
}
const { entry, mode } = Astro.props;
const label = {
  project: 'BUILDING',
  game: 'PLAYING',
  watching: 'WATCHING',
}[entry.kind];
---

<article
  data-now-item={entry.id}
  data-now-kind={entry.kind}
  class:list={[
    'min-w-0 border-t border-border',
    mode === 'gui' ? 'bg-card/20 px-4 py-5 md:px-5' : 'py-4',
  ]}
>
  <div class="flex flex-wrap items-center justify-between gap-2 font-mono text-xs">
    <span class="inline-flex items-center gap-2 text-primary">
      {entry.kind === 'project' && <Server size={14} aria-hidden="true" />}
      {entry.kind === 'game' && <Gamepad2 size={14} aria-hidden="true" />}
      {entry.kind === 'watching' && <Film size={14} aria-hidden="true" />}
      {label}
    </span>
    <span class="text-muted-foreground">{entry.category}</span>
  </div>
  <div class="mt-4 flex flex-wrap items-baseline gap-x-3 gap-y-1">
    <h2 class="text-lg font-medium">{entry.title}</h2>
    {entry.status && <span class="font-mono text-xs text-primary">{entry.status}</span>}
  </div>
  {entry.subtitle && <p class="mt-1 text-xs text-muted-foreground">{entry.subtitle}</p>}
  {entry.detail && <p class="mt-3 text-sm leading-7 text-muted-foreground">{entry.detail}</p>}
</article>
