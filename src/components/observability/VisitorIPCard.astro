---
import { Globe, ShieldCheck, ArrowRight } from '@lucide/astro';

---

<article class="group relative h-full bg-card/40 border border-border p-5 sm:p-6 flex flex-col hover:border-primary/50 transition-colors duration-200" id="visitor-ip-card" data-observability-card="visitor" aria-busy="true">
  <!-- Header -->
  <div>
    <div class="flex items-center justify-between mb-3">
      <div class="flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-muted-foreground">
        <Globe size={14} class="text-primary" />
        <span>[ VISITOR_TELEMETRY ]</span>
      </div>
      <div class="inline-flex items-center gap-1.5 px-2 py-0.5 border border-border bg-background/60 text-muted-foreground text-[10px] font-mono font-bold tracking-wider rounded-sm" id="ip-trust-badge">
        <ShieldCheck size={12} />
        <span>评估中</span>
      </div>
    </div>

    <!-- Main Value (IP) -->
    <div class="flex items-center gap-3 mt-1 mb-1">
      <span class="text-2xl font-bold font-mono tracking-tight text-foreground" id="ip-display">--.--.*.*</span>
    </div>
    
    <div class="flex flex-col gap-0.5 font-mono text-xs text-muted-foreground mb-4">
      <span id="ip-location">等待 Cloudflare Edge</span>
      <span class="text-[10px] text-muted-foreground/80" id="ip-asn">ASN 尚未解析</span>
    </div>

    <!-- Risk vs Trust Bar -->
    <div class="my-4 p-3 bg-background/60 border border-border/80 rounded-sm flex flex-col gap-2">
      <div class="flex items-center justify-between font-mono text-xs">
        <div class="flex items-center gap-2">
          <span class="text-muted-foreground text-[10px] uppercase">风险</span>
          <span class="font-bold text-foreground" id="ip-risk-val">--</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-muted-foreground text-[10px] uppercase">可信度</span>
          <span class="font-bold text-primary" id="ip-trust-val">--</span>
        </div>
      </div>
      <div class="w-full h-1.5 bg-border/40 rounded-full overflow-hidden flex">
        <div class="h-full bg-red-500/80 transition-all duration-500" id="ip-risk-bar" style="width: 0%"></div>
        <div class="h-full bg-primary transition-all duration-500" id="ip-trust-bar" style="width: 0%"></div>
      </div>
    </div>

    <!-- Threat Security Pills -->
    <div class="flex flex-wrap gap-1.5 my-2 font-mono text-[10px]" id="ip-signal-tags">
      {['VPN', 'PROXY', 'TOR', '机房', '滥用'].map(label => (
        <span class="px-2 py-0.5 bg-background/80 border border-border/60 text-muted-foreground" data-signal-label={label}>{label}: --</span>
      ))}
    </div>
  </div>

  <!-- Footer Info -->
  <div class="mt-auto pt-3 border-t border-border/60 flex items-center justify-between font-mono text-[11px]">
    <span class="text-muted-foreground shrink-0">Cloudflare Edge 接入</span>
    <button
      type="button"
      class="text-primary font-bold shrink-0 ml-2 hover:underline inline-flex items-center gap-1 cursor-pointer"
      onclick="document.getElementById('visitor-detail-dialog')?.showModal()"
    >
      查看详情 <ArrowRight size={12} />
    </button>
  </div>
</article>

<dialog id="visitor-detail-dialog" class="fixed inset-0 m-auto max-h-[calc(100dvh-2rem)] overflow-y-auto bg-card border border-border p-5 sm:p-6 rounded-sm text-foreground max-w-xl w-[calc(100%-2rem)] backdrop:bg-black/70 font-mono">
  <div class="flex items-center justify-between pb-4 mb-4 border-b border-border">
    <div class="flex items-center gap-2 text-sm font-bold text-primary">
      <Globe size={16} />
      <span>[ VISITOR_EDGE_TRACE ]</span>
    </div>
    <form method="dialog">
      <button class="text-muted-foreground hover:text-foreground text-xs uppercase cursor-pointer">[ CLOSE ]</button>
    </form>
  </div>

  <div class="grid sm:grid-cols-2 gap-3 text-xs">
    <div class="p-3 bg-background border border-border">
      <div class="text-[10px] uppercase text-muted-foreground mb-1">Masked Address</div>
      <div class="font-bold text-foreground" id="visitor-dialog-ip">--.--.*.*</div>
    </div>
    <div class="p-3 bg-background border border-border">
      <div class="text-[10px] uppercase text-muted-foreground mb-1">Geo Resolution</div>
      <div class="font-bold text-foreground" id="visitor-dialog-location">--</div>
    </div>
    <div class="p-3 bg-background border border-border sm:col-span-2">
      <div class="text-[10px] uppercase text-muted-foreground mb-1">Network Identity</div>
      <div class="font-bold text-foreground" id="visitor-dialog-network">--</div>
    </div>
    <div class="p-3 bg-background border border-border">
      <div class="text-[10px] uppercase text-muted-foreground mb-1">Cloudflare Edge</div>
      <div class="font-bold text-primary" id="visitor-dialog-edge">--</div>
    </div>
    <div class="p-3 bg-background border border-border">
      <div class="text-[10px] uppercase text-muted-foreground mb-1">Transport</div>
      <div class="font-bold text-foreground" id="visitor-dialog-transport">--</div>
    </div>
    <div class="p-3 bg-background border border-border sm:col-span-2">
      <div class="text-[10px] uppercase text-muted-foreground mb-1">Observed At</div>
      <div class="text-muted-foreground" id="visitor-dialog-time">--</div>
    </div>
  </div>

  <p class="mt-4 text-[10px] leading-relaxed text-muted-foreground">
    // PRIVACY: 页面只接收掩码后的地址与 Cloudflare 请求元数据，不返回完整 IP，也不保存会话轨迹。
  </p>
</dialog>

<script>
  async function fetchVisitorIp() {
    const card = document.getElementById('visitor-ip-card');
    const badgeEl = document.getElementById('ip-trust-badge');
    try {
      const res = await fetch('/api/visitor-ip');
      if (!res.ok) throw new Error('edge telemetry unavailable');
      const data = await res.json();

      const ipEl = document.getElementById('ip-display');
      const locEl = document.getElementById('ip-location');
      const asnEl = document.getElementById('ip-asn');
      const riskValEl = document.getElementById('ip-risk-val');
      const trustValEl = document.getElementById('ip-trust-val');
      const riskBarEl = document.getElementById('ip-risk-bar');
      const trustBarEl = document.getElementById('ip-trust-bar');
      const tagEls = document.querySelectorAll<HTMLElement>('#ip-signal-tags [data-signal-label]');
      const detailIpEl = document.getElementById('visitor-dialog-ip');
      const detailLocationEl = document.getElementById('visitor-dialog-location');
      const detailNetworkEl = document.getElementById('visitor-dialog-network');
      const detailEdgeEl = document.getElementById('visitor-dialog-edge');
      const detailTransportEl = document.getElementById('visitor-dialog-transport');
      const detailTimeEl = document.getElementById('visitor-dialog-time');

      if (ipEl && data.ip) ipEl.textContent = data.ip;
      if (locEl && (data.city || data.country)) {
        locEl.textContent = `${data.city || 'Unknown'} · ${data.country || 'Unknown'}`;
      }
      if (asnEl && data.asn) {
        asnEl.textContent = `${data.asn} · ${data.isp || ''}`;
      }
      if (detailIpEl) detailIpEl.textContent = String(data.ip || '--.--.*.*');
      if (detailLocationEl) detailLocationEl.textContent = `${data.city || 'Unknown'} · ${data.country || 'Unknown'}`;
      if (detailNetworkEl) detailNetworkEl.textContent = `${data.asn || 'AS--'} · ${data.isp || 'Unresolved network'}`;
      if (detailEdgeEl) detailEdgeEl.textContent = `${data.edge?.colo || 'UNKNOWN'} · ${data.edge?.timezone || 'Unknown timezone'}`;
      if (detailTransportEl) detailTransportEl.textContent = `${data.edge?.httpProtocol || 'Unknown'} · ${data.edge?.tlsVersion || 'Unknown TLS'}`;
      if (detailTimeEl && data.timestamp) detailTimeEl.textContent = new Date(data.timestamp).toLocaleString();
      const riskScore = Math.min(100, Math.max(0, Number(data.riskScore) || 0));
      const trustScore = Math.min(100, Math.max(0, Number(data.trustScore) || 0));
      if (riskValEl) riskValEl.textContent = String(riskScore);
      if (trustValEl) trustValEl.textContent = String(trustScore);
      
      if (riskBarEl) riskBarEl.style.width = `${riskScore}%`;
      if (trustBarEl) trustBarEl.style.width = `${trustScore}%`;
      const tagValues = [data.tags?.vpn, data.tags?.proxy, data.tags?.tor, data.tags?.datacenter, data.tags?.abuse];
      tagEls.forEach((el, index) => {
        const active = Boolean(tagValues[index]);
        el.textContent = `${el.dataset.signalLabel}: ${active ? 'ON' : 'OFF'}`;
        el.className = active
          ? 'px-2 py-0.5 bg-red-500/10 border border-red-500/30 text-red-400'
          : 'px-2 py-0.5 bg-background/80 border border-border/60 text-muted-foreground';
      });
      if (badgeEl) {
        badgeEl.className = 'inline-flex items-center gap-1.5 px-2 py-0.5 border border-primary/30 bg-primary/10 text-primary text-[10px] font-mono font-bold tracking-wider rounded-sm';
        badgeEl.textContent = trustScore >= 80 ? '高可信' : '需复核';
      }
      card?.setAttribute('aria-busy', 'false');
    } catch {
      if (badgeEl) {
        badgeEl.className = 'inline-flex items-center gap-1.5 px-2 py-0.5 border border-amber-500/30 bg-amber-500/10 text-amber-400 text-[10px] font-mono font-bold tracking-wider rounded-sm';
        badgeEl.textContent = '边缘离线';
      }
      card?.setAttribute('aria-busy', 'false');
    }
  }

  fetchVisitorIp();
</script>
