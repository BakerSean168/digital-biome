---
import { Cpu, Sparkles, ArrowRight } from '@lucide/astro';

---

<article class="group relative h-full bg-card/40 border border-border p-5 sm:p-6 flex flex-col hover:border-primary/50 transition-colors duration-200" id="ai-usage-card" data-observability-card="ai-usage" aria-busy="true">
  <!-- Header -->
  <div>
    <div class="flex items-center justify-between mb-4">
      <div class="flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-muted-foreground">
        <Cpu size={14} class="text-primary" />
        <span>[ AI_TOOL_OBSERVABILITY ]</span>
      </div>
      <div class="inline-flex items-center gap-1.5 px-2 py-0.5 border border-border bg-background/60 text-muted-foreground text-[10px] font-mono font-bold tracking-wider rounded-sm" id="ai-source-badge">
        <span class="w-1.5 h-1.5 rounded-full bg-muted-foreground"></span>
        <span>连接中</span>
      </div>
    </div>

    <!-- Main Value & Cost side-by-side -->
    <div class="flex items-baseline justify-between mt-1 mb-2">
      <div>
        <div class="flex items-baseline gap-2">
          <span class="text-3xl font-bold font-mono tracking-tight text-foreground" id="ai-total-tokens">--</span>
        </div>
        <div class="text-[11px] font-mono text-muted-foreground" id="ai-tokens-subtitle">
          tokens · 过去 7 天
        </div>
      </div>
      
      <div class="text-right font-mono">
        <div class="text-lg font-bold text-primary" id="ai-cost-usd">--</div>
        <div class="text-[10px] text-muted-foreground" id="ai-cost-rmb">等待计费数据</div>
      </div>
    </div>

    <!-- AI Tools Breakdown -->
    <div class="flex flex-col gap-2 my-4" id="ai-tools-list" aria-live="polite">
      <div class="border border-dashed border-border px-3 py-5 font-mono text-[11px] text-muted-foreground">
        [ AWAITING_USAGE_LEDGER ] 正在连接 Token Hub
      </div>
    </div>
  </div>

  <!-- Footer Info & Details Modal trigger -->
  <div class="mt-auto pt-3 border-t border-border/60 flex items-center justify-between font-mono text-[11px]">
    <span class="text-muted-foreground" id="ai-updated-at">尚未同步</span>
    <button 
      type="button" 
      class="text-primary font-bold hover:underline flex items-center gap-1 cursor-pointer"
      onclick="document.getElementById('ai-detail-dialog')?.showModal()"
    >
      <span>查看详情</span>
      <ArrowRight size={12} />
    </button>
  </div>
</article>

<template id="ai-tool-row-template">
  <div class="p-3 bg-background/60 border border-border/80 rounded-sm flex flex-col gap-2">
    <div class="flex items-center justify-between gap-3">
      <div class="flex items-center gap-2 min-w-0">
        <Sparkles size={13} class="text-primary shrink-0" aria-hidden="true" />
        <span class="text-xs font-mono font-medium text-foreground truncate" data-tool-name></span>
      </div>
      <div class="flex items-center gap-2 font-mono text-xs shrink-0">
        <span class="text-foreground font-bold" data-tool-tokens></span>
        <span class="text-[9px] uppercase px-1.5 py-0.5 border border-primary/20 bg-primary/10 text-primary rounded-sm" data-tool-status></span>
      </div>
    </div>
    <div class="w-full h-1 bg-border/40 overflow-hidden">
      <div class="h-full bg-primary transition-[width] duration-500" data-tool-share></div>
    </div>
  </div>
</template>

<!-- Modal / Dialog for AI Usage details -->
<dialog id="ai-detail-dialog" class="bg-card border border-border p-6 rounded-sm text-foreground max-w-lg w-full backdrop:bg-black/70 font-mono">
  <div class="flex items-center justify-between pb-4 mb-4 border-b border-border">
    <div class="flex items-center gap-2 text-sm font-bold text-primary">
      <Cpu size={16} />
      <span>[ AI Token Observatory Hub ]</span>
    </div>
    <form method="dialog">
      <button class="text-muted-foreground hover:text-foreground text-xs uppercase cursor-pointer">[ CLOSE ]</button>
    </form>
  </div>

  <div class="flex flex-col gap-4 text-xs">
    <p class="text-muted-foreground leading-relaxed">
      中央 Hub 位于 Oracle 2 VPS，实时汇总 Local (Mac/PC) 与 Oracle 2 VPS 的多端 AI CLI 用量。
    </p>

    <div class="grid grid-cols-2 gap-3 p-3 bg-background border border-border">
      <div>
        <div class="text-[10px] text-muted-foreground uppercase mb-1">Local Machine</div>
        <div class="text-sm font-bold text-foreground" id="ai-dialog-local">--</div>
      </div>
      <div>
        <div class="text-[10px] text-muted-foreground uppercase mb-1">Oracle 2 VPS</div>
        <div class="text-sm font-bold text-primary" id="ai-dialog-oracle">--</div>
      </div>
    </div>

    <div class="p-3 bg-background border border-border flex flex-col gap-2">
      <div class="text-[10px] text-muted-foreground uppercase">// Privacy & Schema Guarantee</div>
      <div class="text-[11px] text-muted-foreground leading-normal">
        本系统仅同步 Usage Ledger 统计元数据（Tokens / Model / Machine / Timestamp），绝不同步任何代码、Prompt 或 Session 对话内容。
      </div>
    </div>
  </div>
</dialog>

<script>
  function formatTokens(val: number): string {
    if (!val) return '0';
    if (val >= 1000000) return (val / 1000000).toFixed(1) + 'M';
    if (val >= 1000) return (val / 1000).toFixed(1) + 'k';
    return val.toString();
  }

  async function fetchAiUsage() {
    const card = document.getElementById('ai-usage-card');
    const badge = document.getElementById('ai-source-badge');
    const toolsListEl = document.getElementById('ai-tools-list');

    const markUnavailable = () => {
      card?.setAttribute('aria-busy', 'false');
      if (badge) {
        badge.className = 'inline-flex items-center gap-1.5 px-2 py-0.5 border border-amber-500/30 bg-amber-500/10 text-amber-400 text-[10px] font-mono font-bold tracking-wider rounded-sm';
        badge.textContent = 'HUB 不可用';
      }
      if (toolsListEl) {
        toolsListEl.textContent = '[ HUB_UNAVAILABLE ] 暂时无法读取用量账本';
        toolsListEl.className = 'my-4 border border-dashed border-amber-500/30 px-3 py-5 font-mono text-[11px] text-amber-300';
      }
    };

    try {
      const res = await fetch('/api/ai-usage');
      if (!res.ok) {
        markUnavailable();
        return;
      }
      const data = await res.json();
      
      const totalEl = document.getElementById('ai-total-tokens');
      const costUsdEl = document.getElementById('ai-cost-usd');
      const costRmbEl = document.getElementById('ai-cost-rmb');
      const updatedAtEl = document.getElementById('ai-updated-at');
      const dialogLocalEl = document.getElementById('ai-dialog-local');
      const dialogOracleEl = document.getElementById('ai-dialog-oracle');

      card?.setAttribute('aria-busy', 'false');
      if (badge) {
        badge.className = 'inline-flex items-center gap-1.5 px-2 py-0.5 border border-primary/30 bg-primary/10 text-primary text-[10px] font-mono font-bold tracking-wider rounded-sm';
        badge.textContent = 'HUB 在线';
      }

      if (totalEl && (data.totalTokens7d || data.todayTokens)) {
        const val = data.totalTokens7d || data.todayTokens || 0;
        totalEl.textContent = formatTokens(val);
      }
      if (costUsdEl && data.estimatedCost7d !== undefined) {
        costUsdEl.textContent = `~$${Number(data.estimatedCost7d).toFixed(2)}`;
      }
      if (costRmbEl && data.estimatedCostRmb7d !== undefined) {
        costRmbEl.textContent = `≈ ¥${Number(data.estimatedCostRmb7d).toFixed(2)}`;
      }
      if (updatedAtEl && data.updatedAt) {
        const d = new Date(data.updatedAt);
        const mm = (d.getMonth() + 1).toString().padStart(2, '0');
        const dd = d.getDate().toString().padStart(2, '0');
        const hh = d.getHours().toString().padStart(2, '0');
        const min = d.getMinutes().toString().padStart(2, '0');
        updatedAtEl.textContent = `更新于 ${mm}/${dd} ${hh}:${min}`;
      }

      if (toolsListEl && Array.isArray(data.tools) && data.tools.length > 0) {
        const template = document.getElementById('ai-tool-row-template') as HTMLTemplateElement | null;
        toolsListEl.replaceChildren();
        toolsListEl.className = 'flex flex-col gap-2 my-4';
        data.tools.slice(0, 5).forEach((tool: any) => {
          const fragment = template?.content.cloneNode(true) as DocumentFragment | undefined;
          if (!fragment) return;
          const share = Math.min(100, Math.max(0, Number(tool.sharePct) || 0));
          const name = fragment.querySelector('[data-tool-name]');
          const tokens = fragment.querySelector('[data-tool-tokens]');
          const status = fragment.querySelector('[data-tool-status]');
          const bar = fragment.querySelector('[data-tool-share]') as HTMLElement | null;
          if (name) name.textContent = String(tool.name || 'Unknown model');
          if (tokens) tokens.textContent = formatTokens(Number(tool.tokens7d) || 0);
          if (status) status.textContent = String(tool.status || 'running');
          if (bar) bar.style.width = `${share}%`;
          toolsListEl.append(fragment);
        });
      }

      if (dialogLocalEl && data.byMachine?.local) {
        dialogLocalEl.textContent = `${formatTokens(data.byMachine.local.tokens7d)} tokens (${data.byMachine.local.pct}%)`;
      }
      if (dialogOracleEl && data.byMachine?.oracle2) {
        dialogOracleEl.textContent = `${formatTokens(data.byMachine.oracle2.tokens7d)} tokens (${data.byMachine.oracle2.pct}%)`;
      }
    } catch {
      markUnavailable();
    }
  }

  fetchAiUsage();
</script>
