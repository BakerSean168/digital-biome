---
import { Cpu, Sparkles, ArrowRight } from '@lucide/astro';

// SSR default values matching screenshot
const defaultTokens = "810.1k";
const defaultCostUsd = "~$1.55";
const defaultCostRmb = "≈ ¥10.61";

const defaultTools = [
  { id: 'gemini-2.0-flash', name: 'Gemini 2.0 Flash', tokens7d: '650.4k', sharePct: 80, status: 'running' },
  { id: 'gpt-4o', name: 'GPT-4o', tokens7d: '119.9k', sharePct: 15, status: 'running' },
  { id: 'claude-3-7-sonnet', name: 'Claude 3.7 Sonnet', tokens7d: '39.8k', sharePct: 5, status: 'running' }
];
---

<div class="group relative bg-card/40 border border-border p-5 sm:p-6 flex flex-col justify-between hover:border-primary/50 transition-all duration-200" id="ai-usage-card">
  <!-- Header -->
  <div>
    <div class="flex items-center justify-between mb-4">
      <div class="flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-muted-foreground">
        <Cpu size={14} class="text-primary" />
        <span>[ AI_TOOL_OBSERVABILITY ]</span>
      </div>
      <div class="inline-flex items-center gap-1.5 px-2 py-0.5 border border-primary/30 bg-primary/10 text-primary text-[10px] font-mono font-bold tracking-wider rounded-sm">
        <span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></span>
        <span>HUB 接入</span>
      </div>
    </div>

    <!-- Main Value & Cost side-by-side -->
    <div class="flex items-baseline justify-between mt-1 mb-2">
      <div>
        <div class="flex items-baseline gap-2">
          <span class="text-3xl font-bold font-mono tracking-tight text-foreground" id="ai-total-tokens">{defaultTokens}</span>
        </div>
        <div class="text-[11px] font-mono text-muted-foreground" id="ai-tokens-subtitle">
          tokens · 过去 7 天
        </div>
      </div>
      
      <div class="text-right font-mono">
        <div class="text-lg font-bold text-primary" id="ai-cost-usd">{defaultCostUsd}</div>
        <div class="text-[10px] text-muted-foreground" id="ai-cost-rmb">{defaultCostRmb}</div>
      </div>
    </div>

    <!-- AI Tools Breakdown -->
    <div class="flex flex-col gap-2.5 my-4" id="ai-tools-list">
      {defaultTools.map(tool => (
        <div class="p-3 bg-background/60 border border-border/80 rounded-sm hover:border-border transition-colors flex flex-col gap-2">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <Sparkles size={13} class="text-primary" />
              <span class="text-xs font-mono font-medium text-foreground">{tool.name}</span>
            </div>
            <div class="flex items-center gap-3 font-mono text-xs">
              <span class="text-foreground font-bold">{tool.tokens7d}</span>
              <span class="text-[9px] uppercase px-1.5 py-0.2 border border-primary/20 bg-primary/10 text-primary rounded-xs">
                {tool.status}
              </span>
            </div>
          </div>
          <!-- Progress bar -->
          <div class="w-full h-1.5 bg-border/40 rounded-full overflow-hidden">
            <div class="h-full bg-primary transition-all duration-500" style={`width: ${tool.sharePct}%`}></div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Footer Info & Details Modal trigger -->
  <div class="pt-3 border-t border-border/60 flex items-center justify-between font-mono text-[11px]">
    <span class="text-muted-foreground" id="ai-updated-at">实时接入 Hub</span>
    <button 
      type="button" 
      class="text-primary font-bold hover:underline flex items-center gap-1 cursor-pointer"
      onclick="document.getElementById('ai-detail-dialog')?.showModal()"
    >
      <span>查看详情</span>
      <ArrowRight size={12} />
    </button>
  </div>
</div>

<!-- Modal / Dialog for AI Usage details -->
<dialog id="ai-detail-dialog" class="bg-card border border-border p-6 rounded-sm text-foreground max-w-lg w-full backdrop:bg-black/70 font-mono">
  <div class="flex items-center justify-between pb-4 mb-4 border-b border-border">
    <div class="flex items-center gap-2 text-sm font-bold text-primary">
      <Cpu size={16} />
      <span>[ AI Token Observatory Hub ]</span>
    </div>
    <form method="dialog">
      <button class="text-muted-foreground hover:text-foreground text-xs uppercase cursor-pointer">[ CLOSE ]</button>
    </form>
  </div>

  <div class="flex flex-col gap-4 text-xs">
    <p class="text-muted-foreground leading-relaxed">
      中央 Hub 位于 Oracle 2 VPS，实时汇总 Local (Mac/PC) 与 Oracle 2 VPS 的多端 AI CLI 用量。
    </p>

    <div class="grid grid-cols-2 gap-3 p-3 bg-background border border-border">
      <div>
        <div class="text-[10px] text-muted-foreground uppercase mb-1">Local Machine</div>
        <div class="text-sm font-bold text-foreground" id="ai-dialog-local">--</div>
      </div>
      <div>
        <div class="text-[10px] text-muted-foreground uppercase mb-1">Oracle 2 VPS</div>
        <div class="text-sm font-bold text-primary" id="ai-dialog-oracle">--</div>
      </div>
    </div>

    <div class="p-3 bg-background border border-border flex flex-col gap-2">
      <div class="text-[10px] text-muted-foreground uppercase">// Privacy & Schema Guarantee</div>
      <div class="text-[11px] text-muted-foreground leading-normal">
        本系统仅同步 Usage Ledger 统计元数据（Tokens / Model / Machine / Timestamp），绝不同步任何代码、Prompt 或 Session 对话内容。
      </div>
    </div>
  </div>
</dialog>

<script>
  function formatTokens(val: number): string {
    if (!val) return '0';
    if (val >= 1000000) return (val / 1000000).toFixed(1) + 'M';
    if (val >= 1000) return (val / 1000).toFixed(1) + 'k';
    return val.toString();
  }

  async function fetchAiUsage() {
    try {
      const res = await fetch('/api/ai-usage');
      if (!res.ok) return;
      const data = await res.json();
      
      const totalEl = document.getElementById('ai-total-tokens');
      const costUsdEl = document.getElementById('ai-cost-usd');
      const costRmbEl = document.getElementById('ai-cost-rmb');
      const updatedAtEl = document.getElementById('ai-updated-at');
      const toolsListEl = document.getElementById('ai-tools-list');
      const dialogLocalEl = document.getElementById('ai-dialog-local');
      const dialogOracleEl = document.getElementById('ai-dialog-oracle');

      if (totalEl && (data.totalTokens7d || data.todayTokens)) {
        const val = data.totalTokens7d || data.todayTokens || 0;
        totalEl.textContent = formatTokens(val);
      }
      if (costUsdEl && data.estimatedCost7d !== undefined) {
        costUsdEl.textContent = `~$${Number(data.estimatedCost7d).toFixed(2)}`;
      }
      if (costRmbEl && data.estimatedCostRmb7d !== undefined) {
        costRmbEl.textContent = `≈ ¥${Number(data.estimatedCostRmb7d).toFixed(2)}`;
      }
      if (updatedAtEl && data.updatedAt) {
        const d = new Date(data.updatedAt);
        const mm = (d.getMonth() + 1).toString().padStart(2, '0');
        const dd = d.getDate().toString().padStart(2, '0');
        const hh = d.getHours().toString().padStart(2, '0');
        const min = d.getMinutes().toString().padStart(2, '0');
        updatedAtEl.textContent = `更新于 ${mm}/${dd} ${hh}:${min}`;
      }

      if (toolsListEl && Array.isArray(data.tools) && data.tools.length > 0) {
        toolsListEl.innerHTML = data.tools.map((tool: any) => `
          <div class="p-3 bg-background/60 border border-border/80 rounded-sm hover:border-border transition-colors flex flex-col gap-2">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sparkles text-primary"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/></svg>
                <span class="text-xs font-mono font-medium text-foreground">${tool.name}</span>
              </div>
              <div class="flex items-center gap-3 font-mono text-xs">
                <span class="text-foreground font-bold">${formatTokens(tool.tokens7d)}</span>
                <span class="text-[9px] uppercase px-1.5 py-0.2 border border-primary/20 bg-primary/10 text-primary rounded-xs">
                  ${tool.status || 'running'}
                </span>
              </div>
            </div>
            <div class="w-full h-1.5 bg-border/40 rounded-full overflow-hidden">
              <div class="h-full bg-primary transition-all duration-500" style="width: ${tool.sharePct || 0}%"></div>
            </div>
          </div>
        `).join('');
      }

      if (dialogLocalEl && data.byMachine?.local) {
        dialogLocalEl.textContent = `${formatTokens(data.byMachine.local.tokens7d)} tokens (${data.byMachine.local.pct}%)`;
      }
      if (dialogOracleEl && data.byMachine?.oracle2) {
        dialogOracleEl.textContent = `${formatTokens(data.byMachine.oracle2.tokens7d)} tokens (${data.byMachine.oracle2.pct}%)`;
      }
    } catch (e) {
      // Keep SSR fallback
    }
  }

  fetchAiUsage();
</script>
