---
import SubscriptionCard from './SubscriptionCard.astro';
import AIUsageCard from './AIUsageCard.astro';
import ServerMonitorCard from './ServerMonitorCard.astro';
import VisitorIPCard from './VisitorIPCard.astro';
---

<section class="relative border border-border bg-transparent my-4 overflow-hidden" data-observability-grid>
  <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-primary/60 to-transparent"></div>
  <div class="p-5 sm:p-7">
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2 mb-6">
      <h3 class="text-sm font-mono tracking-widest text-muted-foreground uppercase">
        [ SYSTEM_OBSERVABILITY ] / 个人数字生态与 Observability 看板
      </h3>
      <span class="text-[10px] font-mono text-primary border border-primary/30 bg-primary/10 px-2 py-0.5 uppercase tracking-wider">
        CLOUDFLARE_EDGE // TELEMETRY
      </span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 items-start">
      <div class="contents md:flex md:flex-col md:gap-5 md:min-w-0">
        <div class="order-1"><SubscriptionCard /></div>
        <div class="order-3"><ServerMonitorCard /></div>
      </div>
      <div class="contents md:flex md:flex-col md:gap-5 md:min-w-0">
        <div class="order-2"><AIUsageCard /></div>
        <div class="order-4"><VisitorIPCard /></div>
      </div>
    </div>
  </div>
</section>
