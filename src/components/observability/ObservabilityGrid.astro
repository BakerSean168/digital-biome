---
import SubscriptionCard from './SubscriptionCard.astro';
import AIUsageCard from './AIUsageCard.astro';
import ServerMonitorCard from './ServerMonitorCard.astro';
import VisitorIPCard from './VisitorIPCard.astro';
---

<section class="my-4" data-observability-grid>
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2 mb-5">
    <h3 class="text-sm font-mono tracking-widest text-muted-foreground uppercase">
      [ SYSTEM_OBSERVABILITY ] / 个人数字生态与 Observability 看板
    </h3>
    <span class="text-[10px] font-mono text-primary border border-primary/30 bg-primary/10 px-2 py-0.5 uppercase tracking-wider">
      CLOUDFLARE_EDGE // TELEMETRY
    </span>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-5 items-stretch">
    <SubscriptionCard />
    <AIUsageCard />
    <ServerMonitorCard />
    <VisitorIPCard />
  </div>
</section>
