---
import subscriptionData from '../../data/subscriptions.json';
import { CreditCard, Calendar } from '@lucide/astro';

export interface SubscriptionItem {
  id: string;
  name: string;
  vendor: string;
  cost: number;
  annualCost?: number;
  currency: string;
  cycle: string;
  nextBillingDate: string;
  status: string;
  icon: string;
  notes?: string;
}

const { exchangeRateRmb } = subscriptionData;
const subscriptions: SubscriptionItem[] = subscriptionData.subscriptions as SubscriptionItem[];

// Calculate total monthly USD and RMB
const totalMonthlyUsd = subscriptions.reduce((sum, item) => {
  if (item.cycle === 'monthly') return sum + item.cost;
  if (item.cycle === 'yearly') return sum + (item.annualCost ? item.annualCost / 12 : item.cost);
  return sum + item.cost;
}, 0);

const totalMonthlyRmb = Math.round(totalMonthlyUsd * exchangeRateRmb * 100) / 100;
const activeCount = subscriptions.length;

// Find nearest renewal
const now = new Date();
const renewals = subscriptions
  .map(sub => {
    const nextDate = new Date(sub.nextBillingDate);
    const diffDays = Math.ceil((nextDate.getTime() - now.getTime()) / (1000 * 3600 * 24));
    return { ...sub, diffDays };
  })
  .sort((a, b) => a.diffDays - b.diffDays);

const nearestRenewal = renewals[0];
---

<div class="group relative bg-card/40 border border-border p-5 sm:p-6 flex flex-col justify-between hover:border-primary/50 transition-all duration-200">
  <!-- Header -->
  <div>
    <div class="flex items-center justify-between mb-3">
      <div class="flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-muted-foreground">
        <CreditCard size={14} class="text-primary" />
        <span>[ SUBSCRIPTION_OVERVIEW ]</span>
      </div>
      <div class="inline-flex items-center gap-1.5 px-2 py-0.5 border border-primary/30 bg-primary/10 text-primary text-[10px] font-mono font-bold tracking-wider rounded-sm">
        <span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></span>
        <span>{activeCount} 活跃</span>
      </div>
    </div>

    <!-- Main Value -->
    <div class="flex items-baseline gap-2 mt-1 mb-1">
      <span class="text-3xl font-bold font-mono tracking-tight text-foreground">${totalMonthlyUsd.toFixed(2)}</span>
      <span class="text-xs font-mono text-muted-foreground uppercase">/ 月</span>
    </div>
    <div class="text-[11px] font-mono text-muted-foreground mb-4">
      ≈ ¥{totalMonthlyRmb.toFixed(2)} / 月
    </div>

    <!-- Subscription Items List -->
    <div class="flex flex-col gap-2.5 my-4">
      {subscriptions.map(item => (
        <div class="flex items-center justify-between p-2.5 bg-background/60 border border-border/80 rounded-sm hover:border-border transition-colors">
          <div class="flex items-center gap-2.5 min-w-0">
            <div class="w-6 h-6 flex items-center justify-center bg-card border border-border text-[10px] font-mono font-bold text-primary shrink-0">
              {item.vendor.charAt(0)}
            </div>
            <div class="flex flex-col min-w-0">
              <span class="text-xs font-mono text-foreground font-medium truncate">{item.name}</span>
              <span class="text-[10px] font-mono text-muted-foreground uppercase">{item.cycle === 'monthly' ? '每月' : '每年'}</span>
            </div>
          </div>
          <div class="text-right shrink-0">
            <span class="text-xs font-mono font-bold text-foreground">${item.cost.toFixed(2)}</span>
            <div class="text-[9px] font-mono text-muted-foreground">≈ ¥{(item.cost * exchangeRateRmb).toFixed(2)}</div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Footer Countdown -->
  {nearestRenewal && (
    <div class="pt-3 border-t border-border/60 flex items-center justify-between font-mono text-[11px]">
      <div class="flex items-center gap-1.5 text-muted-foreground truncate">
        <Calendar size={12} class="text-primary shrink-0" />
        <span class="truncate">下次续费 · {nearestRenewal.name}</span>
      </div>
      <span class="text-primary font-bold shrink-0 ml-2">{nearestRenewal.diffDays} 天后 →</span>
    </div>
  )}
</div>
