---
import subscriptionData from '../../data/subscriptions.json';
import { CreditCard, Calendar, ArrowRight } from '@lucide/astro';
import { monthlyEquivalentCost } from '../../utils/subscriptions';

export interface SubscriptionItem {
  id: string;
  name: string;
  vendor: string;
  cost: number;
  annualCost?: number;
  currency: string;
  cycle: string;
  nextBillingDate: string;
  status: string;
  icon: string;
  notes?: string;
}

const { exchangeRateRmb } = subscriptionData;
const subscriptions: SubscriptionItem[] = (subscriptionData.subscriptions as SubscriptionItem[])
  .filter(item => item.status === 'active');

// Calculate total monthly USD and RMB
const totalMonthlyUsd = subscriptions.reduce((sum, item) => {
  return sum + monthlyEquivalentCost(item);
}, 0);

const totalMonthlyRmb = Math.round(totalMonthlyUsd * exchangeRateRmb * 100) / 100;
const activeCount = subscriptions.length;

// Find nearest renewal
const now = new Date();
const renewals = subscriptions
  .map(sub => {
    const nextDate = new Date(sub.nextBillingDate);
    const diffDays = Math.ceil((nextDate.getTime() - now.getTime()) / (1000 * 3600 * 24));
    return { ...sub, diffDays };
  })
  .filter(sub => sub.diffDays >= 0)
  .sort((a, b) => a.diffDays - b.diffDays);

const nearestRenewal = renewals[0];
const previewSubscriptions = subscriptions.slice(0, 3);
const hiddenSubscriptionCount = Math.max(0, subscriptions.length - previewSubscriptions.length);
---

<article class="group relative h-full bg-card/40 border border-border p-5 sm:p-6 flex flex-col hover:border-primary/50 transition-colors duration-200" data-observability-card="subscriptions">
  <!-- Header -->
  <div>
    <div class="flex items-center justify-between mb-3">
      <div class="flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-muted-foreground">
        <CreditCard size={14} class="text-primary" />
        <span>[ SUBSCRIPTION_OVERVIEW ]</span>
      </div>
      <div class="inline-flex items-center gap-1.5 px-2 py-0.5 border border-primary/30 bg-primary/10 text-primary text-[10px] font-mono font-bold tracking-wider rounded-sm">
        <span class={`w-1.5 h-1.5 rounded-full ${activeCount > 0 ? 'bg-primary' : 'bg-muted-foreground'}`}></span>
        <span>{activeCount} 活跃</span>
      </div>
    </div>

    <!-- Main Value -->
    <div class="flex items-baseline gap-2 mt-1 mb-1">
      <span class="text-3xl font-bold font-mono tracking-tight text-foreground">${totalMonthlyUsd.toFixed(2)}</span>
      <span class="text-xs font-mono text-muted-foreground uppercase">/ 月</span>
    </div>
    <div class="text-[11px] font-mono text-muted-foreground mb-4">
      ≈ ¥{totalMonthlyRmb.toFixed(2)} / 月
    </div>

    <!-- Subscription Items List -->
    <div class="flex flex-col gap-2 my-4">
      {previewSubscriptions.length > 0 ? previewSubscriptions.map(item => (
        <div class="flex items-center justify-between p-2.5 bg-background/60 border border-border/80 rounded-sm hover:border-border transition-colors">
          <div class="flex items-center gap-2.5 min-w-0">
            <div class="w-6 h-6 flex items-center justify-center bg-card border border-border text-[10px] font-mono font-bold text-primary shrink-0">
              {item.vendor.charAt(0)}
            </div>
            <div class="flex flex-col min-w-0">
              <span class="text-xs font-mono text-foreground font-medium truncate">{item.name}</span>
              <span class="text-[10px] font-mono text-muted-foreground uppercase">{item.cycle === 'monthly' ? '每月' : '每年'}</span>
            </div>
          </div>
          <div class="text-right shrink-0">
            <span class="text-xs font-mono font-bold text-foreground">${item.cost.toFixed(2)}</span>
            <div class="text-[9px] font-mono text-muted-foreground">≈ ¥{(item.cost * exchangeRateRmb).toFixed(2)}</div>
          </div>
        </div>
      )) : (
        <div class="border border-dashed border-border px-3 py-5 font-mono text-[11px] text-muted-foreground">
          [ NO_SUBSCRIPTION_SOURCE ] 等待 Vault 同步
        </div>
      )}
      {hiddenSubscriptionCount > 0 && (
        <div class="px-2.5 py-1.5 border border-dashed border-border/70 text-[10px] font-mono text-muted-foreground text-center">
          [ +{hiddenSubscriptionCount} MORE ] 完整清单见详情
        </div>
      )}
    </div>
  </div>

  <!-- Footer Countdown -->
  {nearestRenewal && (
    <div class="mt-auto pt-3 border-t border-border/60 flex items-center justify-between font-mono text-[11px]">
      <div class="flex items-center gap-1.5 text-muted-foreground shrink-0">
        <Calendar size={12} class="text-primary shrink-0" />
        <span>下次续费：<strong class="text-foreground font-bold">{nearestRenewal.diffDays} 天后</strong></span>
      </div>
      <button
        type="button"
        class="text-primary font-bold shrink-0 ml-2 hover:underline inline-flex items-center gap-1 cursor-pointer"
        onclick="document.getElementById('subscription-detail-dialog')?.showModal()"
      >
        查看详情 <ArrowRight size={12} />
      </button>
    </div>
  )}
</article>

<dialog id="subscription-detail-dialog" class="fixed inset-0 m-auto max-h-[calc(100dvh-2rem)] overflow-y-auto bg-card border border-border p-5 sm:p-6 rounded-sm text-foreground max-w-xl w-[calc(100%-2rem)] backdrop:bg-black/70 font-mono">
  <div class="flex items-center justify-between pb-4 mb-4 border-b border-border">
    <div class="flex items-center gap-2 text-sm font-bold text-primary">
      <CreditCard size={16} />
      <span>[ SUBSCRIPTION_LEDGER ]</span>
    </div>
    <form method="dialog">
      <button class="text-muted-foreground hover:text-foreground text-xs uppercase cursor-pointer">[ CLOSE ]</button>
    </form>
  </div>

  <div class="flex flex-col gap-2">
    {subscriptions.map(item => (
      <div class="grid grid-cols-[1fr_auto] gap-3 p-3 bg-background/70 border border-border/80">
        <div class="min-w-0">
          <div class="text-xs font-bold text-foreground truncate">{item.name}</div>
          <div class="mt-1 text-[10px] text-muted-foreground">{item.vendor} · 下次续费 {item.nextBillingDate}</div>
          {item.notes && <div class="mt-1.5 text-[10px] leading-relaxed text-muted-foreground/80">{item.notes}</div>}
        </div>
        <div class="text-right shrink-0">
          <div class="text-xs font-bold text-primary">${item.cost.toFixed(2)}</div>
          <div class="mt-1 text-[10px] uppercase text-muted-foreground">{item.cycle === 'monthly' ? '每月' : '每年'}</div>
        </div>
      </div>
    ))}
  </div>
</dialog>
