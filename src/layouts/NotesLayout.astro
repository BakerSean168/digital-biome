---
import BaseLayout from './BaseLayout.astro';
import NotesSidebar from '../components/notes/NotesSidebar.astro';
import TableOfContents from '../components/notes/TableOfContents.astro';
import WikilinkPreview from '../components/notes/WikilinkPreview.astro';
import Backlinks from '../components/notes/Backlinks.astro';
import OutgoingLinks from '../components/notes/OutgoingLinks.astro';

interface Props {
  title: string;
  description?: string;
  headings?: { depth: number; slug: string; text: string }[];
  currentSlug?: string;
  showSidebar?: boolean;
  showToc?: boolean;
}

const {
  title,
  description = '个人知识生态网站',
  headings = [],
  currentSlug = '',
  showSidebar = false,
  showToc = true,
}: Props = Astro.props;

const hasToc = showToc && headings.length > 0;
const showContext = Boolean(currentSlug);
const showOutline = showContext && showToc;
const gridCols = showContext
  ? showOutline
    ? 'lg:grid-cols-[minmax(0,2fr)_minmax(0,5.5fr)_minmax(0,2.5fr)]'
    : 'lg:grid-cols-[minmax(0,2fr)_minmax(0,8fr)]'
  : 'lg:grid-cols-1';
---

<BaseLayout title={title} description={description} bodyClass="bg-background text-foreground">
  <div
    class={`max-w-[1600px] mx-auto min-h-[calc(100vh-120px)] grid gap-8 px-4 sm:px-6 lg:px-12 grid-cols-1 ${gridCols} relative pt-6 pb-8`}
  >
    <!-- Left Column: Upstream & Downstream -->
    {showContext && (
      <aside class="hidden lg:flex flex-col py-4 sticky top-6 h-fit max-h-[calc(100vh-120px)] overflow-y-auto custom-scrollbar gap-8">
        <div>
          <div class="text-xs font-mono tracking-widest text-text-muted mb-4 border-b border-border/50 pb-2">
            链接到这里
          </div>
          <Backlinks currentSlug={currentSlug} />
        </div>
        <div>
          <div class="text-xs font-mono tracking-widest text-text-muted mb-4 border-b border-border/50 pb-2">
            相关笔记
          </div>
          <OutgoingLinks currentSlug={currentSlug} />
        </div>
        {showSidebar && (
          <div class="mt-4 pt-4 border-t border-border/30">
            <div class="text-xs font-mono tracking-widest text-text-muted mb-4 border-b border-border/50 pb-2">
              所有笔记
            </div>
            <NotesSidebar currentSlug={currentSlug} />
          </div>
        )}
      </aside>
    )}

    <!-- Middle Column: The Core -->
    <main class="py-4 min-w-0 w-full mx-auto relative">
      <article class="w-full text-text-main leading-[1.8] font-serif text-lg prose prose-invert max-w-none prose-headings:font-serif prose-headings:text-text-main prose-h1:text-4xl prose-h1:font-bold prose-h1:mb-12 prose-h2:text-2xl prose-p:text-text-main prose-li:text-text-main prose-strong:text-text-main prose-a:text-primary prose-a:no-underline hover:prose-a:bg-primary/10 prose-code:font-mono prose-code:text-sm prose-pre:bg-[#1A1B19] prose-pre:border prose-pre:border-[#2C2D2A]">
        <slot />
      </article>
    </main>

    <!-- Right Column: Table of Contents / Outline -->
    {showOutline && (
      <aside class="hidden lg:flex flex-col py-4 sticky top-6 h-fit max-h-[calc(100vh-120px)] overflow-y-auto pl-8 custom-scrollbar">
        {hasToc && <TableOfContents headings={headings} />}
      </aside>
    )}
  </div>
  <WikilinkPreview />
</BaseLayout>
