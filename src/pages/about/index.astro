---
import TerminalLayout from '../../layouts/TerminalLayout.astro';
import SlashPageHeader from '../../components/common/SlashPageHeader.astro';
import { ABOUT_RELATED_BLOGS, ABOUT_SECTIONS, ABOUT_UPDATED_AT } from '../../config/about-profile';
import { linkTextParts } from '../../utils/public-blog-links';

function getParagraphParts(sectionId: string, paragraphIndex: number, paragraph: string) {
  return linkTextParts(
    paragraph,
    ABOUT_RELATED_BLOGS.filter(
      (relation) => relation.sectionId === sectionId && relation.paragraphIndex === paragraphIndex,
    ),
  );
}
---

<TerminalLayout
  title="About"
  description="关于我：计算机、知识、游戏、生活方式，以及一些还没想明白的问题。"
>
  {(['gui', 'tui'] as const).map((mode) => (
    <article
      data-ui-only={mode}
      data-reading-scroll
      class:list={['mx-auto w-full max-w-[820px]', mode === 'gui' ? 'gui-about' : '']}
    >
      <SlashPageHeader
        label="ABOUT"
        title="BakerSean"
        updatedAt={ABOUT_UPDATED_AT}
        readingAnchor="about-title"
        mode={mode}
      />

      <div class="divide-y divide-border">
        {ABOUT_SECTIONS.map((section) => (
          <section
            id={`${mode}-about-${section.id}`}
            data-about-section={section.id}
            data-reading-anchor={section.anchor}
            class="py-8 md:py-10"
          >
            <h2
              class:list={[
                'font-medium leading-relaxed',
                mode === 'gui' ? 'text-xl md:text-2xl' : 'text-lg',
              ]}
            >
              {section.title}
            </h2>
            <div class="mt-4 space-y-4">
              {section.paragraphs.map((paragraph, paragraphIndex) => (
                <p class:list={['leading-8 text-muted-foreground', 'text-base']}>
                  {getParagraphParts(section.id, paragraphIndex, paragraph).map((part) =>
                    part.href ? (
                      <a
                        href={part.href}
                        class="text-primary underline decoration-primary/50 underline-offset-4 hover:text-primary-hover"
                      >
                        {part.text}
                      </a>
                    ) : (
                      part.text
                    ),
                  )}
                </p>
              ))}
            </div>
          </section>
        ))}
      </div>
    </article>
  ))}
</TerminalLayout>
