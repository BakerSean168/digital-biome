---
import TerminalLayout from '../../layouts/TerminalLayout.astro';
import { getAllNoteTags } from '../../utils/notes';
const allTagsMap = getAllNoteTags();
const filteredTags = Array.from(allTagsMap.entries())
  .filter(([tag]) => {
    const lowerTag = tag.toLowerCase();
    return !lowerTag.startsWith('status/') && !lowerTag.startsWith('type/');
  })
  .sort((a, b) => b[1] - a[1]);
---

<TerminalLayout title="Tags" description="按标签浏览知识笔记">
  <h1 data-page-title class="mb-2 text-lg text-primary">
    Library / Tags
  </h1>
  <p class="mb-5 text-muted-foreground">按知识维度浏览笔记。悬停标签查看完整路径。</p>
  <div
    class="grid gap-x-8 sm:grid-cols-2 lg:grid-cols-4"
    data-tag-directory
    data-tag-count={filteredTags.length}
  >
    {filteredTags.map(([tag, count]) => (
      <a href={`/notes?tag=${encodeURIComponent(tag)}`} class="tag-chip" title={tag}>
        <span class="truncate">{tag.split('/').pop()}</span>
        <span class="text-muted-foreground">{count}</span>
      </a>
    ))}
    {filteredTags.length === 0 && <p class="text-muted-foreground">暂无标签。</p>}
  </div>
</TerminalLayout>
