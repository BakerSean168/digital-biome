---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InfrastructureShowcase from '../../components/assets/InfrastructureShowcase.astro';
import { getInfrastructureDataset, infrastructureFactCounts } from '../../utils/infrastructure';

const dataset = getInfrastructureDataset();
const facts = infrastructureFactCounts();
const heroFacts = [
  `${facts.fleetHostCount} 个当前公网计算节点来自 Personal Infrastructure`,
  `${facts.homelabResourceCount} 个家庭实验室资源通过 infra-public-v2 投影`,
  `${facts.connectionCount} 条显式基础设施关系由 Producer 维护`,
  `${facts.resourceCount} 个 public-safe 资源，页面不再读取 Thought Forest 资产事实`,
];
---

<BaseLayout title="Infrastructure" description="家庭网络与公网资产">
  <main class="mx-auto max-w-7xl px-4 py-10 md:px-6 md:py-14">
    <InfrastructureShowcase
      title="数字基础设施拓扑"
      description="由 Personal Infrastructure 作为唯一事实源，展示公网节点、受保护入口与家庭实验室资源。"
      heroFacts={heroFacts}
      resources={dataset.resources}
      connections={dataset.connections}
      locale="zh"
    />
  </main>
</BaseLayout>
