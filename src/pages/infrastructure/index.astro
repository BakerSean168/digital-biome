---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InfrastructureShowcase from '../../components/assets/InfrastructureShowcase.astro';
import { getInfrastructureDataset } from '../../utils/infrastructure';

const dataset = getInfrastructureDataset();
---

<BaseLayout title="Infrastructure" description="Personal Systems 的运行基础设施与网络拓扑详情">
  <main class="page-main mx-auto max-w-7xl px-4 py-10 md:px-6 md:py-14">
    <InfrastructureShowcase
      title="Infrastructure"
      description="Personal Systems 的运行基础设施视图。先看运行拓扑与关键入口，再进入完整资源清单；Personal Infrastructure 仍是唯一事实源。"
      resources={dataset.resources}
      connections={dataset.connections}
      locale="zh"
    />
  </main>
</BaseLayout>
