---
import TerminalLayout from '../layouts/TerminalLayout.astro';
import ObjectBrowser from '../components/terminal/ObjectBrowser.astro';
import GuiHome from '../components/common/GuiHome.astro';
import {
  terminalNotes,
  terminalBlogs,
  terminalProjects,
  terminalInfrastructure,
  terminalExternal,
} from '../repositories/terminal-repository';
import { getPinnedPortalServices } from '../utils/personal-systems';
const notes = await terminalNotes();
const blogs = terminalBlogs();
const resources = terminalInfrastructure();
const projects = terminalProjects();
const pinned = getPinnedPortalServices();
const recent = [...notes.slice(0, 3), ...blogs.slice(0, 2)].sort((a, b) =>
  b.meta.localeCompare(a.meta),
);
---

<TerminalLayout
  title="Digital Biome"
  description="BakerSean 的个人数字生态：知识、写作、项目与服务。"
>
  <GuiHome notes={notes} blogs={blogs} pinned={pinned} />
  <section data-ui-only="tui">
    <header class="mb-6 flex items-center gap-5 md:gap-6">
      <img src="/images/biome-mark.svg" width="76" height="76" alt="" class="shrink-0" />
      <div>
        <h1 class="text-[34px] leading-tight font-semibold">BakerSean</h1>
        <p class="mt-2 max-w-[46em]">
          Digital
          Biome：我的个人数字生态。写下的、做出的、运行着的和收藏的，在同一个索引里互相关联。
        </p>
        <p class="mt-2 text-xs text-muted-foreground">
          公开分享与个人使用。需要身份验证的服务通过 Access 访问。
        </p>
      </div>
    </header>
    <nav aria-label="探索数字生态" class="mb-4 flex flex-wrap justify-start gap-x-8 gap-y-3">
      <a class="hover:text-primary" href="/notes">
        [gl] library　
        <span class="text-muted-foreground">
          {notes.length} 篇笔记 · {blogs.length} 篇文章
        </span>
      </a>
      <a class="hover:text-primary" href="/dev">
        [gp] projects　<span class="text-muted-foreground">{projects.length} 个作品</span>
      </a>
      <a class="hover:text-primary" href="/tools">
        [gt] tools　
        <span class="text-muted-foreground">
          {resources.filter((item) => item.kind === 'service').length} 服务 ·{' '}
          {terminalExternal().length} 外部资源
        </span>
      </a>
      <a class="hover:text-primary" href="/about">
        [ga] about
      </a>
    </nav>
    <p class="mb-4 text-xs text-muted-foreground">知识持续积累，作品逐步生长，系统服务于日常。</p>
    <div class="mb-5 flex flex-wrap gap-x-5 gap-y-2">
      <span class="text-muted-foreground">常用</span>
      {pinned.map((service) => (
        <a
          href={service.url ?? `/login?next=%2F`}
          data-private-link={service.privateRef}
          target={service.url ? '_blank' : undefined}
          rel="noopener noreferrer"
          class="hover:text-primary"
        >
          {service.resource.title}
          {service.privateRef ? ' · Access' : ' ↗'}
        </a>
      ))}
    </div>
    <h2 class="mb-2 text-xs text-muted-foreground">最近</h2>
    <ObjectBrowser items={recent} filter={false} label="最近的笔记与文章" />
  </section>
</TerminalLayout>
