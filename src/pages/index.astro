---
import TerminalLayout from '../layouts/TerminalLayout.astro';
import GuiHome from '../components/common/GuiHome.astro';
import { HOME_SLASH_LINKS, HOME_WORDS } from '../config/home-profile';
import { terminalNotes, terminalBlogs } from '../repositories/terminal-repository';

const notes = (await terminalNotes()).slice(0, 3);
const blogs = terminalBlogs().slice(0, 3);
---

<TerminalLayout
  title="Digital Biome"
  description="BakerSean · programmer, tinkerer, gamer, reader."
>
  <GuiHome notes={notes} blogs={blogs} />

  <section data-ui-only="tui" class="mx-auto w-full max-w-5xl">
    <header data-home-identity class="mb-6 flex items-center gap-4 md:gap-5">
      <img
        src="/favicon.svg"
        width="64"
        height="64"
        alt=""
        class="h-12 w-12 shrink-0 brightness-0 invert md:h-16 md:w-16"
      />
      <div class="min-w-0">
        <h1 class="text-[28px] leading-tight font-semibold sm:text-[34px]">BakerSean</h1>
        <p data-home-bio class="mt-2 flex flex-wrap gap-x-2 text-sm text-muted-foreground">
          {HOME_WORDS.map((item, i) => (
            <span>
              {i > 0 && <span aria-hidden="true">· </span>}
              <a
                href={item.href}
                class="underline decoration-border underline-offset-4 hover:text-primary"
              >
                {item.word}
              </a>
            </span>
          ))}
        </p>
      </div>
    </header>

    <nav
      data-home-slash-links
      aria-label="Slash Pages"
      class="mb-10 grid grid-cols-2 gap-x-6 border-t border-border pt-3 sm:grid-cols-3 lg:grid-cols-6"
    >
      {HOME_SLASH_LINKS.map((link) => (
        <a
          href={link.href}
          class="flex min-h-11 min-w-0 items-center justify-between gap-2 border-b border-border py-2 hover:text-primary"
        >
          <span>{link.label}</span>
          {link.shortcut && (
            <kbd class="shrink-0 text-xs text-muted-foreground">{link.shortcut}</kbd>
          )}
        </a>
      ))}
    </nav>

    <div class="space-y-10">
      <section data-home-recent="blogs" aria-labelledby="home-tui-blogs">
        <div class="mb-3 flex items-center justify-between gap-4">
          <h2 id="home-tui-blogs" class="text-base font-semibold">
            Recent Blogs
          </h2>
          <a href="/blog" class="text-xs text-primary hover:underline">
            /blog →
          </a>
        </div>
        <ol class="border-t border-border">
          {blogs.map((post) => (
            <li class="border-b border-border">
              <a
                href={post.href}
                class="flex min-h-10 min-w-0 items-center justify-between gap-4 py-2 hover:text-primary"
              >
                <span class="min-w-0 leading-6">{post.title}</span>
                {post.meta && (
                  <span class="shrink-0 text-xs text-muted-foreground">{post.meta}</span>
                )}
              </a>
            </li>
          ))}
        </ol>
      </section>
      <section data-home-recent="notes" aria-labelledby="home-tui-notes">
        <div class="mb-3 flex items-center justify-between gap-4">
          <h2 id="home-tui-notes" class="text-base font-semibold">
            Recent Notes
          </h2>
          <a href="/notes" class="text-xs text-primary hover:underline">
            /notes →
          </a>
        </div>
        <ol class="border-t border-border">
          {notes.map((note) => (
            <li class="border-b border-border">
              <a
                href={note.href}
                class="flex min-h-10 min-w-0 items-center justify-between gap-4 py-2 hover:text-primary"
              >
                <span class="min-w-0 leading-6">{note.title}</span>
                {note.meta && (
                  <span class="shrink-0 text-xs text-muted-foreground">{note.meta}</span>
                )}
              </a>
            </li>
          ))}
        </ol>
      </section>
    </div>
  </section>
</TerminalLayout>
