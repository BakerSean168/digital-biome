---
import TerminalLayout from '../layouts/TerminalLayout.astro';
import ObjectBrowser from '../components/terminal/ObjectBrowser.astro';
import { getResourceCollection } from '../repositories/resource-collections-repository';

const items = getResourceCollection('defaults');
---

<TerminalLayout browser title="Defaults" description="按用途整理的默认工具">
  <h1 data-page-title class="sr-only">
    Defaults
  </h1>
  <ObjectBrowser
    items={items.slice(0, 16)}
    total={items.length}
    catalog={items.length > 16 ? '/data/terminal/defaults.json' : undefined}
    autoFill
    label="按用途整理的默认工具"
    contextPath="/defaults"
  />
</TerminalLayout>
