---
import TerminalLayout from '../../layouts/TerminalLayout.astro';
import ObjectBrowser from '../../components/terminal/ObjectBrowser.astro';
import LibraryTabs from '../../components/terminal/LibraryTabs.astro';
import { terminalNotes } from '../../repositories/terminal-repository';
const notes = await terminalNotes();
---

<TerminalLayout title="Notes" description="持续生长的知识笔记。">
  <h1 data-page-title class="sr-only">
    知识笔记
  </h1>
  <LibraryTabs />
  <p class="mb-5 text-muted-foreground">知识笔记 · 概念、方法与学习的连接。</p>
  <ObjectBrowser
    contextPath="/notes"
    items={notes.slice(0, 12)}
    total={notes.length}
    catalog="/data/terminal/notes.json"
    label="知识笔记"
    queryParam="tag"
  />
</TerminalLayout>
