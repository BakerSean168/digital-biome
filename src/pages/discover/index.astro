---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SignalTitle from '../../components/common/SignalTitle.astro';
import { getPublicAssets, getAssetHref } from '../../utils/notes';

const assetEntries = getPublicAssets();

const assetResults = assetEntries.map(entry => ({
  id: entry.data.asset_id!,
  scope: 'assets',
  kind: entry.data.asset_type!,
  label: entry.data.asset_type!,
  title: entry.data.title,
  description: entry.data.description || '',
  tags: entry.data.tags || [],
  href: getAssetHref(entry.data),
}));

const assetResultsJson = JSON.stringify(assetResults).replace(/</g, '\\u003c');
---

<BaseLayout title="Discover" description="[ GLOBAL_INDEX ] 全域高亮索引">
  <main class="mx-auto max-w-6xl px-4 py-10 md:px-6 md:py-14">
    <section class="border-b border-border bg-transparent pb-8">
      <p class="text-xs font-mono uppercase tracking-widest text-primary/80">Discover</p>
      <SignalTitle as="h1" class="mt-3 text-4xl font-bold font-mono tracking-tight text-foreground" title="搜索资产与知识笔记" />
      <p class="mt-3 max-w-3xl text-sm font-mono leading-7 text-muted-foreground">
        这里统一检索服务、工具、主机、网络和普通笔记。搜索结果会明确标注类型。
      </p>

      <div class="mt-6 flex flex-col gap-4 md:flex-row md:items-center">
        <input
          id="discover-query"
          type="search"
          placeholder="Query the biome... (e.g. Astro, PVE, 领域驱动)"
          class="w-full border border-border bg-background px-4 py-3 font-mono text-sm text-foreground outline-none transition-colors focus:border-primary/50"
        />
        <select
          id="discover-scope"
          class="border border-border bg-background px-4 py-3 font-mono text-sm text-foreground outline-none transition-colors focus:border-primary/50"
        >
          <option value="all" selected>全部</option>
          <option value="assets">仅资产</option>
          <option value="notes">仅笔记</option>
        </select>
      </div>
    </section>

    <section class="mt-8">
      <div class="mb-4 text-xs font-mono tracking-widest text-muted-foreground" id="discover-count"></div>
      <div id="discover-results" class="grid gap-4 md:grid-cols-2 xl:grid-cols-3"></div>
      <div id="discover-empty" class="hidden border border-dashed border-border bg-card/40 px-6 py-10 text-sm font-mono text-muted-foreground">
        没有匹配结果，试试更短的关键词，或者切换到“全部”范围。
      </div>
      <div id="discover-dev-warning" class="hidden border border-amber-500/20 bg-amber-500/5 p-6 text-sm font-mono text-amber-500 mt-4">
        ⚠️ 开发环境下未检测到 Pagefind 索引，目前仅展示资产数据。如需验证完整的知识笔记搜索，请先执行 <code>pnpm build</code> 进行打包。
      </div>
    </section>
  </main>

  <template id="discover-asset-data" set:html={assetResultsJson}></template>
</BaseLayout>

<script>
  import { hydratePagefindResults, loadPagefind, type PagefindResultData } from '../../browser/pagefind';

  type DiscoverScope = 'all' | 'assets' | 'notes';

  interface DiscoverItem {
    id: string;
    scope: DiscoverScope;
    kind: string;
    label: string;
    title: string;
    description: string;
    tags: string[];
    href: string;
  }

  interface AssetResult extends DiscoverItem {
    scope: 'assets';
  }

  function isRecord(value: unknown): value is Record<string, unknown> {
    return typeof value === 'object' && value !== null;
  }

  function isStringArray(value: unknown): value is string[] {
    return Array.isArray(value) && value.every(entry => typeof entry === 'string');
  }

  function isAssetResult(value: unknown): value is AssetResult {
    return isRecord(value)
      && typeof value.id === 'string'
      && value.scope === 'assets'
      && typeof value.kind === 'string'
      && typeof value.label === 'string'
      && typeof value.title === 'string'
      && typeof value.description === 'string'
      && isStringArray(value.tags)
      && typeof value.href === 'string';
  }

  function readAssetResults(): AssetResult[] {
    const dataIsland = document.getElementById('discover-asset-data');
    const serialized = dataIsland?.textContent;
    if (!serialized) return [];

    try {
      const parsed: unknown = JSON.parse(serialized);
      return Array.isArray(parsed) ? parsed.filter(isAssetResult) : [];
    } catch (error) {
      console.error('Unable to read Discover asset data.', error);
      return [];
    }
  }

  function normalizeScope(value: string | null): DiscoverScope {
    if (value === 'assets' || value === 'notes') return value;
    return 'all';
  }

  function toDiscoverResult(item: PagefindResultData): DiscoverItem {
    let scope: DiscoverScope = 'notes';
    let label = 'note';

    if (item.url.includes('/services/')) {
      scope = 'assets';
      label = 'service';
    } else if (item.url.includes('/tools/')) {
      scope = 'assets';
      label = 'tool';
    } else if (item.url.includes('/infrastructure/')) {
      scope = 'assets';
      label = 'host';
    } else if (item.url.includes('/projects/')) {
      scope = 'assets';
      label = 'project';
    }

    const fallbackTitle = item.url.split('/').filter(Boolean).pop()?.replace(/-/g, ' ') || 'Untitled';
    return {
      id: item.url,
      scope,
      kind: label,
      label,
      title: item.meta.title || fallbackTitle,
      description: item.excerpt,
      tags: [],
      href: item.url,
    };
  }

  const assetResults = readAssetResults();
  const queryInput = document.getElementById('discover-query') as HTMLInputElement | null;
  const scopeInput = document.getElementById('discover-scope') as HTMLSelectElement | null;
  const resultsEl = document.getElementById('discover-results');
  const countEl = document.getElementById('discover-count');
  const emptyEl = document.getElementById('discover-empty');
  const devWarningEl = document.getElementById('discover-dev-warning');
  const runtimeUrl = new URL(window.location.href);
  const initialQuery = runtimeUrl.searchParams.get('q') || '';
  const initialScope = normalizeScope(runtimeUrl.searchParams.get('scope'));

  if (queryInput) queryInput.value = initialQuery;
  if (scopeInput) scopeInput.value = initialScope;

  function render(items: readonly DiscoverItem[]): void {
    if (!resultsEl || !countEl || !emptyEl) return;

    countEl.textContent = `共 ${items.length} 条结果`;
    resultsEl.replaceChildren();

    if (items.length === 0) {
      emptyEl.classList.remove('hidden');
      return;
    }

    emptyEl.classList.add('hidden');
    const fragment = document.createDocumentFragment();

    items.forEach(item => {
      const card = document.createElement('a');
      card.href = item.href;
      card.className = 'group border border-border bg-transparent p-5 transition-all duration-300 hover:border-primary/40 hover:bg-card/40';

      const header = document.createElement('div');
      header.className = 'mb-3 flex items-center gap-2';

      const label = document.createElement('span');
      label.className = 'border border-primary/20 bg-primary/10 px-2 py-0.5 text-[10px] font-mono tracking-widest text-primary';
      label.textContent = item.label;
      header.appendChild(label);

      const scope = document.createElement('span');
      scope.className = 'text-[10px] font-mono text-muted-foreground tracking-widest';
      scope.textContent = `[ ${item.scope.toUpperCase()} ]`;
      header.appendChild(scope);
      card.appendChild(header);

      const title = document.createElement('h2');
      title.className = 'text-xl font-serif text-foreground group-hover:text-primary transition-colors';
      title.textContent = item.title;
      card.appendChild(title);

      const description = document.createElement('p');
      description.className = 'mt-2 line-clamp-3 text-sm leading-6 text-muted-foreground font-mono';
      description.textContent = item.description || '[ EMPTY_SLOT ]';
      card.appendChild(description);

      const tags = document.createElement('div');
      tags.className = 'mt-4 flex flex-wrap gap-2';
      item.tags.slice(0, 4).forEach(tag => {
        const tagElement = document.createElement('span');
        tagElement.className = 'border border-border bg-transparent px-2 py-0.5 text-[10px] font-mono text-muted-foreground';
        const displayTag = tag.includes('/') ? tag.split('/').pop() || tag : tag;
        tagElement.textContent = `#${displayTag}`;
        tags.appendChild(tagElement);
      });
      card.appendChild(tags);

      fragment.appendChild(card);
    });

    resultsEl.appendChild(fragment);
  }

  function updateUrl(query: string, scope: DiscoverScope): void {
    const url = new URL(window.location.href);
    if (query) {
      url.searchParams.set('q', query);
    } else {
      url.searchParams.delete('q');
    }
    if (scope !== 'all') {
      url.searchParams.set('scope', scope);
    } else {
      url.searchParams.delete('scope');
    }
    window.history.replaceState({}, '', url);
  }

  async function filterResults(): Promise<void> {
    const query = (queryInput?.value || '').trim().toLowerCase();
    const scope = normalizeScope(scopeInput?.value || 'all');
    if (scopeInput) scopeInput.value = scope;
    updateUrl(query, scope);

    if (!query) {
      devWarningEl?.classList.add('hidden');
      if (scope === 'notes') {
        render([]);
        if (countEl) countEl.textContent = '请输入关键词开始搜索 2400+ 篇知识笔记...';
      } else {
        render(assetResults.filter(item => scope === 'all' || item.scope === scope));
      }
      return;
    }

    const pagefind = await loadPagefind();
    if (pagefind) {
      devWarningEl?.classList.add('hidden');
      try {
        const search = await pagefind.search(query);
        const hydratedResults = await hydratePagefindResults(search.results);
        const formatted = hydratedResults
          .map(toDiscoverResult)
          .filter(item => scope === 'all' || item.scope === scope);
        render(formatted);
        return;
      } catch (error) {
        console.error('Error querying Pagefind:', error);
      }
    }

    devWarningEl?.classList.remove('hidden');
    const filteredAssets = assetResults.filter(item => {
      const matchesScope = scope === 'all' || item.scope === scope;
      const haystack = [item.title, item.description, item.id, ...item.tags]
        .join(' ')
        .toLowerCase();
      return matchesScope && haystack.includes(query);
    });
    render(filteredAssets);
  }

  let debounceTimeout: ReturnType<typeof setTimeout> | undefined;

  function handleInput(): void {
    if (debounceTimeout !== undefined) clearTimeout(debounceTimeout);
    debounceTimeout = setTimeout(() => {
      void filterResults();
    }, 150);
  }

  queryInput?.addEventListener('input', handleInput);
  scopeInput?.addEventListener('change', () => {
    void filterResults();
  });
  void filterResults();
</script>
