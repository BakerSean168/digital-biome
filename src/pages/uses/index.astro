---
import TerminalLayout from '../../layouts/TerminalLayout.astro';
import ObjectBrowser from '../../components/terminal/ObjectBrowser.astro';
import { terminalInfrastructure, terminalExternal } from '../../repositories/terminal-repository';
import { USES_HARDWARE, USES_SOFTWARE, USES_UPDATED_AT } from '../../config/uses-profile';

const resources = terminalInfrastructure();
const external = terminalExternal();
const groups = [
  {
    id: 'services',
    label: 'services',
    title: '自托管服务',
    description:
      '自托管服务与应用，包含登记中的不同生命周期状态。Access 入口需要身份验证；状态来自资源登记，不代表实时健康。',
    items: resources.filter((item) => item.kind === 'service'),
  },
  {
    id: 'external',
    label: 'websites',
    title: '网站与资源',
    description: '经常用到或收藏的外部网站、工具与资源，由公开书签数据提供。',
    items: external,
  },
  {
    id: 'hosts',
    label: 'hosts',
    title: '主机与设备',
    description: '承载服务的服务器、主机与虚拟机，具体状态来自资源登记。',
    items: resources.filter((item) => item.kind === 'host'),
  },
  {
    id: 'network',
    label: 'network',
    title: '网络与平台',
    description: '连接个人基础设施的网络、平台与服务关系。',
    items: resources.filter((item) => item.kind === 'network' || item.kind === 'platform'),
  },
];
const tabs = [
  { id: 'hardware', label: 'hardware', title: '硬件设备' },
  { id: 'software', label: 'software', title: '日常软件' },
  ...groups.map(({ id, label, title }) => ({ id, label, title })),
];
---

<TerminalLayout
  browser
  title="Uses"
  description="我实际使用的硬件、软件、网站、自托管服务以及家庭网络与服务器。"
>
  <header data-ui-only="gui" class="mb-5">
    <div class="flex flex-wrap items-start justify-between gap-x-8 gap-y-3">
      <div>
        <p class="font-mono text-xs tracking-[0.18em] text-primary">PERSONAL LOG / USES</p>
        <h1 data-reading-anchor="uses-title" class="mt-3 text-[32px] font-medium">
          我正在使用的东西
        </h1>
        <p class="mt-2 max-w-[50em] text-sm leading-6 text-muted-foreground">
          实际使用的设备、软件、服务和网站。不是简历中的技能表，也包含正在折腾的个人数字空间。
        </p>
      </div>
      <div class="font-mono text-xs text-muted-foreground">
        UPDATED <time datetime={USES_UPDATED_AT}>{USES_UPDATED_AT}</time>
      </div>
    </div>
  </header>
  <header data-ui-only="tui" class="mb-5">
    <p class="font-mono text-xs tracking-widest text-primary">/ USES / PERSONAL LOG</p>
    <h1 data-reading-anchor="uses-title" class="mt-2 text-2xl font-semibold">
      我正在使用的东西。
    </h1>
    <p class="mt-2 text-sm leading-6 text-muted-foreground">
      硬件、软件、自托管服务、网站和家庭网络。
      <time datetime={USES_UPDATED_AT} class="ml-2 font-mono">
        {USES_UPDATED_AT}
      </time>
    </p>
  </header>

  <nav
    aria-label="Uses 分类"
    class="content-tabs mb-3 flex flex-nowrap gap-2 overflow-x-auto pb-1 sm:flex-wrap sm:gap-3"
    data-uses-tabs
  >
    {tabs.map((tab, i) => (
      <a
        href={`#${tab.id}`}
        data-uses-tab={tab.id}
        data-terminal-tab={i + 1}
        aria-current={i === 0 ? 'true' : 'false'}
        class="min-h-10 shrink-0 whitespace-nowrap border border-border px-3 py-2 text-sm text-muted-foreground aria-[current=true]:border-primary aria-[current=true]:text-primary"
      >
        <span data-ui-only="tui" class="font-mono">
          {i + 1} {tab.label}
        </span>
        <span data-ui-only="gui">
          {tab.title} <span class="hidden font-mono text-xs sm:inline">{tab.label}</span>
        </span>
      </a>
    ))}
  </nav>

  <section
    id="hardware"
    data-uses-panel
    data-uses-section="hardware"
    data-reading-anchor="uses-hardware"
    class="mb-8 scroll-mt-5"
  >
    <div class="mb-5">
      <h2 class="text-lg font-medium">Hardware / 硬件</h2>
      <p class="mt-2 text-sm leading-6 text-muted-foreground">
        从主力电脑到家庭服务器，以及日常接触的设备。
      </p>
    </div>
    <div data-uses-scroll class="min-h-0 flex-1 overflow-y-auto pr-1">
      <div class="grid gap-x-8 gap-y-3 sm:grid-cols-2 xl:grid-cols-3">
        {USES_HARDWARE.map((item) => (
          <article data-uses-hardware-item class="min-w-0 border-t border-border py-4">
            <p class="font-mono text-xs tracking-wider text-primary">{item.group}</p>
            <h3 class="mt-3 font-medium">{item.name}</h3>
            <p class="mt-2 text-sm leading-6 text-muted-foreground">{item.detail}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section
    id="software"
    data-uses-panel
    data-uses-section="software"
    data-reading-anchor="uses-software"
    class="mb-8 scroll-mt-5"
    hidden
  >
    <div class="mb-5">
      <h2 class="text-lg font-medium">Software / 软件</h2>
      <p class="mt-2 text-sm leading-6 text-muted-foreground">
        实际在用的操作系统、终端、编辑器与自托管工具。
      </p>
    </div>
    <div data-uses-scroll class="min-h-0 flex-1 overflow-y-auto pr-1">
      <div class="grid gap-x-8 gap-y-8 md:grid-cols-3">
        {USES_SOFTWARE.map((group) => (
          <div data-uses-software-group class="min-w-0 border-t border-border pt-4">
            <h3 class="font-mono text-xs tracking-wider text-primary">{group.group}</h3>
            <dl class="mt-5 space-y-5">
              {group.items.map((item) => (
                <div>
                  <dt class="font-medium">{item.name}</dt>
                  <dd class="mt-1 text-sm leading-6 text-muted-foreground">{item.detail}</dd>
                </div>
              ))}
            </dl>
          </div>
        ))}
      </div>
    </div>
  </section>

  {groups.map((group) => (
    <section
      id={group.id}
      data-uses-panel
      data-uses-section={group.id}
      class="mb-8 scroll-mt-5"
      hidden
    >
      <h2 class="sr-only">{group.title}</h2>
      <details data-uses-description class="mb-3 text-xs text-muted-foreground">
        <summary class="cursor-pointer">
          {group.id === 'services' ? '服务与应用 · 状态来自登记' : group.description}
        </summary>
        <p class="py-2">
          {group.id === 'services'
            ? group.description
            : '文本与分类筛选可组合使用；登记信息不代表实时可用性。'}
        </p>
      </details>
      <ObjectBrowser
        items={group.items.slice(0, group.id === 'external' ? 16 : 12)}
        total={group.items.length}
        catalog={
          group.items.length > (group.id === 'external' ? 16 : 12)
            ? `/data/terminal/${group.id}.json`
            : undefined
        }
        label={group.label}
        autoFill
        defaultSortLabel="优先级"
        queryParam="facet"
        contextPath={`/uses#${group.id}`}
      />
    </section>
  ))}

  <script>
    const tabs = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-uses-tab]'));
    const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-uses-panel]'));
    const aliases: Record<string, string> = {
      'uses-hardware': 'hardware',
      'uses-software': 'software',
      'uses-services': 'services',
      'uses-websites': 'external',
    };
    function activate() {
      const requested = location.hash.slice(1);
      const normalized = aliases[requested] ?? requested;
      const active = panels.some((panel) => panel.id === normalized) ? normalized : 'hardware';
      panels.forEach((panel) => {
        if (!panel.hidden && panel.id !== active)
          panel
            .querySelector('[data-object-browser]')
            ?.dispatchEvent(new Event('terminal-deactivate'));
        panel.hidden = panel.id !== active;
        if (!panel.hidden)
          panel
            .querySelector('[data-object-browser]')
            ?.dispatchEvent(new Event('terminal-activate'));
      });
      tabs.forEach((tab) =>
        tab.setAttribute('aria-current', String(tab.dataset.usesTab === active)),
      );
    }
    tabs.forEach((tab) =>
      tab.addEventListener('click', (event) => {
        if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        const url = new URL(tab.href);
        for (const key of ['q', 'sort', 'facet']) url.searchParams.delete(key);
        history.pushState(history.state, '', url);
        activate();
      }),
    );
    window.addEventListener('popstate', activate);
    window.addEventListener('hashchange', activate);
    activate();
  </script>
</TerminalLayout>
