---
import { render } from 'astro:content';
import AssetDetailView from '../../components/assets/AssetDetailView.astro';
import { getAssetsByType, getRelatedAssetsByParent } from '../../repositories/assets-repository';
import { toAssetCard } from '../../view-models/asset-card';

export const prerender = true;

export async function getStaticPaths() {
  const entries = getAssetsByType('tool');
  return entries.map((entry) => ({
    params: { assetId: entry.data.asset_id },
    props: { entry },
  }));
}

import type { AssetNoteEntry } from '../../types/notes';

interface Props {
  entry: AssetNoteEntry;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const relatedAssets = getRelatedAssetsByParent(entry.data.asset_id).map(toAssetCard);
---

<AssetDetailView entry={entry} Content={Content} relatedAssets={relatedAssets} />
