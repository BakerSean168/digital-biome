---
import TerminalLayout from '../layouts/TerminalLayout.astro';
import NowEntry from '../components/common/NowEntry.astro';
import { NOW_ENTRIES } from '../config/now-profile';
---

<TerminalLayout title="Now" description="最近在开发、在玩、在看的一些东西。">
  {(['gui', 'tui'] as const).map((mode) => (
    <article data-ui-only={mode} class="mx-auto w-full max-w-[960px]">
      <h1 data-reading-anchor="now-title" class="sr-only">
        Now
      </h1>
      <ul
        data-reading-anchor="now-items"
        data-now-feed
        class="grid grid-cols-1 gap-x-8 md:grid-cols-2"
      >
        {NOW_ENTRIES.map((entry) => (
          <NowEntry entry={entry} />
        ))}
      </ul>
    </article>
  ))}
</TerminalLayout>
