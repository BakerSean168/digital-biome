---
import TerminalLayout from '../layouts/TerminalLayout.astro';
import NowEntry from '../components/common/NowEntry.astro';
import SlashPageHeader from '../components/common/SlashPageHeader.astro';
import { NOW_ENTRIES, NOW_UPDATED_AT } from '../config/now-profile';
---

<TerminalLayout title="Now" description="最近在开发、在玩、在看的一些东西。">
  {(['gui', 'tui'] as const).map((mode) => (
    <article data-ui-only={mode} class="mx-auto w-full max-w-[820px]">
      <SlashPageHeader
        label="NOW"
        title="最近在做什么"
        updatedAt={NOW_UPDATED_AT}
        readingAnchor="now-title"
        mode={mode}
      />
      <ul
        data-reading-anchor="now-items"
        data-now-feed
        class="mt-6 grid grid-cols-1 gap-x-8 md:mt-8 md:grid-cols-2"
      >
        {NOW_ENTRIES.map((entry) => (
          <NowEntry entry={entry} />
        ))}
      </ul>
    </article>
  ))}
</TerminalLayout>
