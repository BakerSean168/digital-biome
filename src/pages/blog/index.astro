---
import TerminalLayout from '../../layouts/TerminalLayout.astro';
import ObjectBrowser from '../../components/terminal/ObjectBrowser.astro';
import LibraryTabs from '../../components/terminal/LibraryTabs.astro';
import { terminalBlogs } from '../../repositories/terminal-repository';
---

<TerminalLayout browser title="Blog" description="工程记录、生活与思考。">
  <h1 data-page-title class="sr-only">
    博客文章
  </h1>
  <LibraryTabs />
  <p class="mb-5 text-muted-foreground">博客文章 · 完整的叙述、实践与思考。</p>
  <ObjectBrowser contextPath="/blog" items={terminalBlogs()} label="博客文章" />
</TerminalLayout>
