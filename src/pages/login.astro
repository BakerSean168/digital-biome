---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ArrowRight, Github, KeyRound, ShieldCheck } from '@lucide/astro';

export const prerender = true;
---

<BaseLayout title="Access Gate" description="Cloudflare Access 身份认证" showFooter={false}>
  <main class="mx-auto flex min-h-[78vh] max-w-xl items-center px-6 py-20" data-pagefind-ignore>
    <section class="w-full border border-border bg-card/40">
      <div class="flex items-center justify-between border-b border-border px-5 py-3 font-mono text-[10px] tracking-widest text-muted-foreground">
        <span>SYS.ACCESS_GATE</span>
        <span class="text-primary">IDENTITY_REQUIRED</span>
      </div>

      <div class="p-6 md:p-8">
        <div class="flex items-start gap-4">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-sm border border-primary/30 bg-primary/5 text-primary">
            <KeyRound size={19} />
          </div>
          <div>
            <h1 class="font-mono text-xl text-foreground">GitHub 身份认证</h1>
            <p class="mt-2 text-sm leading-6 text-muted-foreground">
              私有基础设施数据由 Cloudflare Access 隔离。认证完成后返回原页面并解锁授权内容。
            </p>
          </div>
        </div>

        <dl class="mt-7 grid border-y border-border/70 py-4 font-mono text-[11px] sm:grid-cols-2">
          <div class="border-b border-border/50 pb-3 sm:border-r sm:border-b-0 sm:pb-0 sm:pr-4">
            <dt class="text-muted-foreground">IDENTITY_PROVIDER</dt>
            <dd class="mt-1 flex items-center gap-2 text-foreground">
              <Github size={13} class="text-primary" />
              GitHub
            </dd>
          </div>
          <div class="pt-3 sm:pt-0 sm:pl-4">
            <dt class="text-muted-foreground">POLICY_ENGINE</dt>
            <dd class="mt-1 flex items-center gap-2 text-foreground">
              <ShieldCheck size={13} class="text-primary" />
              Cloudflare Access
            </dd>
          </div>
        </dl>

        <a
          data-access-login
          href="/api/private/enter"
          class="mt-7 flex h-11 w-full items-center justify-center gap-2 rounded-sm border border-primary bg-primary font-mono text-xs font-bold tracking-widest text-background transition-colors hover:bg-transparent hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
        >
          <Github size={15} />
          <span>[ CONTINUE_WITH_GITHUB ]</span>
          <ArrowRight size={14} />
        </a>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  const accessLogin = document.querySelector<HTMLAnchorElement>('[data-access-login]');
  if (accessLogin) {
    const requestedPath = new URLSearchParams(window.location.search).get('next');
    const isSafePath = requestedPath &&
      requestedPath.startsWith('/') &&
      !requestedPath.startsWith('//') &&
      !requestedPath.includes('\\');
    const enterUrl = new URL('/api/private/enter', window.location.origin);
    enterUrl.searchParams.set('next', isSafePath ? requestedPath : '/');
    accessLogin.href = enterUrl.toString();
  }
</script>
