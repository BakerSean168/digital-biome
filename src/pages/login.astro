---
import TerminalLayout from '../layouts/TerminalLayout.astro';
export const prerender = true;
---

<TerminalLayout title="Access" description="访问个人服务">
  <section class="max-w-[720px]" data-pagefind-ignore>
    <h1 data-page-title class="mb-3 text-lg text-primary">
      Access
    </h1>
    <p>公开内容可以直接阅读。个人服务需要验证身份后访问。</p>
    <p class="mt-3 text-muted-foreground">
      通过 GitHub 登录，完成后回到原页面。访问权限由 Cloudflare Access 验证。
    </p>
    <a
      data-access-login
      href="/api/private/enter"
      class="mt-6 inline-flex min-h-11 items-center border border-primary px-4 text-primary hover:bg-primary hover:text-background"
    >
      使用 GitHub 继续 →
    </a>
    <p class="mt-6 text-xs text-muted-foreground">
      <a href="/" class="hover:text-primary">
        返回 Home
      </a>
    </p>
  </section>
</TerminalLayout>
<script>
  const accessLogin = document.querySelector<HTMLAnchorElement>('[data-access-login]');
  if (accessLogin) {
    const requestedPath = new URLSearchParams(window.location.search).get('next');
    const isSafePath =
      requestedPath &&
      requestedPath.startsWith('/') &&
      !requestedPath.startsWith('//') &&
      !requestedPath.includes('\\');
    const enterUrl = new URL('/api/private/enter', window.location.origin);
    enterUrl.searchParams.set('next', isSafePath ? requestedPath : '/');
    accessLogin.href = enterUrl.toString();
  }
</script>
