---
import TerminalLayout from '../layouts/TerminalLayout.astro';
import ObjectBrowser from '../components/terminal/ObjectBrowser.astro';
import { getResourceCollection } from '../repositories/resource-collections-repository';

const items = getResourceCollection('bookmarks');
---

<TerminalLayout browser title="Bookmarks" description="收藏的网站与工具">
  <h1 data-page-title class="sr-only">
    Bookmarks
  </h1>
  <ObjectBrowser
    items={items.slice(0, 16)}
    total={items.length}
    catalog={items.length > 16 ? '/data/terminal/bookmarks.json' : undefined}
    autoFill
    label="收藏的网站与工具"
    contextPath="/bookmarks"
  />
</TerminalLayout>
