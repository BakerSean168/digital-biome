---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PersonalSystemsHub from '../../components/assets/PersonalSystemsHub.astro';
import {
  getPinnedPortalServices,
  getPortalServers,
  getPortalServices,
  getPublicSystemDomains,
  publicSystemFactCounts,
} from '../../utils/personal-systems';

const domains = getPublicSystemDomains();
const servers = getPortalServers();
const services = getPortalServices();
const pinned = getPinnedPortalServices();
const facts = publicSystemFactCounts();
---

<BaseLayout title="Personal Systems" description="个人系统、服务器、服务与数字资产启动器">
  <main class="page-main mx-auto max-w-7xl px-4 py-10 md:px-6 md:py-14">
    <PersonalSystemsHub
      domains={domains}
      servers={servers}
      services={services}
      pinned={pinned}
      facts={facts}
    />
  </main>
</BaseLayout>
