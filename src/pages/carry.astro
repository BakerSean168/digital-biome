---
import TerminalLayout from '../layouts/TerminalLayout.astro';
import ObjectBrowser from '../components/terminal/ObjectBrowser.astro';
import { getResourceCollection } from '../repositories/resource-collections-repository';

const items = getResourceCollection('carry');
---

<TerminalLayout browser title="Carry" description="随身设备">
  <h1 data-page-title class="sr-only">
    Carry
  </h1>
  <ObjectBrowser
    items={items.slice(0, 16)}
    total={items.length}
    catalog={items.length > 16 ? '/data/terminal/carry.json' : undefined}
    autoFill
    label="随身设备"
    contextPath="/carry"
    emptyMessage="这里会列出平时随身携带的物品与设备，内容后续补充。"
  />
</TerminalLayout>
