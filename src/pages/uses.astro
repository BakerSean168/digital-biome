---
import { ArrowUpRight, Cpu, Globe, Laptop, Server, SquareTerminal } from '@lucide/astro';
import TerminalLayout from '../layouts/TerminalLayout.astro';
import { terminalExternal } from '../repositories/terminal-repository';
import { getPinnedPortalServices } from '../utils/personal-systems';
import {
  USES_FEATURED_BOOKMARK_IDS,
  USES_HARDWARE,
  USES_SOFTWARE,
  USES_UPDATED_AT,
} from '../config/uses-profile';

const bookmarks = terminalExternal();
const featuredSites = USES_FEATURED_BOOKMARK_IDS.flatMap((id) => {
  const site = bookmarks.find((item) => item.id === id);
  return site ? [site] : [];
});
// Only names, descriptions and public detail routes: never render owner endpoints or privateRef.
const featuredServices = getPinnedPortalServices().slice(0, 6);
---

<TerminalLayout
  title="Uses"
  description="BakerSean 正在使用的设备、软件、服务与网站。个人工具清单，不是技能列表。"
>
  <article data-ui-only="gui" class="gui-about mx-auto max-w-[1120px]">
    <header data-reading-anchor="uses-title" class="border-b border-border pb-10 md:pb-14">
      <p class="font-mono text-xs tracking-[0.24em] text-primary">PERSONAL LOG / USES</p>
      <div class="mt-7 grid gap-9 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,0.8fr)] lg:items-end lg:gap-16">
        <div>
          <h1 class="text-3xl leading-[1.45] font-medium tracking-tight md:text-5xl">
            我正在使用的<span class="block text-primary">设备、软件和服务。</span>
          </h1>
          <p class="mt-6 max-w-[38em] leading-8 text-muted-foreground md:text-lg">
            不是简历里的技术栈，也不是所有试过的工具。只是日常真正用到、喜欢用，或者仍在折腾的一些东西。
          </p>
        </div>
        <aside class="border-l border-border pl-5 md:pl-7">
          <p class="font-mono text-xs tracking-widest text-primary">PUBLIC SNAPSHOT</p>
          <time class="mt-3 block font-mono text-lg" datetime={USES_UPDATED_AT}>
            {USES_UPDATED_AT}
          </time>
          <p class="mt-3 text-sm leading-7 text-muted-foreground">
            设备和软件手动更新；服务与网站入口来自站内的公开资源目录，不包含私有地址。
          </p>
          <nav aria-label="Uses 分类" class="mt-5 flex flex-wrap gap-x-5 gap-y-3 text-sm">
            <a class="text-primary hover:underline" href="#uses-hardware">
              硬件
            </a>
            <a class="text-primary hover:underline" href="#uses-software">
              软件
            </a>
            <a class="text-primary hover:underline" href="#uses-services">
              服务
            </a>
            <a class="text-primary hover:underline" href="#uses-websites">
              网站
            </a>
          </nav>
        </aside>
      </div>
    </header>

    <section
      id="uses-hardware"
      data-uses-section="hardware"
      data-reading-anchor="uses-hardware"
      class="py-12 md:py-16"
    >
      <div class="flex items-center gap-3 text-primary">
        <Laptop size={19} aria-hidden="true" />
        <p class="font-mono text-xs tracking-widest">01 / HARDWARE</p>
      </div>
      <h2 class="mt-4 text-2xl font-medium md:text-3xl">桌面和家庭设备</h2>
      <p class="mt-3 text-sm leading-7 text-muted-foreground">
        从日常开发的电脑，到家里运行服务的小主机。
      </p>
      <div class="mt-8 grid gap-x-8 md:grid-cols-2">
        {USES_HARDWARE.map((item) => (
          <div class="min-w-0 border-t border-border py-5" data-uses-hardware-item>
            <p class="font-mono text-[11px] tracking-widest text-primary">{item.group}</p>
            <h3 class="mt-2 text-base font-medium">{item.name}</h3>
            <p class="mt-2 text-sm leading-7 text-muted-foreground">{item.detail}</p>
          </div>
        ))}
      </div>
    </section>

    <section
      id="uses-software"
      data-uses-section="software"
      data-reading-anchor="uses-software"
      class="border-t border-border py-12 md:py-16"
    >
      <div class="flex items-center gap-3 text-primary">
        <SquareTerminal size={19} aria-hidden="true" />
        <p class="font-mono text-xs tracking-widest">02 / SOFTWARE</p>
      </div>
      <h2 class="mt-4 text-2xl font-medium md:text-3xl">每天打开的软件</h2>
      <p class="mt-3 text-sm leading-7 text-muted-foreground">
        本地开发、笔记写作、界面设计，以及维护服务器用到的工具。
      </p>
      <div class="mt-8 grid gap-x-8 gap-y-8 lg:grid-cols-3">
        {USES_SOFTWARE.map((group) => (
          <div class="min-w-0 border-t border-border pt-5" data-uses-software-group>
            <h3 class="font-mono text-xs tracking-widest text-primary">{group.group}</h3>
            <dl class="mt-4 space-y-4">
              {group.items.map((item) => (
                <div class="min-w-0">
                  <dt class="font-medium">{item.name}</dt>
                  <dd class="mt-1 text-sm leading-6 text-muted-foreground">{item.detail}</dd>
                </div>
              ))}
            </dl>
          </div>
        ))}
      </div>
    </section>

    <section
      id="uses-services"
      data-uses-section="services"
      data-reading-anchor="uses-services"
      class="border-t border-border py-12 md:py-16"
    >
      <div class="flex items-center gap-3 text-primary">
        <Server size={19} aria-hidden="true" />
        <p class="font-mono text-xs tracking-widest">03 / SERVICES</p>
      </div>
      <h2 class="mt-4 text-2xl font-medium md:text-3xl">自己运行的服务</h2>
      <p class="mt-3 max-w-[47em] text-sm leading-7 text-muted-foreground">
        下列精选项只来自已登记为运行中的公开服务资料；它们是登记状态，不是实时健康监控。管理面板、私有地址和端口不会在这里公开。
      </p>
      {featuredServices.length > 0 && (
        <div class="mt-8 grid gap-x-8 md:grid-cols-2">
          {featuredServices.map((service) => (
            <a
              data-uses-service
              href={`/infrastructure/${service.resource.id}`}
              class="group flex min-w-0 items-start justify-between gap-4 border-t border-border py-5 hover:border-primary/50"
            >
              <div>
                <h3 class="font-medium group-hover:text-primary">
                  {service.resource.homepage?.label ?? service.resource.title}
                </h3>
                <p class="mt-2 text-sm leading-6 text-muted-foreground">
                  {service.resource.homepage?.description ?? service.resource.description}
                </p>
              </div>
              <ArrowUpRight size={17} aria-hidden="true" class="mt-1 shrink-0 text-primary" />
            </a>
          ))}
        </div>
      )}
      <div class="mt-6 flex flex-wrap gap-x-6 gap-y-3 text-sm">
        <a
          href="/tools#services"
          class="inline-flex min-h-11 items-center gap-1 text-primary hover:underline"
        >
          浏览全部服务 <ArrowUpRight size={15} aria-hidden="true" />
        </a>
        <a
          href="/systems"
          class="inline-flex min-h-11 items-center gap-1 text-primary hover:underline"
        >
          Personal Systems <ArrowUpRight size={15} aria-hidden="true" />
        </a>
        <a
          href="/infrastructure"
          class="inline-flex min-h-11 items-center gap-1 text-primary hover:underline"
        >
          Infrastructure <ArrowUpRight size={15} aria-hidden="true" />
        </a>
      </div>
    </section>

    <section
      id="uses-websites"
      data-uses-section="websites"
      data-reading-anchor="uses-websites"
      class="border-t border-border py-12 md:py-16"
    >
      <div class="flex items-center gap-3 text-primary">
        <Globe size={19} aria-hidden="true" />
        <p class="font-mono text-xs tracking-widest">04 / WEBSITES</p>
      </div>
      <h2 class="mt-4 text-2xl font-medium md:text-3xl">常用网站与收藏</h2>
      <p class="mt-3 text-sm leading-7 text-muted-foreground">
        这里挑选一些公开收藏的网站；更完整的目录仍由原有的 Tools 资源浏览器维护。
      </p>
      <div class="mt-8 grid gap-x-8 md:grid-cols-2">
        {featuredSites.map((site) => (
          <a
            data-uses-website
            href={site.href}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex min-w-0 items-start justify-between gap-4 border-t border-border py-5 hover:border-primary/50"
          >
            <div>
              <h3 class="font-medium group-hover:text-primary">{site.title}</h3>
              <p class="mt-2 text-sm leading-6 text-muted-foreground">
                {site.description || site.meta}
              </p>
            </div>
            <ArrowUpRight size={17} aria-hidden="true" class="mt-1 shrink-0 text-primary" />
          </a>
        ))}
      </div>
      <a
        href="/tools#external"
        class="mt-5 inline-flex min-h-11 items-center gap-1 text-sm text-primary hover:underline"
      >
        打开完整网站与工具目录 <ArrowUpRight size={15} aria-hidden="true" />
      </a>
    </section>

    <footer
      data-reading-anchor="uses-footer"
      class="flex flex-wrap gap-x-6 gap-y-3 border-t border-border py-9 text-sm"
    >
      <a href="/about" class="text-primary hover:underline">
        About →
      </a>
      <a href="/now" class="text-primary hover:underline">
        Now →
      </a>
      <a href="/tools" class="text-primary hover:underline">
        Tools Catalog →
      </a>
    </footer>
  </article>

  <article data-ui-only="tui" class="mx-auto max-w-[760px] space-y-10">
    <header data-reading-anchor="uses-title">
      <p class="font-mono text-xs tracking-widest text-primary">/ USES / PERSONAL LOG</p>
      <h1 class="mt-4 text-3xl font-semibold">我正在使用的东西。</h1>
      <p class="mt-4 leading-8 text-muted-foreground">
        一份个人硬件、软件、服务和网站清单，而不是求职技能表。
      </p>
      <p class="mt-3 text-sm text-muted-foreground">
        上次人工更新：<time datetime={USES_UPDATED_AT}>{USES_UPDATED_AT}</time>
      </p>
    </header>

    <section data-reading-anchor="uses-hardware" data-uses-section="hardware">
      <div class="flex items-center gap-2 text-primary">
        <Cpu size={16} aria-hidden="true" />
        <h2>## Hardware</h2>
      </div>
      <dl class="mt-5 space-y-4">
        {USES_HARDWARE.map((item) => (
          <div data-uses-hardware-item>
            <dt class="font-medium">{item.name}</dt>
            <dd class="mt-1 text-sm leading-6 text-muted-foreground">{item.detail}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section data-reading-anchor="uses-software" data-uses-section="software">
      <h2 class="mb-5 text-primary">## Software</h2>
      <div class="space-y-6">
        {USES_SOFTWARE.map((group) => (
          <div data-uses-software-group>
            <h3 class="font-mono text-xs tracking-widest text-primary">{group.group}</h3>
            <dl class="mt-3 space-y-3">
              {group.items.map((item) => (
                <div>
                  <dt class="font-medium">{item.name}</dt>
                  <dd class="text-sm leading-6 text-muted-foreground">{item.detail}</dd>
                </div>
              ))}
            </dl>
          </div>
        ))}
      </div>
    </section>

    <section data-reading-anchor="uses-services" data-uses-section="services">
      <h2 class="mb-4 text-primary">## Services</h2>
      <p class="mb-4 text-sm leading-7 text-muted-foreground">
        公开、已登记的运行中服务。内部入口不会显示在这里。
      </p>
      <div class="space-y-3">
        {featuredServices.map((service) => (
          <p data-uses-service>
            <a class="text-primary hover:underline" href={`/infrastructure/${service.resource.id}`}>
              {service.resource.homepage?.label ?? service.resource.title} →
            </a>
          </p>
        ))}
      </div>
      <a class="mt-5 inline-block min-h-11 text-primary hover:underline" href="/tools#services">
        [ 全部服务目录 ] →
      </a>
    </section>

    <section data-reading-anchor="uses-websites" data-uses-section="websites">
      <h2 class="mb-4 text-primary">## Websites</h2>
      <div class="space-y-3">
        {featuredSites.map((site) => (
          <p data-uses-website>
            <a
              class="text-primary hover:underline"
              href={site.href}
              target="_blank"
              rel="noopener noreferrer"
            >
              {site.title} ↗
            </a>
          </p>
        ))}
      </div>
      <a class="mt-5 inline-block min-h-11 text-primary hover:underline" href="/tools#external">
        [ 网站与资源目录 ] →
      </a>
    </section>

    <footer
      data-reading-anchor="uses-footer"
      class="flex flex-wrap gap-x-6 gap-y-3 border-t border-border pt-6"
    >
      <a href="/about" class="text-primary hover:underline">
        About →
      </a>
      <a href="/now" class="text-primary hover:underline">
        Now →
      </a>
      <a href="/tools" class="text-primary hover:underline">
        Tools Catalog →
      </a>
    </footer>
  </article>
</TerminalLayout>
