---
import TerminalLayout from '../layouts/TerminalLayout.astro';
---

<TerminalLayout title="404" description="没有找到这个页面">
  <section class="max-w-[720px]">
    <h1 data-page-title class="mb-3 text-lg text-primary">
      404 · Page not found
    </h1>
    <p class="text-muted-foreground">
      没有找到这个页面。链接可能已改变，你可以返回首页或搜索内容。
    </p>
    <div class="mt-6 flex gap-6">
      <a href="/" class="text-primary">
        Home →
      </a>
      <button class="search-trigger text-primary" aria-haspopup="dialog">
        Search /
      </button>
    </div>
  </section>
</TerminalLayout>
