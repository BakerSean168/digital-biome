# ==========================================
# Digital Biome Environment Variables Example
# ==========================================
# 复制此文件为 .env 并填写你的真实信息
# Copy this file to .env and fill in your actual information

# ------------------------------------------
# 站点配置 / Site Configuration
# ------------------------------------------
PUBLIC_SITE_NAME="Digital Biome"
PUBLIC_SITE_AUTHOR="Your Name"
PUBLIC_SITE_DESCRIPTION="个人知识生态网站 - 个人介绍、简历、学习笔记、工具箱"
PUBLIC_SITE_URL="https://yourdomain.com"

# ------------------------------------------
# 个人信息 / Personal Info
# ------------------------------------------
PUBLIC_AUTHOR_NAME="Your Name"
PUBLIC_AUTHOR_EMAIL="your-email@example.com"
PUBLIC_AUTHOR_PHONE="+86 13800138000"
PUBLIC_AUTHOR_LOCATION="City, Country"

# ------------------------------------------
# 社交链接 / Social Links
# ------------------------------------------
PUBLIC_GITHUB_URL="https://github.com/yourusername"
PUBLIC_TWITTER_URL="https://twitter.com/yourusername"
PUBLIC_LINKEDIN_URL="https://linkedin.com/in/yourusername"

# ------------------------------------------
# 边缘认证 / Edge Authentication
# 用于 /login 页面的密码保护和 Cookie 签名验证
# ------------------------------------------
# 访问密码（用于 /login 页面验证）
SITE_AUTH_PASSWORD=change-me-to-a-strong-password

# Cookie 签名密钥（HMAC-SHA256，至少 16 位随机字符）
# 生成方法：node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SITE_AUTH_SECRET=replace-with-at-least-16-random-characters

# 调试时可临时禁用认证（正式环境不可开启）
# SITE_AUTH_DISABLE=1
